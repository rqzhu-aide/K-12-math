{"acceptedResponses":["D"],"answer":"D","area":"Algebra","bank":"amc","batch":"A","choiceOrder":["A","B","C","D","E"],"choices":{"A":"\\(50\\)","B":"\\(66\\dfrac{2}{3}\\)","C":"\\(150\\)","D":"\\(200\\)","E":"\\(450\\)"},"choicesType":"text","domain":["domain:algebra"],"editorialNote":"","figureSources":{},"id":"2019_AMC_12A_Q02","knowledgeGraph":{"assessedIds":["cnm_p197"],"contentHash":"2c1da26948bb6c2405dca5b3a7326212001338c4232fda82f677d2b949f931e2","contextualIds":[],"flags":[],"reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"double-the-given-relation","label":"Double the given relation","methodDirectNodeIds":{"double-the-given-relation":["cnm_p197"]},"nodeIds":["cnm_p197"]},{"contextNodeIds":[],"id":"choose-one-hundred","label":"Use convenient numbers","methodDirectNodeIds":{"choose-one-hundred":["cnm_p197"]},"nodeIds":["cnm_p197"]}],"status":"mapped","supportIds":[],"version":"1.0.0"},"level":"AMC 12","number":2,"question":"Suppose \\(a\\) is \\(150\\%\\) of \\(b.\\) What percent of \\(a\\) is \\(3b?\\)","questionType":"text","rejectedAnswers":[],"responseType":"choice","schemaVersion":"3.0","skill":[],"solution":"Since \\(150\\%=\\frac32\\), doubling \\(a\\) gives exactly \\(3b\\):\n\\[\na=\\frac32b\n\\quad\\Longrightarrow\\quad\n2a=3b.\n\\]\nThus \\(3b\\) is twice \\(a\\), or \\(200\\%\\) of \\(a\\). The answer is \\(\\boxed{200}\\), choice \\(\\text{D}\\).","solutionAvailability":"present","solutionMethods":[{"directNodeIds":["cnm_p197"],"explanation":"Since \\(150\\%=\\frac32\\), doubling \\(a\\) gives exactly \\(3b\\):\n\\[\na=\\frac32b\n\\quad\\Longrightarrow\\quad\n2a=3b.\n\\]\nThus \\(3b\\) is twice \\(a\\), or \\(200\\%\\) of \\(a\\). The answer is \\(\\boxed{200}\\), choice \\(\\text{D}\\).","id":"double-the-given-relation","label":"Double the given relation","legacyRouteId":"double-the-given-relation","provenance":{"evidence":[{"label":"Independent method and annotation review","path":"../database/knowledge-graph/evidence