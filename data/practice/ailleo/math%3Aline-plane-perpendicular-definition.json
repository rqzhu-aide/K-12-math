ndicular-definition","cnm_h113"],"id":"wall_contains_perpendicular","label":"Use a perpendicular line in the wall","methodDirectNodeIds":{"wall_contains_perpendicular":["cnm_h122"]},"nodeIds":["cnm_h122","math:line-plane-perpendicular-definition","cnm_h113"]}]},{"additionalConceptCount":3,"answerCheck":{"adjudication":"Native non-independent mathematical reconciliation proposal. Root inspection is required before grading publication.","derivedAnswer":"B. Parallel.","reason":"The visible heading explicitly names Properties of Lines Perpendicular to Planes. The exact h121 theorem says two lines perpendicular to the same plane are parallel, so B and the target h121 are identified. The reviewer did not receive that heading.","recordedAnswer":"B","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h121_q4","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["math:line-plane-perpendicular-definition","cnm_h114"],"id":"theorem_conclusion","label":"Identify the theorem conditionally","methodDirectNodeIds":{"theorem_conclusion":["cnm_h121","cnm_262"]},"nodeIds":["cnm_h121","cnm_262","math:line-plane-perpendicular-definition","cnm_h114"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, 2√5","reason":"The triangle's altitude is √(15²−12²)=9, so its area is 108 and its semiperimeter is 27. Its inradius is 108/27=4. If d is the center-to-plane distance, d²+4²=6², so d=2√5.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2019_AMC_10A_Q21","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"incircle-section","label":"Use the sphere's incircle section","methodDirectNodeIds":{"incircle-section":["cnm_264","math:triangle-area-radius-relations","cnm_174","cnm_137","math:line-plane-perpendicular-definition"]},"nodeIds":["cnm_264","math:triangle-area-radius-relations","cnm_174","cnm_137","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"C. 2","reason":"If the parallel lines are distance d apart, points equidistant from them lie on their midparallel and have distance d/2 from each. The two lines at distance d/2 from l2 each meet that midparallel once, giving exactly two points.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1965_AMC_12_Q04","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_065","cnm_067","math:line-plane-perpendicular-definition"],"id":"distance-loci-and-ambient-plane","label":"Intersect the distance loci","methodDirectNodeIds":{"distance-loci-and-ambient-plane":["math:parallel-line-distance-loci","cnm_174","math:infinitude-by-construction"]},"nodeIds":["math:parallel-line-distance-loci","cnm_174","math:infinitude-by-construction","cnm_065","cnm_067","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"B: √34","reason":"The square gives AD=AB=5. Since AD is perpendicular to plane PAB, angle PAD is right, and PD²=PA²+AD²=3²+5²=34.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1996_AMC_12_Q09","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_191","math:line-plane-perpendicular-definition","cnm_074"],"id":"establish-right-triangle-pad","label":"Find the right triangle in space","methodDirectNodeIds":{"establish-right-triangle-pad":["cnm_174","math:dihedral-angle-definition","cnm_h120"]},"nodeIds":["cnm_174","math:dihedral-angle-definition","cnm_h120","cnm_191","math:line-plane-perpendicular-definition","cnm_074"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"B (1/3)","reason":"For tetrahedron edge length s, the face altitudes give CM=DM=sqrt(3)s/2, while CD=s. Therefore cos(CMD)=(CM^2+DM^2-CD^2)/(2CM·DM)=1/3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2022_AMC_12A_Q12","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"project-to-face-center","label":"Project onto the opposite face","methodDirectNodeIds":{"project-to-face-center":["cnm_174","cnm_265","math:centroid-ratios","cnm_276","math:line-plane-perpendicular-definition"]},"nodeIds":["cnm_174","cnm_265","math:centroid-ratios","cnm_276","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"C. No.","reason":"The x-axis is perpendicular to the y-axis, but both lie in the xy-plane. Thus perpendicularity to one line does not establish perpendicularity to its plane.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h120_q2","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_064","cnm_067","cnm_h115","math:line-plane-perpendicular-definition"],"id":"m1","label":"Clarify the hypothesis and give a counterexample","methodDirectNodeIds":{"m1":["cnm_h120","cnm_071"]},"nodeIds":["cnm_h120","cnm_071","cnm_064","cnm_067","cnm_h115","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"A: 9","reason":"The base circumradius is 2sqrt(3), so h=sqrt(15-12)=sqrt(3). The base area is 9sqrt(3), giving V=(1/3)*9sqrt(3)*sqrt(3)=9.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1973_AMC_12_Q32","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_137","math:line-plane-perpendicular-definition"],"id":"circumcenter-height-volume","label":"Find the perpendicular height","methodDirectNodeIds":{"circumcenter-height-volume":["cnm_h111","cnm_174","cnm_p148","cnm_265","math:centroid-ratios"]},"nodeIds":["cnm_h111","cnm_174","cnm_p148","cnm_265","math:centroid-ratios","cnm_137","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"C, approximately 2.058, closest to 2.1","reason":"Take D=(0,0,0), A=(4,0,0), B=(0,4,0), C=(0,0,3). Their plane is 3x+3y+4z=12, so the distance is 12/√34≈2.058.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1996_AMC_12_Q28","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p160","cnm_112","math:line-plane-perpendicular-definition"],"id":"perpendicular-cross-section","label":"Find the distance in a perpendicular section","methodDirectNodeIds":{"perpendicular-cross-section":["cnm_h120","cnm_137","cnm_174","cnm_p148"]},"nodeIds":["cnm_h120","cnm_137","cnm_174","cnm_p148","cnm_p160","cnm_112","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"C (2)","reason":"Take E=(0,0,0), D=(2,0,0), and A=(0,2,0). Since AC²=8, the conditions allow C=(2,1,√3). The plane-parallel and right-isosceles conditions give B=(2,2,0) or B=(0,1,√3). Both have perpendicular distance 2 from DE, so the area is ½·2·2=2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2007_AMC_12B_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_174","cnm_133","cnm_h113"],"id":"parallel-plane-square-construction","label":"Construct a square in the plane of ABC","methodDirectNodeIds":{"parallel-plane-square-construction":["cnm_h117","math:line-plane-perpendicular-definition","cnm_184","cnm_188","cnm_p148"]},"nodeIds":["cnm_h117","math:line-plane-perpendicular-definition","cnm_184","cnm_188","cnm_p148","cnm_174","cnm_133","cnm_h113"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C, √2/2","reason":"Let M,N be the midpoints of AB,CD. The equilateral faces give CM=DM=√3/2 and AB perpendicular to plane CDM. Hence PQ≥MQ≥MN. Since MN is perpendicular to CD, MN²=CM²−CN²=3/4−1/4=1/2. Equality occurs at P=M and Q=N, so the minimum is √2/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1979_AMC_12_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_055","cnm_064","cnm_075","cnm_113"],"id":"solution:midpoint-perpendiculars:1b4a6d0d42e0","label":"Use the midpoints of opposite edges","methodDirectNodeIds":{"midpoint-perpendiculars":["cnm_176","cnm_137","cnm_h120","math:line-plane-perpendicular-definition","cnm_174"]},"nodeIds":["cnm_176","cnm_137","cnm_h120","math:line-plane-perpendicular-definition","cnm_174","cnm_055","cnm_064","cnm_075","cnm_113"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"E: 784","reason":"The base side is 14, so the distances from E to lines AB and CD are 15 and 13. If its projection is distance y from AB and its height is h, then y^2+h^2=225 and (y-14)^2+h^2=169. Subtraction gives y=9, hence h=12. The volume is 196 times 12 divided by 3, or 784.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2008_AMC_12B_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p148","cnm_065","cnm_148","cnm_042","cnm_075","math:line-plane-perpendicular-definition"],"id":"perpendicular-section","label":"Recover the height in a vertical section","methodDirectNodeIds":{"perpendicular-section":["cnm_h111","cnm_174","math:quadratic-system-elimination"]},"nodeIds":["cnm_h111","cnm_174","math:quadratic-system-elimination","cnm_p148","cnm_065","cnm_148","cnm_042","cnm_075","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C, 3√5/4","reason":"The midpoints are E=(1/2,0,3/2), F=(1/2,0,0), G=(0,1,0), and H=(0,1,3/2). Opposite sides are parallel, and EF is perpendicular to FG. Their lengths are EF=3/2 and FG=√((1/2)²+1²)=√5/2, so the rectangle's area is 3√5/4.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2012_AMC_10A_Q21","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h151","cnm_055","cnm_174","math:line-plane-perpendicular-definition"],"id":"solution:triangle-midsegments:1424da505c3b","label":"Use triangle midsegments","methodDirectNodeIds":{"triangle-midsegments":["cnm_185","cnm_h120","cnm_184","cnm_188","cnm_p089"]},"nodeIds":["cnm_185","cnm_h120","cnm_184","cnm_188","cnm_p089","cnm_h151","cnm_055","cnm_174","math:line-plane-perpendicular-definition"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C: 36√21","reason":"The hexagon splits into six equilateral triangles, so its area is 54√3 and its circumradius is 6. Equal lateral edges of length 8 place the apex above the center, with height √(64 - 36) = 2√7. Thus V = (1/3)(54√3)(2√7) = 36√21.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2015_AMC_12B_Q16","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_133","cnm_137","cnm_075","math:line-plane-perpendicular-definition"],"id":"base-area-and-perpendicular-height","label":"Track the folded edges and find the height","methodDirectNodeIds":{"base-area-and-perpendicular-height":["cnm_h111","cnm_266","cnm_139","cnm_p148","cnm_174"]},"nodeIds":["cnm_h111","cnm_266","cnm_139","cnm_p148","cnm_174","cnm_133","cnm_137","cnm_075","math:line-plane-perpendicular-definition"]}]}],"layer":"ailleo","meaning":"Reviewed content-bound concept practice; no claim of complete source-standard coverage or learner mastery.","nextOffset":null,"nodeId":"math:line-plane-perpendicular-definition","status":"mapped","total":19}
