hes"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1988_AMC_12_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_017","cnm_015"],"id":"cancel-overlapping-products","label":"Cancel the overlapping factors","methodDirectNodeIds":{"cancel-overlapping-products":["math:telescoping"]},"nodeIds":["math:telescoping","cnm_017","cnm_015"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"D: 2.9","reason":"Since Tₖ = k(k + 1)/2, each factor is k(k + 1)/((k - 1)(k + 2)). The product telescopes to Pₙ = 3n/(n + 2). Thus P₁₉₉₁ = 5973/1993 ≈ 2.99699, closest to 2.9.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1991_AMC_12_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h204","cnm_160"],"id":"cancel-consecutive-factors","label":"Cancel consecutive factors","methodDirectNodeIds":{"cancel-consecutive-factors":["math:telescoping"]},"nodeIds":["math:telescoping","cnm_h204","cnm_160"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C, 1003","reason":"(3×4×⋯×2006)/(2×3×⋯×2005) = 2006/2 = 1003.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2006_AMC_8_Q09","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p178","cnm_p168"],"id":"cancel-interior-factors","label":"Cancel matching factors","methodDirectNodeIds":{"cancel-interior-factors":["math:telescoping"]},"nodeIds":["math:telescoping","cnm_p178","cnm_p168"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B: 502","reason":"All intermediate nonzero factors cancel, leaving 2008/4 = 502.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2008_AMC_10A_Q05","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p178","cnm_p167"],"id":"cancel-intermediate-factors","label":"Cancel matching factors","methodDirectNodeIds":{"cancel-intermediate-factors":["math:telescoping"]},"nodeIds":["math:telescoping","cnm_p178","cnm_p167"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B: 502","reason":"Every interior factor cancels, so the product equals 2008/4 = 502.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2008_AMC_12A_Q04","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p168","cnm_p178"],"id":"cancel-interior-factors","label":"Cancel the repeated factors","methodDirectNodeIds":{"cancel-interior-factors":["math:telescoping"]},"nodeIds":["math:telescoping","cnm_p168","cnm_p178"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C, 6","reason":"The product becomes (ln 25 · ln 27)/(ln 3 · ln 5), since the factors involving 7 through 23 cancel. Using ln 25 = 2 ln 5 and ln 27 = 3 ln 3 gives 6.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2018_AMC_12B_Q07","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"change-base-cancellation","label":"Change base and cancel","methodDirectNodeIds":{"change-base-cancellation":["cnm_h045","math:telescoping","cnm_h044"]},"nodeIds":["cnm_h045","math:telescoping","cnm_h044"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"D, 107","reason":"Since k^3+6k^2+8k=k(k+2)(k+4), each summand equals (1/4)(1/[k(k+2)]-1/[(k+2)(k+4)]). The partial sum through N is (1/4)(1/3+1/8-1/[(N+1)(N+3)]-1/[(N+2)(N+4)]). Its limit is 11/96, already reduced, so a+b=107.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2025_AMC_10B_Q15","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"shifted-fraction-cancellation","label":"Cancel fractions two places apart","methodDirectNodeIds":{"shifted-fraction-cancellation":["math:telescoping","cnm_151","cnm_161"]},"nodeIds":["math:telescoping","cnm_151","cnm_161"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"A: 1/[2(1-2^(-1/32))]","reason":"Let t = 2^(-1/32). Multiplying the product by 1-t gives 1-t^32 = 1/2. Since t is not 1, s = 1/[2(1-t)].","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1971_AMC_12_Q32","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_147","cnm_h039","math:real-exponent-laws"],"id":"successive-differences-of-squares","label":"Collapse the product by differences of squares","methodDirectNodeIds":{"successive-differences-of-squares":["math:telescoping"]},"nodeIds":["math:telescoping","cnm_147","cnm_h039","math:real-exponent-laws"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"C: 11/20","reason":"Each factor is ((k-1)/k)((k+1)/k). The two products from k = 2 through 10 are 1/10 and 11/2, giving 11/20.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1986_AMC_12_Q09","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p178","cnm_p168"],"id":"factor-and-cancel","label":"Expose cancellation","methodDirectNodeIds":{"factor-and-cancel":["math:telescoping","cnm_152"]},"nodeIds":["math:telescoping","cnm_152","cnm_p178","cnm_p168"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B, 338551","reason":"The recurrence becomes n a_n=(n-1)a_(n-1)+2n-1, giving a_n=n+1/n. Hence the sum is 338350+200+Σ(1/n²). This last sum is greater than 1 and less than 1+Σ from n=2 to 100 of 1/[n(n-1)]=1.99. The floor is therefore 338551.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2024_AMC_12A_Q21","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"weighted-recurrence-telescoping","label":"Telescope the weighted recurrence","methodDirectNodeIds":{"weighted-recurrenc