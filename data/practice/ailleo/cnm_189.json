nm_189"]},"nodeIds":["cnm_177","cnm_190","cnm_189","cnm_183"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B: 128√3 square feet","reason":"Let O be the circle center and P the opposite rhombus vertex. OP is a radius of length 16, so the diagonal OP splits the rhombus into two equilateral triangles of side 16. Their total area is 2(16²√3/4)=128√3.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1956_AMC_12_Q35","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_250","cnm_075","cnm_169"],"id":"radius-diagonal-and-pythagoras","label":"Find both diagonals","methodDirectNodeIds":{"radius-diagonal-and-pythagoras":["cnm_189","cnm_174"]},"nodeIds":["cnm_189","cnm_174","cnm_250","cnm_075","cnm_169"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, 8√3 - 12","reason":"Each large triangle has altitude 3, so the vertical rhombus diagonal is 6 - 2√3. Its upper half is equilateral, giving the horizontal diagonal (6 - 2√3)/√3 = 2√3 - 2. Half the product is 8√3 - 12.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2012_AMC_10B_Q14","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_137","cnm_173"],"id":"compute-rhombus-diagonals","label":"Find the two diagonals","methodDirectNodeIds":{"compute-rhombus-diagonals":["cnm_189","cnm_139","cnm_174"]},"nodeIds":["cnm_189","cnm_139","cnm_174","cnm_137","cnm_173"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"4.8","reason":"The side is sqrt(3² + 4²) = 5 and the area is 6 × 8 / 2 = 24. Therefore the height is 24 / 5 = 4.8.","status":"matches"},"assessed":true,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_189_q5","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_075","cnm_p137"],"id":"main","label":"Find the side and divide area by base","methodDirectNodeIds":{"main":["cnm_189","cnm_174","cnm_p147"]},"nodeIds":["cnm_189","cnm_174","cnm_p147","cnm_075","cnm_p137"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"D. 4 inches","reason":"Let the rhombus side be t, with D on AB and E on BC. Since DE is parallel to AC, (12-t)/12=DE/AC=t/6. Solving gives t=4.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1965_AMC_12_Q12","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_183","cnm_268","cnm_055","cnm_042"],"id":"parallel-side-proportion","label":"Use the parallel sides","methodDirectNodeIds":{"parallel-side-proportion":["cnm_189","cnm_269"]},"nodeIds":["cnm_189","cnm_269","cnm_183","cnm_268","cnm_055","cnm_042"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"C (8)","reason":"If the outer side is a, triangle ABD is equilateral, so BD=a and AC=√3a. For the similar inner rhombus, BD is the long diagonal, giving EF=a/√3. Its diagonal product, and therefore its area, is one third of the outer rhombus's: 24/3=8.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2006_AMC_12B_Q13","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_139","cnm_174","cnm_268"],"id":"diagonal-scale","label":"Corresponding diagonals and area scaling","methodDirectNodeIds":{"diagonal-scale":["cnm_189","cnm_270","math:similar-figure-area-scaling"]},"nodeIds":["cnm_189","cnm_270","math:similar-figure-area-scaling","cnm_139","cnm_174","cnm_268"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"C: 8","reason":"If the outer side is s, triangle ABD is equilateral, so BD=s, while AC=√3·s. Similarity sends outer AC to inner BD, giving linear scale 1/√3. Splitting the rhombi into corresponding similar triangles gives area scale 1/3, so the inner area is 24/3=8.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2006_AMC_10B_Q15","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_110","cnm_268","cnm_p147"],"id":"2006_AMC_10B_Q15_m1","label":"Compare corresponding diagonals","methodDirectNodeIds":{"2006_AMC_10B_Q15_m1":["cnm_189","cnm_139","cnm_174","cnm_270","math:similar-figure-area-scaling"]},"nodeIds":["cnm_189","cnm_139","cnm_174","cnm_270","math:similar-figure-area-scaling","cnm_110","cnm_268","cnm_p147"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"E: 1250√3 square miles","reason":"The actual short diagonal is (3/16)(400/(3/2))=50 miles. A rhombus diagonal opposite a 60-degree angle equals its side, so its area is 2(50²√3/4)=1250√3.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1956_AMC_12_Q37","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_p185","cnm_112","cnm_075","cnm_169"],"id":"convert-length-and-split-rhombus","label":"Convert the diagonal and find two triangle areas","methodDirectNodeIds":{"convert-length-and-split-rhombus":["cnm_p212","cnm_189","cnm_139","cnm_137","cnm_174","cnm_p148"]},"nodeIds":["cnm_p212","cnm_189","cnm_139","cnm_137","cnm_174","cnm_p148","cnm_p185","cnm_112","cnm_075","cnm_169"]}]},{"additionalConceptCount":1,"answerCheck":{"derivedAnswer":"B, (a+b)^2/2","reason":"For side s and diagonal d=a+b, the Pythagorean theorem gives 2s^2=d^2. Therefore the area is s^2=(a+b)^2/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1951_AMC_12_Q03","reviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"diagonal-area-formula","label":"Use perpendicular diagonals","methodDirectNodeIds":{"diagonal-area-formula":["cnm_189"]},"nodeIds":["cnm_189"]}]},{"additionalConceptCount":1,"answerCheck":{"derivedAnswer":"A: 3","reason":"The inequality is 3|x - 6| + 2|y + 7/2| ≤ 3. Its vertices are (5, -7/2), (7, -7/2), (6, -5), and (6, -2), so its diagonals have lengths 2 and 3. The area is 2 × 3/2 = 3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2008_AMC_12A_Q14","reviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"rhombus-diagonals","label":"Use the rhombus diagonals","methodDirectNodeIds":{"rhombus-diagonals":["cnm_189"]},"nodeIds":["cnm_189"]}]},{"additionalConceptCount":1,"answerCheck":{"derivedAnswer":"32","reason":"Both diagonals have length 8 and are perpendicular, so the area is 8 × 8 / 2 = 32. Equivalently, 2s² = 8² gives s² = 32.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_191_q3","reviewStatus":"machine_examined","routes":[{"id":"diagonal-area","label":"Use perpendicular diagonal area","nodeIds":["cnm_189"]},{"contextNodeIds":[],"id":"solution:diagonal-area:e9afee649770","label":"Use the diagonal-area formula","methodDirectNodeIds":{"diagonal-area":["cnm_191","cnm_189"]},"nodeIds":["cnm_191","cnm_189"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B. 7√3 square units","reason":"Each short sloping side has horizontal offset 1 and height √3, so CE = 4. Trapezoid ABCE has area (2 + 4)√3/2 = 3√3. Triangle CDE is equilateral with side 4 and area 4√3, giving 7√3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1993_AMC_12_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"extend-to-rhombus","label":"Rhombus minus equilateral triangle","methodDirectNodeIds":{"extend-to-rhombus":["cnm_190","cnm_189"]},"nodeIds":["cnm_190","cnm_189"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C, 1/8","reason":"Let the large square's side be s. The shaded square's diagonal is s/2, so its area is (s/2)^2/2=s^2/8. Dividing by the large square's area s^2 gives 1/8.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questi