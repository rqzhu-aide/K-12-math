"cnm_p150","cnm_257","cnm_266","cnm_185","cnm_139","cnm_174","cnm_p148"]},{"contextNodeIds":["cnm_266","cnm_185","cnm_139","cnm_174","cnm_p148","cnm_111"],"id":"solution:semicircle-overlap-correction:f0b00729b4a8","label":"Correct for overlapping semicircles","methodDirectNodeIds":{"semicircle-overlap-correction":["cnm_p150","cnm_257","cnm_p192"]},"nodeIds":["cnm_p150","cnm_257","cnm_p192","cnm_266","cnm_185","cnm_139","cnm_174","cnm_p148","cnm_111"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"D: 4","reason":"Normalize the original side length to 2. The possible nondegenerate side-length triples are (1,1,1), (1,1,sqrt(3)), (1,sqrt(3),2), and (2,2,2). Each occurs, giving four congruence classes.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2001_AMC_8_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_055","cnm_110","cnm_074"],"id":"method1","label":"Classify by the number of original vertices","methodDirectNodeIds":{"method1":["cnm_120","cnm_122","cnm_185","cnm_137","cnm_174"]},"nodeIds":["cnm_120","cnm_122","cnm_185","cnm_137","cnm_174","cnm_055","cnm_110","cnm_074"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"D, 75/8","reason":"AC = 10 and AM = 5. Right triangles AME and ABC are similar with ratio AM/AB = 5/8. Since triangle ABC has area 24, triangle AME has area 24(5/8)^2 = 75/8.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2009_AMC_10B_Q18","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_055","cnm_p077","cnm_148","cnm_042"],"id":"perpendicular-bisector-and-midsegment","label":"Use the perpendicular bisector","methodDirectNodeIds":{"perpendicular-bisector-and-midsegment":["cnm_p148","cnm_133","cnm_174","cnm_185"]},"nodeIds":["cnm_p148","cnm_133","cnm_174","cnm_185","cnm_055","cnm_p077","cnm_148","cnm_042"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"D: √6 - √2","reason":"Take the tangent line as y = 0 and P = (0,1). Since PQ = 3 and QR = 5, their horizontal separations are √(9-1) = 2√2 and √(25-1) = 2√6. Hence Q = (2√2,2) and R = (2√2+2√6,3). The area is one half of |(2√2)(2) - (2√2+2√6)(1)|, which equals √6 - √2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2016_AMC_10A_Q21","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_260","cnm_110","cnm_169"],"id":"horizontal-midpoint-base","label":"A horizontal base through the midpoint","methodDirectNodeIds":{"horizontal-midpoint-base":["cnm_h181","cnm_p148","cnm_262","cnm_174","cnm_185"]},"nodeIds":["cnm_h181","cnm_p148","cnm_262","cnm_174","cnm_185","cnm_260","cnm_110","cnm_169"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"D, sqrt(65)/2","reason":"Place the vertices at (0,0), (12,0), and (0,5). The inradius is 30/15 = 2, so the incenter is (2,2). The circumcenter is the hypotenuse midpoint (6,5/2). Their distance is sqrt(4^2 + (1/2)^2) = sqrt(65)/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2004_AMC_10B_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_177","cnm_187","cnm_262","cnm_p077"],"id":"tangents-and-midpoints","label":"Method 2: Use tangent lengths and midpoint geometry","methodDirectNodeIds":{"tangents-and-midpoints":["cnm_264","cnm_265","cnm_263","cnm_185","cnm_174"]},"nodeIds":["cnm_264","cnm_265","cnm_263","cnm_185","cnm_174","cnm_177","cnm_187","cnm_262","cnm_p077"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"B, HE = HG is not necessarily correct","reason":"Midpoint relations give AEHF a parallelogram, BH = CD, G the midpoint of BH, and FG = 3AB/4. For A = (0,0), B = (4,0), C = (0,4), the construction gives HE = 2 but HG = √5, disproving B in general.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1955_AMC_12_Q48","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_067","cnm_110","cnm_180"],"id":"solution:midpoint-geometry:bcecd501ec15","label":"Use midpoint geometry","methodDirectNodeIds":{"midpoint-geometry":["cnm_113","cnm_055","cnm_184","cnm_183","cnm_185","cnm_174","cnm_071"]},"nodeIds":["cnm_113","cnm_055","cnm_184","cnm_183","cnm_185","cnm_174","cnm_071","cnm_067","cnm_110","cnm_180"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"D: AB = 9, CD = 4, with area 78","reason":"Write a = AB and d = CD. The center's height above BC is (a+d)/2, so tangency gives AD = a+d. Thus BC^2 = (a+d)^2 - (a-d)^2 = 4ad, and the area is (a+d)sqrt(ad). The products ad are 3, 10, 21, 36, 55; only 36 is a square, giving area 13·6 = 78 in case D.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1988_AMC_12_Q27","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_055","cnm_250","cnm_260","cnm_148","cnm_074"],"id":"solution:diameter-pythagoras:89544102b8f9","label":"Find the diameter and use Pythagoras","methodDirectNodeIds":{"diameter-pythagoras":["cnm_p149","cnm_262","cnm_185","cnm_174","cnm_077"]},"nodeIds":["cnm_p149","cnm_262","cnm_185","cnm_174","cnm_077","cnm_055","cnm_250","cnm_260","cnm_148","cnm_074"]}]}],"layer":"ailleo","meaning":"Reviewed content-bound concept practice; no claim of complete source-standard coverage or learner mastery.","nextOffset":null,"nodeId":"cnm_185","status":"mapped","total":55}
