m_068","cnm_271"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C, 91","reason":"If the shorter base is b, the diagonal-midpoint segment has length (97-b)/2. Thus (97-b)/2=3, giving b=91.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1959_AMC_12_Q22","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_p105"],"id":"two-triangle-midsegments","label":"Method 1: Two triangle midsegments","methodDirectNodeIds":{"two-triangle-midsegments":["cnm_055","cnm_185"]},"nodeIds":["cnm_055","cnm_185","cnm_p105"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"E: 120°","reason":"For v_n = A_(n+1) - A_n, the midpoint rule gives v_(n+2) = -v_(n+1) - v_n/2, hence v_(n+4) = -v_n/4. Therefore triples (A43,A44,A45) and (A3,A4,A5) are similar in that order. Since A4A5 is parallel to A1A3, ∠A4A5A3 = 180° - 60° = 120°.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1978_AMC_12_Q28","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"midsegment-similarity","label":"Establish similarity four indices apart","methodDirectNodeIds":{"midsegment-similarity":["cnm_185","cnm_271"]},"nodeIds":["cnm_185","cnm_271"]},{"contextNodeIds":["cnm_055","cnm_139","cnm_062"],"id":"four-step-midsegment-similarity","label":"Show that triangle shapes repeat every four steps","methodDirectNodeIds":{"four-step-midsegment-similarity":["cnm_185","cnm_271","cnm_272"]},"nodeIds":["cnm_185","cnm_271","cnm_272","cnm_055","cnm_139","cnm_062"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B: 18","reason":"Let O be the common center and T the tangency point. Both AB and OT are perpendicular to BC. Since O is the midpoint of AC, triangle CTO is similar to triangle CBA with scale factor 1/2. Thus OT=12/2=6, and the larger radius is 3×6=18.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1992_AMC_12_Q11","reviewStatus":"machine_scope_audited","routes":[{"id":"chord-midpoint-midsegment","label":"Chord midpoint and triangle midsegment","nodeIds":["cnm_251","cnm_185"]},{"contextNodeIds":["cnm_250","cnm_055","cnm_p185"],"id":"solution:chord-midpoint-midsegment:511338c30656","label":"Use the chord midpoint","methodDirectNodeIds":{"chord-midpoint-midsegment":["cnm_262","cnm_251","cnm_185"]},"nodeIds":["cnm_262","cnm_251","cnm_185","cnm_250","cnm_055","cnm_p185"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B: 1","reason":"Let O be the common midpoint of AC and BD and u the common unit ray direction. Then M=O+((10+18)/2)u=O+14u and N=O+((8+22)/2)u=O+15u. Therefore MN=1.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1997_AMC_12_Q25","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_183"],"id":"triangle-midsegments","label":"Track the midpoints with triangle midsegments","methodDirectNodeIds":{"triangle-midsegments":["cnm_055","cnm_185"]},"nodeIds":["cnm_055","cnm_185","cnm_183"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"A: 1/2","reason":"Take A=(0,0), H=(0,2) and D=(3,0). The intersections give W=(3/2,3/2), X=(1,1), Y=(3/2,1/2) and Z=(2,1). The perpendicular diagonals WY and XZ both have length 1, so the area is 1·1/2=1/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2006_AMC_10A_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"overlapping-square-centers","label":"Centers of overlapping squares","methodDirectNodeIds":{"overlapping-square-centers":["cnm_183","cnm_185"]},"nodeIds":["cnm_183","cnm_185"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"E: 14","reason":"The section meets six edges at their midpoints and is a regular hexagon with side 1/2. Its area is 6·(√3/4)·(1/2)²=3√3/8. Thus a=3, b=3, c=8, and a+b+c=14.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2009_AMC_12A_Q22","reviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"parallel-face-midsegments","label":"Use face midsegments","methodDirectNodeIds":{"parallel-face-midsegments":["cnm_h119","cnm_185"]},"nodeIds":["cnm_h119","cnm_185"]},{"contextNodeIds":["cnm_174","cnm_p148"],"id":"central-section-midpoints","label":"Find the edge midpoints and divide the section into triangles","methodDirectNodeIds":{"central-section-midpoints":["cnm_185","cnm_137","cnm_p150"]},"nodeIds":["cnm_185","cnm_137","cnm_p150","cnm_174","cnm_p148"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"D, radius 3 inches, centered 4 inches from B along ray BA","reason":"Let O be the reflection of B across A. In triangle BCO, A and M are midpoints, so OC=2AM=3. Also BO=2BA=4, locating the stated center.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":["If only nondegenerate triangles are allowed, the two collinear positions on this circle must be excluded.","The circle describes the locus with its two line-AB intersections omitted when only nondegenerate triangles are permitted."],"questionId":"1950_AMC_12_Q49","reviewStatus":"machine_adjudicated","routes":[{"id":"midsegment-construction","label":"Reflect B and use a midsegment","nodeIds":["cnm_055","cnm_185"]},{"contextNodeIds":["cnm_055","cnm_110"],"id":"solution:midsegment-construction:bf83519cd982","label":"Construct a fixed center using midpoints","methodDirectNodeIds":{"midsegment-construction":["cnm_113","cnm_185","cnm_p188"]},"nodeIds":["cnm_113","cnm_185","cnm_p188","cnm_055","cnm_110"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B, sqrt(17)","reason":"Put the centroid at the origin, A=(u,0), B=(0,v), and C=(-u,-v). Then BC^2=u^2+4v^2=49 and AC^2=4u^2+v^2=36. Adding gives u^2+v^2=17, which equals AB^2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1961_AMC_12_Q36","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_075"],"id":"midsegment-square-sums","label":"Midsegments and a sum of squares","methodDirectNodeIds":{"midsegment-square-sums":["cnm_113","cnm_185","cnm_174"]},"nodeIds":["cnm_113","cnm_185","cnm_174","cnm_075"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"A (1/5)","reason":"Let S = [BDF]. Then [CDF] = 2S. Since BE is a median and [AEF] = [CEF], [ABF] = 3S. Thus [ABD] = 4S and [ABC] = 12S. Consequently [BCE] = 6S and [FDCE] = 5S, giving the ratio 1/5.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1980_AMC_12_Q21","reviewStatus":"machine_scope_audited","routes":[{"id":"parallel-midsegment","label":"Construct a parallel midsegment","nodeIds":["cnm_185","cnm_269","cnm_p148","cnm_p150"]},{"contextNodeIds":["cnm_055","cnm_110","cnm_112","cnm_268","cnm_p185"],"id":"solution:parallel-midsegment:f4dea1de9db3","label":"Use a midsegment to locate F","methodDirectNodeIds":{"parallel-midsegment":["cnm_185","cnm_269","cnm_p148","cnm_p150"]},"nodeIds":["cnm_185","cnm_269","cnm_p148","cnm_p150","cnm_055","cnm_110","cnm_112","cnm_268","cnm_p185"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B (5/2)","reason":"Reflect B across AN to B′. Because AN bisects ∠BAC, B′ lies on AC with AB′ = 14, so B′C = 19 - 14 = 5. Perpendicularity makes N the midpoint of BB′. Since M is the midpoint of BC, MN = B′C/2 = 5/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1981_AMC_12_Q19","reviewStatus":"machine_scope_audited","routes":[{"id":"reflection-midsegment","label":"Reflect B and use a midsegment","nodeIds":["cnm_058","cnm_132","cnm_185"]},{"contextNodeIds":["cnm_053","cnm_064","cnm_131"],"id":"solution:reflection-midsegment:e9