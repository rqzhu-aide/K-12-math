:"2019_AMC_10B_Q05","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"reflection-properties-counterexample","label":"Check reflection properties","methodDirectNodeIds":{"reflection-properties-counterexample":["cnm_132","cnm_083","cnm_h167","cnm_h168"]},"nodeIds":["cnm_132","cnm_083","cnm_h167","cnm_h168"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"6","reason":"The zero equation factors as (x-5)(x+1)=0. Thus AB=5-(-1)=6.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_234_q3","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_083"],"id":"solution:factor-roots:17599cc33549","label":"Find the intercepts and their separation","methodDirectNodeIds":{"factor-roots":["cnm_234","cnm_224","cnm_084"]},"nodeIds":["cnm_234","cnm_224","cnm_084","cnm_083"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"A: y1>y2>y3","reason":"The values are y1=6, y2=3, and y3=-2, so y1>y2>y3.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_238_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_017"],"id":"evaluate-and-order","label":"Calculate and compare the ordinates","methodDirectNodeIds":{"evaluate-and-order":["cnm_196","cnm_009","cnm_083"]},"nodeIds":["cnm_196","cnm_009","cnm_083","cnm_017"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B: Tangent; intersecting at 2 points","reason":"The center is 4 units from the x-axis and 3 units from the y-axis. With radius 4, the circle is tangent to the x-axis and intersects the y-axis twice.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_260_q4","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_083","cnm_065"],"id":"m1","label":"Find distances to the axes","methodDirectNodeIds":{"m1":["cnm_084","cnm_260"]},"nodeIds":["cnm_084","cnm_260","cnm_083","cnm_065"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B: O' remains stationary","reason":"Set A=(0,0), B=(L,0), and G=(t,0), taking the construction above AB. Then A'=(0,t) and B'=(L,L-t), whose midpoint is always (L/2,L/2).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1957_AMC_12_Q50","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_082","cnm_083","cnm_064"],"id":"constant-midpoint-coordinates","label":"Compute the midpoint coordinates","methodDirectNodeIds":{"constant-midpoint-coordinates":["cnm_084","cnm_055"]},"nodeIds":["cnm_084","cnm_055","cnm_082","cnm_083","cnm_064"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B, -2/3","reason":"Convexity excludes a crossing of the x-axis inside the strip. Above the axis, area=3((m+4)+(4m+4))/2=12+15m/2, so m=-2/3. The entirely below-axis case requires m≤-4 and has area at least 18, not 7.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1967_AMC_12_Q12","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_042","cnm_083"],"id":"convex-region-area","label":"Use convexity and parallel boundary lengths","methodDirectNodeIds":{"convex-region-area":["cnm_084","cnm_p149","cnm_097"]},"nodeIds":["cnm_084","cnm_p149","cnm_097","cnm_042","cnm_083"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B: 0 <= Area(S) <= pi","reason":"Area(S)=pi*T^2 with 0<=T<1, so in fact 0<=Area(S)<pi. The origin belongs to S for every t.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1973_AMC_12_Q30","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_250","cnm_083"],"id":"fractional-part-disk","label":"Read the fractional part and disk","methodDirectNodeIds":{"fractional-part-disk":["math:floor-ceiling","cnm_h176","cnm_p192"]},"nodeIds":["math:floor-ceiling","cnm_h176","cnm_p192","cnm_250","cnm_083"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"A, 3","reason":"The intercepts are 6/a and 6/b. Thus the area is (1/2)(6/a)(6/b) = 18/(ab) = 6, giving ab = 3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1989_AMC_12_Q06","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_083","cnm_040"],"id":"axis-intercepts-and-area","label":"Use the intercepts as the triangle's legs","methodDirectNodeIds":{"axis-intercepts-and-area":["cnm_084","cnm_202","cnm_p148"]},"nodeIds":["cnm_084","cnm_202","cnm_p148","cnm_083","cnm_040"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C, (-2, 0)","reason":"The figure gives P=(2,0), so the square has side 2 and area 4. For T=(t,0) to the left of O, triangle PQT has base PQ=2 and height 2-t. Its area is 2-t, so 2-t=4 gives t=-2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1996_AMC_8_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_083","cnm_p077","cnm_p089"],"id":"1996_AMC_8_Q17_m1","label":"Find the triangle's required base","methodDirectNodeIds":{"1996_AMC_8_Q17_m1":["cnm_084","cnm_p148"]},"nodeIds":["cnm_084","cnm_p148","cnm_083","cnm_p077","cnm_p089"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"E: -8","reason":"The common intercept satisfies -5/a=-b/3, hence ab=15. For a=1,3,5,15, the intercepts are -5,-5/3,-1,-1/3. Their sum is -8.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2014_AMC_10A_Q21","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_083","cnm_p145","cnm_p153"],"id":"intercepts-and-factors","label":"Use the common x-intercept","methodDirectNodeIds":{"intercepts-and-factors":["cnm_206","math:integer-diophantine-equations"]},"nodeIds":["cnm_206","math:integer-diophantine-equations","cnm_083","cnm_p145","cnm_p153"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"x>2","reason":"The increasing line crosses the x-axis at x=2 and is above it for x>2; equivalently, x-2>0 gives x>2.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_207_q1","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_083","cnm_094"],"id":"solution:graph-positive-region:c5c655c81da7","label":"Read where the graph is positive","methodDirectNodeIds":{"graph-positive-region":["cnm_202","cnm_203","cnm_207"]},"nodeIds":["cnm_202","cnm_203","cnm_207","cnm_083","cnm_094"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"5/2","reason":"The equation x-1=6/x gives (x-3)(x+2)=0, so A=(3,2) and B=(-2,-3). With C=(0,-1), the area is (1/2)·1·(3+2)=5/2.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_241_q3","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_083"],"id":"solution:axis-triangle-areas:0e693f68a9a0","label":"Split the triangle at the y-axis","methodDirectNodeIds":{"axis-triangle-areas":["cnm_241","cnm_224","cnm_084","cnm_p150"]},"nodeIds":["cnm_241","cnm_224","cnm_084","cnm_p150","cnm_083"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C. Parallel or coincident.","reason":"Zero slope means no vertical change as x changes, so the line is horizontal. It is parallel to the x-axis or is the x-axis itself.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h166_q4","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h166","cnm_082","cnm_083","cnm_067"],"id":"m1","label":"Horizontal-line equation","methodDirectNodeIds":{"m1":["cnm_h168"]},"nodeIds":["cnm_h168","cnm_h166","cnm_082","cnm_083","cnm_067"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"B. 2Tx-a^2y+2aT=0","reason":"Writing the y-intercept as b gives ab/2=T, so b=2T/a. Then -x/a+y/b=1 rearranges to 2Tx-a^2y+2aT=0.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":["A nondegenerate triangular region in the second quadrant entails a>0 and T>0.","A nondegenerate triangular region cut from the second quadrant entails a>0 and T>0; consequently the divisions by a are valid."],"questionId":"1964_AMC_12_Q15","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_083","cnm_084","cnm_040"],"id":"area-determines-intercept","label":"Find the second intercept from the area","methodDirectNodeIds":{"area-determines-intercept":["cnm_p148","cnm_h170","cnm_h171"]},"nodeIds":["cnm_p148","cnm_h170","cnm_h171","cnm_083","cnm_084","cnm_040"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"C. 2","reason":"Set (c,-2,12)=k(3,b,c). Then c=3k and 12=3k^2, so k=±2. The pairs are (b,c)=(-1,6) and (1,-6).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1964_AMC_12_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_083","cnm_040","cnm_075"],"id":"common-intercepts","label":"Use intercepts shared by the two graphs","methodDirectNodeIds":{"common-intercepts":["cnm_h171","cnm_202","cnm_220"]},"nodeIds":["cnm_h171","cnm_202","cnm_220","cnm_083","cnm_040","cnm_075"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"C: point C","reason":"F lies in the first quadrant outside the unit circle. If F=x+iy, then 1/F=(x-iy)/(x²+y²), which lies in the fourth quadrant and has modulus less than 1. Point C is the only displayed point satisfying both conditions.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1983_AMC_12_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h097","cnm_h102","cnm_083","cnm_259"],"id":"conjugate","label":"Locate the reciprocal using its signs and modulus","methodDirectNodeIds":{"conjugate":["cnm_h103","cnm_h098"]},"nodeIds":["cnm_h103","cnm_h098","cnm_h097","cnm_h102","cnm_083","cnm_259"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"D: 60","reason":"Let P=(0,t) and Q=(0,−t). The origin O is the hypotenuse midpoint, so PQ=2AO=2√(6²+8²)=20. Thus the area is (1/2)·20·6=60.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2014_AMC_10A_Q14","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_083","cnm_113","cnm_p148"],"id":"solution:hypotenuse-midpoint:f0859bb79dbf","label":"Method 1: Use the hypotenuse midpoint","methodDirectNodeIds":{"hypotenuse-midpoint":["cnm_084","cnm_187","cnm_174"]},"nodeIds":["cnm_084","cnm_187","cnm_174","cnm_083","cnm_113","cnm_p148"]},{"contextNodeIds":["cnm_083","cnm_p148"],"id":"pythagorean-intercepts","label":"Method 2: Relate the three squared lengths","methodDirectNodeIds":{"pythagorean-intercepts":["cnm_084","cnm_174","cnm_148","cnm_220"]},"nodeIds":["cnm_084","cnm_174","cnm_148","cnm_220","cnm_083","cnm_p148"]}]},{"additionalConceptCount":5,"answerCheck":{"adjudication":"Root checked the actual displayed wording and mathematical counterexample or ordinary convention.","derivedAnswer":"B when both parabolas cross the x-axis; not unique under the displayed conditions","reason":"The vertical vertices are(0,-2),(0,4). Area12 forces horizontal vertices(+-2,0). If both parabolas cross the x-axis, a1/2,b1 and sum1.5. However a=-1,b=1 also gives exactly those four combined axis-intersection points, a nondegenerate area12 kite, and sum0; a=-2,b=1 gives sum-1. No positivity or separate x-axis-crossing requirement is printed. Preserve sourceB as conditional, and do not grade these valid counterexamples as student errors.","recordedAnswer":"B","status":"confirmed_ambiguous"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":["The question does not state that a and b are positive. One parabola can miss the x-axis, leaving its coefficient undetermined by the stated intercept and area conditions.","confirmed_answer_ambiguity"],"questionId":"2015_AMC_12A_Q12","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_083","cnm_p150","cnm_p148"],"id":"intercepts-area-and-sign-cases","label":"Find the intercepts and check all coefficient signs","methodDirectNodeIds":{"intercepts-area-and-sign-cases":["cnm_234","cnm_233","cnm_071"]},"nodeIds":["cnm_234","cnm_233","cnm_071","cnm_083","cnm_p150","cnm_p148"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"C (10), with D=(7,3)","reason":"The midpoint sides are half the original diagonals, so AC and BD must be perpendicular and equally long. Since AC=(2,-6), BD must be (6,2) or (-6,-2). These give D=(7,3) or (-5,-1); only the first is in the first quadrant, and 7+3=10.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2001_AMC_12_Q20","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_055","cnm_082","cnm_244"],"id":"midpoint-quarter-turns","label":"Complete the square from a known side","methodDirectNodeIds":{"midpoint-quarter-turns":["cnm_191","cnm_h087","cnm_245","cnm_083"]},"nodeIds":["cnm_191","cnm_h087","cnm_245","cnm_083","cnm_055","cnm_082","cnm_244"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"D: 24","reason":"The boundary has vertices (4,0),(0,3),(−4,0),(0,−3). It consists of four right triangles, each with area 4·3/2=6, so the enclosed area is 24.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2005_AMC_12B_Q07","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_008","cnm_083","cnm_202","cnm_p148"],"id":"quadrant_triangles","label":"Divide the region by the coordinate axes","methodDirectNodeIds":{"quadrant_triangles":["cnm_084","cnm_136","cnm_p150"]},"nodeIds":["cnm_084","cnm_136","cnm_p150","cnm_008","cnm_083","cnm_202","cnm_p148"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"B ((-5√3/3, 5))","reason":"The right angle at B gives A=(5,5tan30°)=(5,5√3/3). A 90° counterclockwise rotation sends (x,y) to (-y,x), producing (-5√3/3,5).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2008_AMC_10B_Q14","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_082","cnm_083","cnm_171","cnm_244"],"id":"special-triangle-quarter-turn","label":"Find the height, then make a quarter-turn","methodDirectNodeIds":{"special-triangle-quarter-turn":["cnm_245","cnm_140","cnm_174"]},"nodeIds":["cnm_245","cnm_140","cnm_174","cnm_082","cnm_083","cnm_171","cnm_244"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"C (6.4)","reason":"Let SP have slope m, so PQ has slope -1/m. The opposite-side distances are 2|m|/sqrt(1+m^2) and 6/sqrt(1+m^2), giving |m|=3. First-quadrant placement selects m=3. The center lies on the midlines y=3(x-4) and y=-(x-10)/3, whose intersection is (23/5,9/5). Its coordinate sum is 32/5=6.4.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2012_AMC_12B_Q17","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_083","cnm_055"],"id":"solution:similar-intercept-triangles:496faa5c8747","label":"Method 1: Use similar right triangles","methodDirectNodeIds":{"similar-intercept-triangles":["cnm_191","cnm_084","cnm_271","cnm_272","cnm_174"]},"nodeIds":["cnm_191","cnm_084","cnm_271","cnm_272","cnm_174","cnm_083","cnm_055"]},{"contextNodeIds":["cnm_083","cnm_h169","cnm_h171"],"id":"equal-opposite-side-distances","label":"Method 2: Equate the distances between opposite sides","methodDirectNodeIds":{"equal-opposite-side-distances":["cnm_191","cnm_084","cnm_h168","cnm_h175","cnm_h172"]},"nodeIds":["cnm_191","cnm_084","cnm_h168","cnm_h175","cnm_h172","cnm_083","cnm_h169","cnm_h171"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"E: 281/13","reason":"The intercepts are (5,0) and (0,12), so the legs are 5 and 12 and the hypotenuse is 13. The altitude to the hypotenuse is 5×12/13 = 60/13. Their sum is 5+12+60/13 = 281/13.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2015_AMC_12B_Q11","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_083","cnm_064","cnm_075"],"id":"solution:area-and-pythagoras:80393f94d446","label":"Find the intercepts and use area","methodDirectNodeIds":{"area-and-pythagoras":["cnm_084","cnm_112","cnm_174","cnm_p148"]},"nodeIds":["cnm_084","cnm_112","cnm_174","cnm_p148","cnm_083","cnm_064","cnm_075"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"D, 2√2","reason":"For y=mx+b, the first-quadrant tangencies give 2m+b=2√(1+m²) and 5m+b=√(1+m²). Thus m=-1/√8 and b=2√2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1996_AMC_12_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_083","cnm_260","cnm_075"],"id":"solution:similar-tangent-triangles:e3a34c1d3056","label":"Locate the intercept using similar triangles","methodDirectNodeIds":{"similar-tangent-triangles":["cnm_262","cnm_202","cnm_271","cnm_272","cnm_174"]},"nodeIds":["cnm_262","cnm_202","cnm_271","cnm_272","cnm_174","cnm_083","cnm_260","cnm_075"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"E: 281/13","reason":"The intercepts are (5, 0) and (0, 12), so the hypotenuse is 13 and the area is 30. The altitudes are 5, 12, and 60/13, whose sum is 281/13.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2015_AMC_10B_Q13","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_083","cnm_064","cnm_110","cnm_075"],"id":"area-and-altitudes","label":"Use the triangle's area to find the third altitude","methodDirectNodeIds":{"area-and-altitudes":["cnm_112","cnm_202","cnm_174","cnm_p148"]},"nodeIds":["cnm_112","cnm_202","cnm_174","cnm_p148","cnm_083","cnm_064","cnm_110","cnm_075"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C: 784","reason":"Write B = (b,b) and D = (d,kd), with b,d positive integers. The area is bd(k - 1), so b·d·(k - 1) = 10^6 = 2^6·5^6. For each prime, its exponent 6 can be distributed among three factors in C(8,2) = 28 ways. These independent choices give 28^2 = 784 distinct parallelograms.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2009_AMC_12B_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["math:prime-factorization","cnm_p147","cnm_174","cnm_083","cnm_183"],"id":"coordinate-area-and-prime-exponents","label":"Convert area into a product of three integers","methodDirectNodeIds":{"coordinate-area-and-prime-exponents":["cnm_084","math:integer-diophantine-equations","cnm_h230","cnm_h231"]},"nodeIds":["cnm_084","math:integer-diophantine-equations","cnm_h230","cnm_h231","math:prime-factorization","cnm_p147","cnm_174","cnm_083","cnm_183"]}]}],"layer":"ailleo","meaning":"Reviewed content-bound concept practice; no claim of complete source-standard coverage or learner mastery.","nextOffset":null,"nodeId":"cnm_083","status":"mapped","total":68}
