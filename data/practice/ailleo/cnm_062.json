cnm_062"]},"nodeIds":["cnm_063","cnm_062","cnm_059"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"D","reason":"OA and OB are opposite rays, as are OC and OD. Therefore ∠AOC and ∠BOD are vertical angles.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_063_q2","reviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"check-named-rays","label":"Check the opposite-ray conditions","methodDirectNodeIds":{"check-named-rays":["cnm_053","cnm_063","cnm_062"]},"nodeIds":["cnm_053","cnm_063","cnm_062"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"12","reason":"Each exterior angle is 180°-150°=30°, so the polygon has 360°/30°=12 sides.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_182_q3","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_062","cnm_180"],"id":"cnm_182_q3_m1","label":"Use the supplementary exterior angle","methodDirectNodeIds":{"cnm_182_q3_m1":["cnm_182"]},"nodeIds":["cnm_182","cnm_062","cnm_180"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"80","reason":"Angle DCE is the exterior angle at C, so it equals the opposite interior angle A. Therefore angle A = 80°.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_255_q3","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_062","cnm_059"],"id":"cnm_255_q3_m1","label":"Exterior angle of a cyclic quadrilateral","methodDirectNodeIds":{"cnm_255_q3_m1":["cnm_255"]},"nodeIds":["cnm_255","cnm_062","cnm_059"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B: 180(n-4)/n degrees","reason":"Each polygon exterior angle is 360/n degrees. The triangular star point therefore has angle 180-2(360/n)=180(n-4)/n degrees.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","