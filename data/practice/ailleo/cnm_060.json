_p148","cnm_p077","cnm_p089","cnm_060","cnm_075"]},{"contextNodeIds":["cnm_p077","cnm_p089","cnm_060","cnm_075"],"id":"solution:equal-area-dissection:2c937901d497","label":"Replace equal areas and subtract","methodDirectNodeIds":{"equal-area-dissection":["cnm_124","cnm_121","cnm_p148","cnm_p150","cnm_147"]},"nodeIds":["cnm_124","cnm_121","cnm_p148","cnm_p150","cnm_147","cnm_p077","cnm_p089","cnm_060","cnm_075"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"C, 36","reason":"The corner right triangles are congruent, so AH=BE=1. If the inner side is x, then BH=x+1. In right triangle AHB, 50=1+(x+1)², so x+1=7 and x=6. The inner area is therefore 6²=36.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2005_AMC_10A_Q08","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_060","cnm_055","cnm_075"],"id":"solution:corner-triangle-pythagoras:7fe7781ba964","label":"Compare adjacent corner triangles","methodDirectNodeIds":{"corner-triangle-pythagoras":["cnm_191","cnm_p089","cnm_124","cnm_121","cnm_174"]},"nodeIds":["cnm_191","cnm_p089","cnm_124","cnm_121","cnm_174","cnm_060","cnm_055","cnm_075"]},{"contextNodeIds":["cnm_060","cnm_055","cnm_075"],"id":"square-area-partition","label":"Compare the areas of the pieces","methodDirectNodeIds":{"square-area-partition":["cnm_191","cnm_p089","cnm_124","cnm_121","cnm_p150","cnm_p148","cnm_148"]},"nodeIds":["cnm_191","cnm_p089","cnm_124","cnm_121","cnm_p150","cnm_p148","cnm_148","cnm_060","cnm_055","cnm_075"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C: sqrt(ab)","reason":"Write AB=d and choose A=(0,0), B=(d,0), D=(0,a), and C=(d,b). The diameter theorem gives AC perpendicular to BD, so (b/d)(-a/d)=-1. Hence d^2=ab.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1967_AMC_12_Q29","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_260",