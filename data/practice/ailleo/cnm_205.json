s":["cnm_202","cnm_205"]},"nodeIds":["cnm_202","cnm_205"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B, x=3.0","reason":"The original area is 8·1/2=4. For a cut x=t with 1≤t≤9, the right-hand area is (9-t)(1-t/9)/2=(9-t)²/18. Setting it equal to 2 gives 9-t=6, hence t=3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1982_AMC_12_Q09","reviewStatus":"machine_examined","routes":[{"id":"coordinate-triangle-area","label":"Express the cut-off triangle's area","nodeIds":["cnm_205","cnm_220"]},{"contextNodeIds":["cnm_p148","cnm_201","cnm_075"],"id":"solution:coordinate-triangle-area:6b180a1be298","label":"Find the area to the right of the cut","methodDirectNodeIds":{"coordinate-triangle-area":["cnm_084","cnm_205","cnm_220"]},"nodeIds":["cnm_084","cnm_205","cnm_220","cnm_p148","cnm_201","cnm_075"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C, -4","reason":"Replacing the original y-coordinate by -y gives x+3y+11=0, or y=-x/3-11/3. Hence m+b=-1/3-11/3=-4.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1992_AMC_12_Q12","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"reflect-two-intercepts","label":"Reflect two intercepts","methodDirectNodeIds":{"reflect-two-intercepts":["cnm_136","cnm_202","cnm_205"]},"nodeIds":["cnm_136","cnm_202","cnm_205"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"E: 20","reason":"Since BE = 1, BF = 2, and AD = 3, similarity gives BP/PD = 1/3 and BQ/QD = 2/3. Thus BP = BD/4 and BQ = 2BD/5, so BP:PQ:QD = 1/4:3/20:3/5 = 5:3:12. Their sum is 20.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2016_AMC_10A_Q19","reviewStatus":"machine_examined","routes":[{"id":"coordinate-intersections","label":"Find intersections using coordinates","nodeIds":["cnm_205","cnm_208"]},{"contextNodeIds":["cnm_082","cnm_201","cnm_p210","cnm_p077"],"id":"solution:coordinate-intersections:3b5acb8bb902","label":"Line equations","methodDirectNodeIds":{"coordinate-intersections":["cnm_268","cnm_205","cnm_208","cnm_174","cnm_055","cnm_p186"]},"nodeIds":["cnm_268","cnm_205","cnm_208","cnm_174","cnm_055","cnm_p186","cnm_082","cnm_201","cnm_p210","cnm_p077"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"1","reason":"The points give k+b=3 and 3k+b=7. Subtraction yields k=2, then b=1; at x=0, y=1.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_197_q5","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_042"],"id":"determine-coefficients","label":"Determine the linear coefficients","methodDirectNodeIds":{"determine-coefficients":["cnm_205","cnm_202"]},"nodeIds":["cnm_205","cnm_202","cnm_042"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"21","reason":"The equations k+b=3 and 2k+b=5 give k=2 and b=1. Therefore y(10)=2(10)+1=21.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_198_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_029"],"id":"constant-change-to-formula","label":"Use constant change to find the formula","methodDirectNodeIds":{"constant-change-to-formula":["cnm_205","cnm_196"]},"nodeIds":["cnm_205","cnm_196","cnm_029"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"y=2x+1","reason":"The point (0,1) gives b=1. Substituting (2,5) gives 5=2k+1, hence k=2 and y=2x+1.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_205_q1","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_042"],"id":"determine-coefficients","label":"Determine the coefficients from the points","methodDirectNodeIds":{"determine-coefficients":["cnm_205"]},"nodeIds":["cnm_205","cnm_