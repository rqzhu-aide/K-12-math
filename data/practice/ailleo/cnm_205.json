m_201"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"D: 194","reason":"Since BC=CD, CP is perpendicular to BD. Together with AD⊥BD and AB∥CD, similarity gives AB=2CD=86. The diagonal ratio gives DO=BD/3, so OP=BD/6=11 and BD=66. Thus AD=√(86²-66²)=4√190, giving m+n=194.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2021_AMC_12A_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-distance","label":"Use coordinates and distances","methodDirectNodeIds":{"coordinate-distance":["cnm_084","cnm_h173","cnm_205"]},"nodeIds":["cnm_084","cnm_h173","cnm_205"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"C: 3","reason":"Similarity gives AH/HC=AF/EC=2/3 and AJ/JC=AG/EC=4/3. Thus HJ/AC=4/7-2/5=6/35. Triangle EAC has one quarter of the rectangle's area, so [EHJ]=(6/35)(70/4)=3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2001_AMC_12_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_055","cnm_p077","cnm_p089","cnm_042","cnm_p173"],"id":"coordinate-intersections-and-area-difference","label":"Find the intersection heights with coordinates","methodDirectNodeIds":{"coordinate-intersections-and-area-difference":["cnm_084","cnm_205","cnm_208","cnm_p148","cnm_p150"]},"nodeIds":["cnm_084","cnm_205","cnm_208","cnm_p148","cnm_p150","cnm_055","cnm_p077","cnm_p089","cnm_042","cnm_p173"]}]}],"layer":"ailleo","meaning":"Reviewed content-bound concept practice; no claim of complete source-standard coverage or learner mastery.","nextOffset":null,"nodeId":"cnm_205","status":"mapped","total":42}
