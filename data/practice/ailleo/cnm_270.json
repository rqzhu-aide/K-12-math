ssed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2024_AMC_10B_Q11","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p150","cnm_p089","cnm_186","cnm_116","cnm_270"],"id":"similar-right-triangles","label":"Use equal areas and similar right triangles","methodDirectNodeIds":{"similar-right-triangles":["cnm_p148","cnm_271","cnm_272"]},"nodeIds":["cnm_p148","cnm_271","cnm_272","cnm_p150","cnm_p089","cnm_186","cnm_116","cnm_270"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"C (15)","reason":"Equal areas give XM = 2ZA, hence MY = 2YA. Since triangles WXM and MYA are similar, WX/XM = MY/YA = 2. Thus XM = 2, ZA = 1, YA = 3, and MY = 6. The desired area is 32 - 4 - 4 - (6·3/2) = 15.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2024_AMC_12B_Q07","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_186","cnm_116","cnm_270","cnm_p089"],"id":"similar-right-triangles","label":"Method 1: Similar right triangles","methodDirectNodeIds":{"similar-right-triangles":["cnm_p148","cnm_p150","cnm_271","cnm_272"]},"nodeIds":["cnm_p148","cnm_p150","cnm_271","cnm_272","cnm_186","cnm_116","cnm_270","cnm_p089"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C: sqrt(ab)","reason":"Write AB=d and choose A=(0,0), B=(d,0), D=(0,a), and C=(d,b). The diameter theorem gives AC perpendicular to BD, so (b/d)(-a/d)=-1. Hence d^2=ab.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1967_AMC_12_Q29","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_260","cnm_116","cnm_060","cnm_270","cnm_074"],"id":"solution:right-triangle-similarity:5d2dbc624a57","label":"Find similar right triangles","methodDirectNodeIds":{"right-triangle-similarity":["cnm_254","cnm_262","cnm_271","cnm_272"]},"nodeIds":["cnm_254","cnm_262","cnm_271","cnm_272","cnm_260","cnm_116","cnm_060","cnm_270","cnm_074"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C, 9k/8","reason":"Midpoint similarities give QA=AB=BP, hence QP=3AB. Triangles OQP and OCD are similar with side ratio 3, so O is at 3/4 of the parallelogram height h above QP. Therefore [QPO]=(1/2)(3AB)(3h/4)=9k/8.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1974_AMC_12_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_270","cnm_069","cnm_063","cnm_055","cnm_183","cnm_p147"],"id":"solution:midpoint-similarities:931ddde2192d","label":"Similar triangles and heights","methodDirectNodeIds":{"midpoint-similarities":["cnm_271","cnm_272","cnm_p148"]},"nodeIds":["cnm_271","cnm_272","cnm_p148","cnm_270","cnm_069","cnm_063","cnm_055","cnm_183","cnm_p147"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C, 24π","reason":"DF = 6 + 2 = 8. Because CD is a diameter, angle DFC is 90°. Triangles DOE and DFC are similar, so r/6 = 8/(2r). Hence r² = 24 and the circle's area is 24π.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1995_AMC_12_Q26","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_250","cnm_270","cnm_064","cnm_055","cnm_p211"],"id":"solution:diameter-similarity:2c0c33d783e8","label":"Use the right angle subtended by a diameter","methodDirectNodeIds":{"diameter-similarity":["cnm_254","cnm_271","cnm_272","cnm_p192"]},"nodeIds":["cnm_254","cnm_271","cnm_272","cnm_p192","cnm_250","cnm_270","cnm_064","cnm_055","cnm_p211"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"E: 20","reason":"Since BE = 1, BF = 2, and AD = 3, similarity gives BP/PD = 1/3 and BQ/QD = 2/3. Thus BP = BD/4 and BQ = 2BD/5, so BP:PQ:QD = 1/4:3/20:3/5 = 5:3:12. Their sum is 20.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2016_AMC_10A_Q19","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_270","cnm_069","cnm_p210","cnm_p077"],"id":"solution:similar-triangle-ratios:3b5acb8bb902","label":"Similar triangles","methodDirectNodeIds":{"similar-triangle-ratios":["cnm_268","cnm_271","cnm_272","cnm_055","cnm_p186"]},"nodeIds":["cnm_268","cnm_271","cnm_272","cnm_055","cnm_p186","cnm_270","cnm_069","cnm_p210","cnm_p077"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"D, the ratio of an altitude to its corresponding base","reason":"With a fixed base and height, the third vertex can slide parallel to the base while the angles change. The other data determine similarity: SAS or AA directly, reciprocal side ratios from altitudes, and side ratios from the median-square identities.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1951_AMC_12_Q29","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_270","cnm_112","cnm_113","cnm_174","cnm_148","cnm_082"],"id":"check-similarity-data","label":"Check which data determine similarity","methodDirectNodeIds":{"check-similarity-data":["cnm_271","cnm_p148","math:stewart-theorem","cnm_071"]},"nodeIds":["cnm_271","cnm_p148","math:stewart-theorem","cnm_071","cnm_270","cnm_112","cnm_113","cnm_174","cnm_148","cnm_082"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"E: 16","reason":"The displayed order F,G,E,B gives GE=32-24=8. Similarity gives AE/CE=FE/BE and AE/CE=BE/GE. Therefore BE²=FE·GE=32·8=256, so BE=16.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1963_AMC_12_Q38","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_183","cnm_055","cnm_069","cnm_063","cnm_270","cnm_p210","cnm_075"],"id":"two-aa-similarities","label":"Compare two pairs of similar triangles","methodDirectNodeIds":{"two-aa-similarities":["cnm_271","cnm_272","cnm_220"]},"nodeIds":["cnm_271","cnm_272","cnm_220","cnm_183","cnm_055","cnm_069","cnm_063","cnm_270","cnm_p210","cnm_075"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"A: 7/2","reason":"Let theta=angle ADB. Triangle ABD is right, so sin(theta)=1/4. Equal sides AB and BC, together with the inscribed-angle and cyclic-quadrilateral relations, give angle ADC=2theta. Therefore CD=4cos(2theta)=4(1-2/16)=7/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1971_AMC_12_Q31","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_250","cnm_055","cnm_112","cnm_270"],"id":"solution:similar-right-triangles:837341f77299","label":"Use a midpoint to create similar right triangles","methodDirectNodeIds":{"similar-right-triangles":["cnm_254","cnm_253","cnm_137","cnm_271","cnm_272","cnm_174"]},"nodeIds":["cnm_254","cnm_253","cnm_137","cnm_271","cnm_272","cnm_174","cnm_250","cnm_055","cnm_112","cnm_270"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"C. BC is parallel to MN.","reason":"The angle bisector theorem gives BD/CD=AB/AC. Since BM=BD and CN=CD, BM/AB=CN/AC, hence AM/AB=AN/AC. With the common included angle A, triangles AMN and ABC are similar, so MN∥BC.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1975_AMC_12_Q26","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_250","cnm_114","cnm_268","cnm_111","cnm_270","cnm_066"],"id":"angle-bisector-and-similarity","label":"Angle bisector ratios and similarity","methodDirectNodeIds":{"angle-bisector-and-similarity":["math:angle-bisector-side-ratio","cnm_271","cnm_272","cnm_068"]},"nodeIds":["math:angle-bisector-side-ratio","cnm_271","cnm_272","cnm_068","cnm_250","cnm_114","cnm_268","cnm_111","cnm_270","cnm_066"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"E: 1/6","reason":"Take D=(0,0), C=(1,0), A=(0,2), B=(1,2), F=(1/2,0), and H=(1/2,1). The side intersections are (1/3,2/3) and (2/3,2/3). Each shaded triangle has base HF=1 and altitude 1/6, so their total area is 2·(1/2)·1·(1/6) = 1/6.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2014_AMC_10A_Q16","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_055","cnm_p077","cnm_p148","cnm_063","cnm_069","cnm_270"],"id":"parallel-sides-similarity","label":"Use similar triangles between parallel sides","methodDirectNodeIds":{"parallel-sides-similarity":["cnm_p150","cnm_271","cnm_272","cnm_132"]},"nodeIds":["cnm_p150","cnm_271","cnm_272","cnm_132","cnm_055","cnm_p077","cnm_p148","cnm_063","cnm_069","cnm_270"]}]},{"additionalConceptCount":10,"answerCheck":{"derivedAnswer":"A, base angle and vertex angle of an isosceles triangle","reason":"In A, dilation preserves both given angles while changing the triangle's size. B and E determine triangles through ASA/AAS, and C fixes the equilateral scale. In D, a leg a and inradius r determine the other leg as 2r(a - r)/(a - 2r), for feasible data.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1956_AMC_12_Q26","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_115","cnm_137","cnm_139","cnm_265","cnm_270"],"id":"compare-shape-and-size","label":"Compare which data fix both shape and size","methodDirectNodeIds":{"compare-shape-and-size":["cnm_271","cnm_124","cnm_264","cnm_263","cnm_174","cnm_123"]},"nodeIds":["cnm_271","cnm_124","cnm_264","cnm_263","cnm_174","cnm_123","cnm_115","cnm_137","cnm_139","cnm_265","cnm_270"]}]},{"additionalConceptCount":10,"answerCheck":{"derivedAnswer":"E, 500","reason":"Let the consecutive equal sides be AB=BC=CD=200. The half-chord triangle gives the chord-center distance h=√((200√2)²-100²)=100√7. Inscribed angles and similarity give AC=BD=2(200)h/(200√2)=100√14. Ptolemy yields 200·AD=140000-40000, so AD=500.","status":"matches"},"as