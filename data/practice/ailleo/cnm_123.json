d","routes":[{"contextNodeIds":[],"id":"equilateral-auxiliary-construction","label":"Equilateral construction and congruence","methodDirectNodeIds":{"equilateral-auxiliary-construction":["cnm_139","cnm_123","cnm_137","cnm_138"]},"nodeIds":["cnm_139","cnm_123","cnm_137","cnm_138"]},{"contextNodeIds":["cnm_055","cnm_058","cnm_062","cnm_121"],"id":"equilateral-and-isosceles-construction","label":"Create matching isosceles triangles","methodDirectNodeIds":{"equilateral-and-isosceles-construction":["cnm_130","cnm_139","cnm_123","cnm_137","cnm_138","cnm_115"]},"nodeIds":["cnm_130","cnm_139","cnm_123","cnm_137","cnm_138","cnm_115","cnm_055","cnm_058","cnm_062","cnm_121"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C (equal hypotenuse and one leg)","reason":"C gives the hypotenuse and one leg, the HL pattern. A gives SAS using the right angle; B and D supply angle-side criteria together with the equal right angles.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":["'Requires using HL' is interpreted as identifying the direct given-data criterion, not excluding a longer Pythagorean reduction to SSS.","Interpret requires HL as directly applicable from the current givens, not as uniqueness after all possible auxiliary derivations."],"questionId":"cnm_125_q3","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_110","cnm_120"],"id":"compare-direct-criteria","label":"Compare directly applicable criteria","methodDirectNodeIds":{"compare-direct-criteria":["cnm_125","cnm_123","cnm_124"]},"nodeIds":["cnm_125","cnm_123","cnm_124","cnm_110","cnm_120"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"5","reason":"CE=6−2=4 and CF=6−3=3. Since ∠ECF=90°, EF=√(4²+3²)=5.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_247_q3","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"quarter-turn-length-sum","label":"Rotate to obtain EF=BE+DF","methodDirectNodeIds":{"quarter-turn-length-sum":["cnm_247","cnm_245","cnm_123","cnm_121"]},"nodeIds":["cnm_247","cnm_245","cnm_123","cnm_121"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"D, 4√7","reason":"Each boundary segment of GCHF is opposite a 120-degree angle between lengths 1 and 2. Its squared length is 1²+2²-2·1·2·cos120°=7. All four segments therefore have length √7, giving perimeter 4√7.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2022_AMC_12B_Q10","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"hexagon-vertex-cosine-law","label":"Use the 120-degree vertex angles","methodDirectNodeIds":{"hexagon-vertex-cosine-law":["cnm_181","cnm_055","cnm_123","cnm_h065","math:general-cosine-law-application"]},"nodeIds":["cnm_181","cnm_h065","math:general-cosine-law-application","cnm_055","cnm_123"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"E, sqrt(30)","reason":"Write OX=OY=r. Equal chords give equal angles OZX and OZY. The cosine law therefore gives (290-r^2)/286=(170-r^2)/154. Simplifying yields 6r^2=180, so r=sqrt(30).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2012_AMC_12A_Q16","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_250","cnm_259"],"id":"equal-chords-and-congruence","label":"Turn equal radii into equal angles","methodDirectNodeIds":{"equal-chords-and-congruence":["cnm_253","cnm_252","cnm_123","cnm_137","cnm_174"]},"nodeIds":["cnm_253","cnm_252","cnm_123","cnm_137","cnm_174","cnm_250","cnm_259"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"E: 37:1","reason":"Let K = [ABC]. Each outer piece, such as triangle A'AB', has base AB' = 4AB and height three times the height from C to AB, so its area is 12K. The three such pieces together with ABC partition A'B'C', giving total area K + 3(12K) = 37K.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2017_AMC_10B_Q19","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"congruence-and-general-cosine","label":"Congruence and a general cosine-law side ratio","methodDirectNodeIds":{"congruence-and-general-cosine":["cnm_139","cnm_123","math:general-cosine-law-application","cnm_h065","cnm_272"]},"nodeIds":["cnm_139","cnm_123","math:general-cosine-law-application","cnm_h065","cnm_272"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"E, 37:1","reason":"Triangles A'AB', B'BC', and C'CA' each have 3 times a corresponding base and 4 times its height in ABC, so each has 12 times its area. Together with ABC they fill A'B'C', giving 1 + 3(12) = 37.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2017_AMC_12B_Q15","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"outer-side-general-cosine","label":"Use congruent outer triangles and a 120-degree cosine","methodDirectNodeIds":{"outer-side-general-cosine":["cnm_139","cnm_123","math:general-cosine-law-application","cnm_h065","cnm_272"]},"nodeIds":["cnm_139","cnm_123","math:general-cosine-law-application","cnm_h065","cnm_272"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"D","reason":"BD=DC, AD=DE and the vertical angles at D are equal, so SAS gives AB=CE. In △ACE, AC+CE>AE=2AD, hence AB+AC>2AD.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_130_q1","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_113","cnm_063","cnm_055"],"id":"median_extension","label":"Double the median","methodDirectNodeIds":{"median_extension":["cnm_130","cnm_123","cnm_121","cnm_111"]},"nodeIds":["cnm_130","cnm_123","cnm_121","cnm_111","cnm_113","cnm_063","cnm_055"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"A: AM=BM+CM","reason":"Write AB=BC=CA=s. Ptolemy's theorem for cyclic quadrilateral ABMC gives AM·BC=AB·MC+AC·BM, hence s·AM=s·CM+s·BM and AM=BM+CM.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1957_AMC_12_Q48","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_121","cnm_058","cnm_250"],"id":"auxiliary-equilateral-triangle","label":"Turn the sum into one straight segment","methodDirectNodeIds":{"auxiliary-equilateral-triangle":["cnm_130","cnm_123","cnm_255","cnm_139","cnm_055"]},"nodeIds":["cnm_130","cnm_123","cnm_255","cnm_139","cnm_055","cnm_121","cnm_058","cnm_250"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"E, 12√3","reason":"Let each hexagon side be s. A perpendicular projection in a 30° ear triangle gives BF²=(2-√3)s². The total area is (√3/4)(2-√3)s²+3s²/4=(√3/2)s². Equating this to 6√3 gives s²=12, so the perimeter is 6s=12√3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2021_Fall_AMC_12A_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_121","cnm_p148","cnm_173"],"id":"method_1","label":"Separate the three pointed triangles","methodDirectNodeIds":{"method_1":["cnm_p150","cnm_123","cnm_139","cnm_140","cnm_174"]},"nodeIds":["cnm_p150","cnm_123","cnm_139","cnm_140","cnm_174","cnm_121","cnm_p148","cnm_173"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"C, 3√35","reason":"Let BY=u and DX=v. Similarity gives v/u=3/2. Also AY=4 and CX=3, so AB=CD gives u²+16=v²+9. Hence u²=28/5, v²=63/5, and u+v=√35. Since AC=6, the area is 6(u+v)/2=3√35.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2021_Fall_AMC_12A_Q21","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_121","cnm_055","cnm_064","cnm_p148","cnm_075"],"id":"method_1","label":"Use the equal diagonals","methodDirectNodeIds":{"method_1":["cnm_p150","cnm_174","cnm_123"]},"nodeIds":["cnm_p150","cnm_174","cnm_123","cnm_121","cnm_055","cnm_064","cnm_p148","cnm_075"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"A: d = a + b","reason":"Number consecutive vertices V0 through V8 and let c be the chord spanning three sides. In cyclic quadrilateral V0V1V3V6, the sides are a, b, c, c and the diagonals are c, d. Ptolemy gives cd = ac + bc, so d = a + b.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1977_AMC_12_Q30","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_250","cnm_180","cnm_121"],"id":"equilateral-cut-and-congruence","label":"Split the longest diagonal using an equilateral triangle","methodDirectNodeIds":{"equilateral-cut-and-congruence":["cnm_266","cnm_252","cnm_253","cnm_139","cnm_123","cnm_055"]},"nodeIds":["cnm_266","cnm_252","cnm_253","cnm_139","cnm_123","cnm_055","cnm_250","cnm_180","cnm_121"]}]},{"additionalConceptCount":10,"answerCheck":{"derivedAnswer":"A, base angle and vertex angle of an isosceles triangle","reason":"In A, dilation preserves both given angles while changing the triangle's size. B and E determine triangles through ASA/AAS, and C fixes the equilateral scale. In D, a leg a and inradius r determine the other leg as 2r(a - r)/(a - 2r), for feasible data.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1956_AMC_12_Q26","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_115","cnm_137","cnm_139","cnm_265","cnm_270"],"id":"compare-shape-and-size","label":"Compare which data fix both shape and size","methodDirectNodeIds":{"compare-shape-and-size":["cnm_271","cnm_124","cnm_264","cnm_263","cnm_174","cnm_123"]},"nodeIds":["cnm_271","cnm_124","cnm_264","cnm_263","cnm_174","cnm_123","cnm_115","cnm_137","cnm_139","cnm_265","cnm_270"]}]}],"laye