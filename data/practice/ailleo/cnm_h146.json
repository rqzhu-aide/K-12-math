ar vectors","methodDirectNodeIds":{"spatial-dot-product":["cnm_h152","cnm_h146","cnm_h147"]},"nodeIds":["cnm_h152","cnm_h146","cnm_h147"]},{"contextNodeIds":[],"id":"coordinates-and-dot-product","label":"Turn perpendicularity into an equation","methodDirectNodeIds":{"coordinates-and-dot-product":["cnm_266","cnm_h152","cnm_h146"]},"nodeIds":["cnm_266","cnm_h152","cnm_h146"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C. Collinear","reason":"b=(2,0,4)=2(1,0,2)=2a, so the vectors are collinear.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h148_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h153"],"id":"m1","label":"Scalar multiple and dot product","methodDirectNodeIds":{"m1":["cnm_h148","cnm_h146"]},"nodeIds":["cnm_h148","cnm_h146","cnm_h153"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C. They are perpendicular.","reason":"Normal vectors are nonzero, so their zero dot product means they are perpendicular. The corresponding planes are therefore perpendicular.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h160_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h146","cnm_h156"],"id":"cnm_h160_q2_m1","label":"Perpendicular normal vectors","methodDirectNodeIds":{"cnm_h160_q2_m1":["cnm_h160"]},"nodeIds":["cnm_h160","cnm_h146","cnm_h156"]}]},{"additionalConceptCount":3,"answerCheck":{"adjudication":"Coordinator checked the displayed task and explicit alternate reading or counterexample. The source key is preserved; the effective practice view withholds grading.","derivedAnswer":"Guaranteed: 0<=theta<90 degrees. No listed choice states this full conclusion.","reason":"For nonzero vectors a dot b>0 implies 0<=theta<90 degrees, including same-direction theta=0. Thus C is not guaranteed, while D is possible but not necessary. The stored di