]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"1/3","reason":"Let [XYZ] denote triangle area. Since BE is a median of △ABD, [ABE] = [DBE]. Also BC = 3BD gives [BCE] = 3[DBE]. Because B,E,F and A,F,C are collinear, [ABE]/[CBE] = AF/FC = 1/3.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_273_q4","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"parallel-line-similarity","label":"Parallel-line construction","methodDirectNodeIds":{"parallel-line-similarity":["cnm_273","cnm_271","cnm_272"]},"nodeIds":["cnm_273","cnm_271","cnm_272"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, 360","reason":"Take A=(0,0), C=(20,0), D=(20,30), and E=(5,0). Since E lies on segment BD, write B=(5−t,−2t), t>0. The right-angle condition at B gives t²+2t−15=0, so t=3 and B has height 6 below AC. The area is 20(30+6)/2=360.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2020_AMC_12A_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"right-triangle-similarity","label":"Altitude and similar triangles","methodDirectNodeIds":{"right-triangle-similarity":["cnm_271","cnm_272","cnm_273","cnm_224"]},"nodeIds":["cnm_271","cnm_272","cnm_273","cnm_224"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, 117","reason":"Triangles ABP and BCQ are congruent, so CQ=BP=13. In right triangle BCQ, altitude BR=6 gives CR·RQ=36 and CR+RQ=13. Since BC>BQ, CR=9 and RQ=4. Thus BC²=CQ·CR=13·9=117.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2021_Fall_AMC_10B_Q15","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"right-triangle-altitude","label":"Congruence and hypotenuse projections","methodDirectNodeIds":{"right-triangle-altitude":["cnm_124","cnm_121","cnm_273","cnm_224"]},"nodeIds":[