judicated","routes":[{"contextNodeIds":["cnm_h080"],"id":"m1","label":"Verify the scalar multiplier","methodDirectNodeIds":{"m1":["cnm_h087","cnm_h084"]},"nodeIds":["cnm_h087","cnm_h084","cnm_h080"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"D; they are not collinear","reason":"(1,0) is horizontal and (0,1) is vertical, so their directions are neither the same nor opposite.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":["The ordered pairs denote vectors in the visible vector-collinearity topic, not two points."],"questionId":"cnm_h084_q3","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_h087"],"id":"m1","label":"Test for a scalar multiple","methodDirectNodeIds":{"m1":["cnm_h084"]},"nodeIds":["cnm_h084","cnm_h087"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"5","reason":"α(1,0)+β(0,1)=(α,β)=(3,5), so β=5.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h085_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h083"],"id":"cnm_h085_q3_m1","label":"Standard-basis decomposition","methodDirectNodeIds":{"cnm_h085_q3_m1":["cnm_h085","cnm_h087"]},"nodeIds":["cnm_h085","cnm_h087","cnm_h083"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B; it is unique","reason":"αe1+βe2=(α,β)=(3,5) forces α=3 and β=5, giving exactly one coefficient pair.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h085_q4","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_081"],"id":"cnm_h085_q4_m2","label":"Compare coordinates","methodDirectNodeIds":{"cnm_h085_q4_m2":["cnm_h087"]},"nodeIds":["cnm_h087","cnm_081"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"C, 15","reason":"Draw DG parallel to CF with G on AB. Since D is the midpoint of AC, AG=GF. Since E is the midpoint of BD, BF=FG. Thus BA=3BF=15.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1959_AMC_12_Q40","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"vector-collinearity","label":"Use vectors and collinearity","methodDirectNodeIds":{"vector-collinearity":["cnm_h085","cnm_h087","cnm_h084"]},"nodeIds":["cnm_h085","cnm_h087","cnm_h084"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"A. sqrt(17)","reason":"Take the centroid as origin and write A=(a,0), B=(0,b), C=(-a,-b). Then AC^2=4a^2+b^2=36 and BC^2=a^2+4b^2=49. Adding gives a^2+b^2=17, so AB=sqrt(17).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1970_AMC_12_Q28","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"centroid-coordinate-axes","label":"Put the medians on coordinate axes","methodDirectNodeIds":{"centroid-coordinate-axes":["math:centroid-ratios","cnm_h087","cnm_h173"]},"nodeIds":["math:centroid-ratios","cnm_h087","cnm_h173"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B, 6.8","reason":"The crease is y=2x-3. The perpendicular foot from (7,3) is (19/5,23/5), so the reflected point is (3/5,31/5). Hence m+n=34/5=6.8.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1998_AMC_12_Q25","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"normal-vector-reflection","label":"Reflect using a normal vector","methodDirectNodeIds":{"normal-vector-reflection":["cnm_h086","cnm_h088","cnm_h087"]},"nodeIds":["cnm_h086","cnm_h088","cnm_h087"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"E, 225","reason":"Let k be the vertical change along the edge joining the two upper blocks. For |k| = 0,1,2,3,4, the respective counts are 85,44,19,6,1, found by summing squared triangular multiplicities for 5 - |k| coordinate choices. Both tilt signs occur when k ≠ 0, giving 85 + 2(44 + 19 + 6 + 1) = 225.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2009_AMC_12B_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"side-tilt-count","label":"Classify squares by side tilt","methodDirectNodeIds":{"side-tilt-count":["math:lattice-counting","cnm_245","cnm_h087"]},"nodeIds":["math:lattice-counting","cnm_245","cnm_h087"]},{"contextNodeIds":[],"id":"square-center-count","label":"Count integer and half-integer centers","methodDirectNodeIds":{"square-center-count":["math:lattice-counting","cnm_248","cnm_245","cnm_h087"]},"nodeIds":["math:lattice-counting","cnm_248","cnm_245","cnm_h087"]},{"contextNodeIds":["cnm_174","cnm_191","cnm_h231"],"id":"upper-side-rise","label":"Count by the rise of the upper side","methodDirectNodeIds":{"upper-side-rise":["cnm_h232","math:lattice-counting","cnm_245","cnm_h087","cnm_136"]},"nodeIds":["cnm_h232","math:lattice-counting","cnm_245","cnm_h087","cnm_136","cnm_174","cnm_191","cnm_h231"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"D, 2x - 3y = 0","reason":"Reflecting P across y = 5x gives P' = (32/13,43/13). The direction of P'P'' is (2,-3), so its perpendicular bisector through the origin has equation 2x - 3y = 0.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2021_Fall_AMC_10B_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"vector-reflection","label":"Dot-product reflection","methodDirectNodeIds":{"vector-reflection":["cnm_h088","cnm_h087","cnm_h095"]},"nodeIds":["cnm_h088","cnm_h087","cnm_h095"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"A; the coordinates do not depend on placement","reason":"Translating both endpoints by t leaves their difference unchanged: (B+t)-(A+t)=B-A.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h086_q4","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_086","cnm_h079"],"id":"m1","label":"Translation cancellation","methodDirectNodeIds":{"m1":["cnm_h086","cnm_h087"]},"nodeIds":["cnm_h086","cnm_h087","cnm_086","cnm_h079"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B, HE = HG is not necessarily correct","reason":"Midpoint relations give AEHF a parallelogram, BH = CD, G the midpoint of BH, and FG = 3AB/4. For A = (0,0), B = (4,0), C = (0,4), the construction gives HE = 2 but HG = √5, disproving B in general.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1955_AMC_12_Q48","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"coordinate-vector-check","label":"Use coordinates and vectors","methodDirectNodeIds":{"coordinate-vector-check":["cnm_084","cnm_h087","cnm_h090"]},"nodeIds":["cnm_084","cnm_h087","cnm_h090"]},{"contextNodeIds":["cnm_082","cnm_174","cnm_110"],"id":"coordinate-check","label":"Represent the construction with coordinates","methodDirectNodeIds":{"coordinate-check":["cnm_113","cnm_055","cnm_084","cnm_h087","cnm_h173","cnm_184","cnm_071"]},"nodeIds":["cnm_113","cnm_055","cnm_084","cnm_h087","cnm_h173","cnm_184","cnm_071","cnm_082","cnm_174","cnm_110"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C: 2, with m = 12 or 3/4","reason":"For signed leg lengths a and b, the median slopes are -2b/a and -b/(2a), whose ratio is 4. Thus the other slope is 12 or 3/4. Both are realizable with the specified intercepts and nonzero legs.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1986_AMC_12_Q26","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"use-centroid-coordinate-vectors","label":"Centroid coordinate relations","methodDirectNodeIds":{"use-centroid-coordinate-vectors":["math:centroid-ratios","cnm_h087","cnm_090"]},"nodeIds":["math:centroid-ratios","cnm_h087","cnm_090"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B, 2024","reason":"Add a hypothetical 2016th flight. Each complete 12-flight block has displacement (-6,-12-6√3), so 168 blocks give (-1008,-2016-1008√3). Subtracting flight 2016, whose vector is (1008√3,-1008), leaves (-1008(1+√3),-1008(1+√3)). Its length is 1008√2+1008√6, giving 1008+2+1008+6=2024.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2015_AMC_12B_Q25","reviewStatus":"machine_adjudicated","routes":[{"id":"twelve-leg-vector-blocks","label":"Group displacement vectors into 12-leg blocks","nodeIds":["cnm_h056","cnm_h065","cnm_h087"]},{"contextNodeIds":["cnm_h080","cnm_277","cnm_174","cnm_173"],"id":"solution:twelve-leg-vector-blocks:26c491e61648","label":"Pair opposite flights in twelve-flight blocks","methodDirectNodeIds":{"twelve-leg-vector-blocks":["cnm_h081","cnm_h090","cnm_h087","cnm_h056","cnm_h065"]},"nodeIds":["cnm_h081","cnm_h090","cnm_h087","cnm_h056","cnm_h065","cnm_h080","cnm_277","cnm_174","cnm_173"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"A, (1+√5)/2","reason":"The acute bisector has 1<k<3. Equal distances from (1,k) to the lines give (k-1)/√2=(3-k)/√10, hence k=(3+√5)/(1+√5)=(1+√5)/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2021_Fall_AMC_12A_Q13","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"equal-length-directions","label":"Add equal-length directions","methodDirectNodeIds":{"equal-length-directions":["cnm_h087","cnm_h173","cnm_122","cnm_h167"]},"nodeIds":["cnm_h087","cnm_h173","cnm_122","cnm_h167"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D: 2024","reason":"The Pythagorean theorem gives AC=2, so the hypotenuse median BM has length 1. There are 1012 pairs, each summing to 2 times vector BM. Thus the total is 2024 times vector BM and has length 2024.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2024_AMC_12A_Q07","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-summation","label":"Sum coordinates of equally spaced points","methodDirectNodeIds":{"coordinate-summation":["cnm_h087","cnm_h204","cnm_h090"]},"nodeIds":["cnm_h087","cnm_h204","cnm_h090"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"B: 15","reason":"The original slope is 3/5, and (20,20) lies on the line. After the counterclockwise rotation, the slope is ((3/5)+1)/(1-(3/5))=4. Thus k has equation y-20=4(x-20), whose x-intercept is 15.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2020_AMC_12A_Q12","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"rotate-a-direction-vector","label":"Rotate a direction vector in coordinates","methodDirectNodeIds":{"rotate-a-direction-vector":["cnm_h086","cnm_h087","cnm_277","cnm_h169"]},"nodeIds":["cnm_h086","cnm_h087","cnm_277","cnm_h169"]},{"contextNodeIds":[],"id":"bisect-a-right-angle","label":"Bisect a right angle","methodDirectNodeIds":{"bisect-a-right-angle":["cnm_245","cnm_h086","cnm_h087","cnm_137","cnm_h169","cnm_202"]},"nodeIds":["cnm_245","cnm_h086","cnm_h087","cnm_137","cnm_h169","cnm_202"]}]},{"additionalConceptCount":8,"answerCheck":{"derivedAnswer":"C (108)","reason":"By central symmetry, take centroid G=(1,1), with circumradius R. At each triangle vertex, xy=1 gives R²=(x+y)²-2(x+y). Thus the three sums x+y take two quadratic-root values s,t, with one occurring twice, since a fixed sum allows at most two points on xy=1. Hence 2s+t=6 and s+t=2, giving s=4 and R²=8. The side squared is 3R²=24, so the area squared is 3·24²/16=108.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2017_AMC_10B_Q24","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"rotate-centroid-vectors","label":"Rotate centroid vectors by 120 degrees","methodDirectNodeIds":{"rotate-centroid-vectors":["cnm_245","cnm_277","cnm_h087","cnm_224","cnm_174","cnm_p148"]},"nodeIds":["cnm_245","cnm_277","cnm_h087","cnm_224","cnm_174","cnm_p148"]}]},{"additionalConceptCount":10,"answerCheck":{"derivedAnswer":"D, 5.0","reason":"The rotated-square lattice bound gives area at most 5 when there are only three interior lattice points. Equality is attained by the square 0≤2x+y≤5, 1≤-x+2y≤6, whose interior lattice points are (0,1), (0,2), and (1,2).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1998_AMC_12_Q29","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_082","cnm_174","cnm_191","math:unit-vectors"],"id":"universal-bound-and-construction","label":"Bound the side length and construct an example","methodDirectNodeIds":{"universal-bound-and-construction":["math:extremal-principle","math:lattice-counting","cnm_h086","cnm_h087","cnm_h088","cnm_h090","cnm_p089"]},"nodeIds":["math:extremal-principle","math:lattice-counting","cnm_h086","cnm_h087","cnm_h088","cnm_h090","cnm_p089","cnm_082","cnm_174","cnm_191","math:unit-vectors"]}]}],"layer":"ailleo","meaning":"Reviewed content-bound concept practice; no claim of complete source-standard coverage or learner mastery.","nextOffset":null,"nodeId":"cnm_h087","status":"mapped","total":34}
