{"alignments":[],"candidates":[{"additionalConceptCount":0,"answerCheck":{"derivedAnswer":"A. Vertex (1,2), axis x=1, translated 1 unit right and 2 units up.","reason":"In y=(x-h)²+k, h=1 and k=2. Thus the vertex is (1,2), the axis is x=1, and the shifts are right 1 and up 2.","status":"matches"},"assessed":true,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_231_q1","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"read-vertex-and-translations","label":"Read the vertex form","methodDirectNodeIds":{"read-vertex-and-translations":["cnm_231"]},"nodeIds":["cnm_231"]}]},{"additionalConceptCount":1,"answerCheck":{"derivedAnswer":"C: 2 values, a=0 and a=1","reason":"The vertex is (0,a²). Substitution into y=x+a gives a²=a, or a(a−1)=0. Thus precisely a=0 and a=1 work.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2005_AMC_12B_Q08","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_230","cnm_029","cnm_151"],"id":"vertex_incidence","label":"Substitute the vertex into the line","methodDirectNodeIds":{"vertex_incidence":["cnm_231","cnm_224"]},"nodeIds":["cnm_231","cnm_224","cnm_230","cnm_029","cnm_151"]}]},{"additionalConceptCount":1,"answerCheck":{"derivedAnswer":"-3, -5","reason":"x+3=x-(-3), so h=-3 and k=-5. The vertex is (-3,-5).","status":"matches"},"assessed":true,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_231_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_006"],"id":"identify-vertex-form-parameters","label":"Identify h and k","methodDirectNodeIds":{"identify-vertex-form-parameters":["cnm_231"]},"nodeIds":["cnm_231","cnm_006"]}]},{"additionalConceptCount":1,"answerCheck":{"derivedAnswer":"B. y=(x+2)²-3","reason":"Moving left 2 replaces x by x+2; moving down 3 subtracts 3. The result is y=(x+2)²-3.","status":"matches"},"assessed":true,"bank":"cn-math","coverag