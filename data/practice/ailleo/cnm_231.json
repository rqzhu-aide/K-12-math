eviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"use-vertex-form","label":"Vertex form","methodDirectNodeIds":{"use-vertex-form":["cnm_231","cnm_042","cnm_148"]},"nodeIds":["cnm_231","cnm_042","cnm_148"]},{"contextNodeIds":["cnm_029","cnm_042"],"id":"use-the-vertex-form","label":"Use the given vertex","methodDirectNodeIds":{"use-the-vertex-form":["cnm_233","cnm_231","cnm_148"]},"nodeIds":["cnm_233","cnm_231","cnm_148","cnm_029","cnm_042"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"E. c = 11","reason":"Substitution gives 2b+c=-1 and 4b+c=-13. Subtracting yields b=-6, and then c=11.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2006_AMC_10A_Q08","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_029","cnm_p145"],"id":"solution:use-parabola-symmetry:69fc5d2bc6de","label":"Method 2: Use symmetry","methodDirectNodeIds":{"use-parabola-symmetry":["cnm_233","cnm_231"]},"nodeIds":["cnm_233","cnm_231","cnm_029","cnm_p145"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"D: 752","reason":"Write f(x)=a(x-h)²+k and let d=|h-50|. The vertex condition gives k=-2ad², so the two root centers are 50±d and each root offset is √2d. The inner gap is 2(√2-1)d=150, while the outer gap is 2(√2+1)d=450+300√2. Hence m+n+p=450+300+2=752.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2009_AMC_12A_Q23","reviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"vertex-form-and-root-offsets","label":"Use vertex form","methodDirectNodeIds":{"vertex-form-and-root-offsets":["cnm_231","cnm_220","cnm_173"]},"nodeIds":["cnm_231","cnm_220","cnm_173"]},{"contextNodeIds":["cnm_196","cnm_173"],"id":"vertex-form-root-spacing","label":"Use vertex form and symmetric root spacing","methodDirectNodeIds":{"vertex-form-root-spacing":["cnm_231","cnm_234","cnm_220"]},"nodeIds":["cnm_231","cnm_234","cnm_220","cnm_196","cnm_173"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"A, -100","reason":"The quartic root sums give linear coefficients 38 for Q and 108 for P. Write Q=(x+19)^2+k. Its values at the first four roots are k+4 and k+16, whose sum must be -108, so k=-64. These are P's roots -60 and -48, giving P=(x+54)^2-36. The minima sum to -64-36=-100; these forms also produce the stated roots of Q(P(x)).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2010_AMC_12B_Q23","reviewStatus":"machine_scope_audited","routes":[{"id":"symmetric-preimages","label":"Use paired roots and vertex forms","nodeIds":["cnm_231","cnm_232"]},{"contextNodeIds":["cnm_032"],"id":"solution:symmetric-preimages:da8031b8c9dc","label":"Paired roots and symmetry","methodDirectNodeIds":{"symmetric-preimages":["cnm_231","math:polynomial-remainder-factor","cnm_233","cnm_235"]},"nodeIds":["cnm_231","math:polynomial-remainder-factor","cnm_233","cnm_235","cnm_032"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"3","reason":"For y=ax²+bx+c, the axis is x=-b/(2a). Here x=-(-6)/(2·1)=3.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_232_q2","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_148"],"id":"axis-formula-and-vertex-form","label":"Axis formula and vertex form","methodDirectNodeIds":{"axis-formula-and-vertex-form":["cnm_232","math:completing-square-expression","cnm_231"]},"nodeIds":["cnm_232","math:completing-square-expression","cnm_231","cnm_148"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"2, 5","reason":"The horizontal coordinate is -8/[2(-2)]=2. Substituting gives y=-2(2²)+8(2)-3=5, so the vertex is (2,5).","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_232_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_148"],"id":"vertex-by-completing-square","label":"Complete the square and read the vertex","methodDirectNodeIds":{"vertex-by-completing-square":["math:completing-square-expression","cnm_231"]},"nodeIds":["math:completing-square-expression","cnm_231","cnm_148"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B. x<-2","reason":"y=-x²-4x+1=-(x+2)²+5 has vertex at x=-2 and opens downward. Its left branch increases, giving choice B; the vertex endpoint may also be included in the increasing interval.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_232_q4","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_148"],"id":"increasing-branch","label":"Locate the increasing branch","methodDirectNodeIds":{"increasing-branch":["math:completing-square-expression","cnm_231","cnm_232"]},"nodeIds":["math:completing-square-expression","cnm_231","cnm_232","cnm_148"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B. A parabola","reason":"The vertex is xₜ=−t/(2a), yₜ=c−t²/(4a). Eliminating t gives yₜ=c−a xₜ². Because t ranges over all real numbers and a>0, xₜ does too, so the locus is the whole parabola.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1984_AMC_12_Q22","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_231","cnm_040"],"id":"complete-square-eliminate-parameter","label":"Complete the square and eliminate the parameter","methodDirectNodeIds":{"complete-square-eliminate-parameter":["cnm_232","cnm_229","math:completing-square-expression"]},"nodeIds":["cnm_232","cnm_229","math:completing-square-expression","cnm_231","cnm_040"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"A, only a","reason":"The vertex lies below the x-axis and there are two intercepts, so a>0. The axis gives b=-8a<0. Since 0 lies between the roots, c=f(0)<0.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1998_AMC_12_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_148","cnm_096"],"id":"vertex-form-and-negative-intercept","label":"Use vertex form and the negative intercept","methodDirectNodeIds":{"vertex-form-and-negative-intercept":["cnm_231","cnm_232","cnm_234"]},"nodeIds":["cnm_231","cnm_232","cnm_234","cnm_148","cnm_096"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"5","reason":"Since y=-(x-2)²+5≤5, with equality at x=2, the maximum is 5.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_235_q1","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_148","cnm_230"],"id":"solution:complete-square:435fa033ccca","label":"Complete the square and identify the maximum","methodDirectNodeIds":{"complete-square":["math:completing-square-expression","cnm_231","cnm_235"]},"nodeIds":["math:completing-square-expression","cnm_231","cnm_235","cnm_148","cnm_230"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"B, 15 inches","reason":"Take M as the origin, with x horizontal and y the arch height. Symmetry gives y=16+bx². Since y=0 at x=20, b=-16/400=-1/25. Therefore y(5)=16-25/25=15 inches.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1969_AMC_12_Q26","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_082","cnm_231","cnm_029"],"id":"vertex-form-model","label":"Use the vertex and half the span","methodDirectNodeIds":{"vertex-form-model":["cnm_236","cnm_233","cnm_196"]},"nodeIds":["cnm_236","cnm_233","cnm_196","cnm_082","cnm_231","cnm_029"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"D, filled upper parabolic cap","reason":"The coordinate edges map onto v=0,-1<=u<=1, and x=1,y=1 give u=1-v^2/4 and u=v^2/4-1. Necessity follows from (1-x^2)(1+y^2)>=0 and its swap. For sufficiency put R=sqrt(u^2+v^2), x=sqrt((R+u)/2), y=sqrt((R-u)/2). In the proposed cap v>=0 and v^2<=4(1-|u|), so R+|u|<=2; hence x,y are in [0,1] and map to (u,v). This proves the full filled image, not just its boundary, and matches actual choice D.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1969_AMC_12_Q31","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"algebraic-image-and-inverse","label":"Map the boundaries and prove sufficiency with nonnegative square roots","methodDirectNodeIds":{"algebraic-image-and-inverse":["cnm_029","cnm_148","cnm_147","cnm_220","cnm_231","cnm_096"]},"nodeIds":["cnm_029","cnm_148","cnm_147","cnm_220","cnm_231","cnm_096"]},{"contextNodeIds":["cnm_082","cnm_029","cnm_096","cnm_074","cnm_148","cnm_147"],"id":"boundary-and-algebraic-preimage","label":"Map the sides and verify the entire region","methodDirectNodeIds":{"boundary-and-algebraic-preimage":["math:quadratic-system-elimination","cnm_220","cnm_231"]},"nodeIds":["math:quadratic-system-elimination","cnm_220","cnm_231","cnm_082","cnm_029","cnm_096","cnm_074","cnm_148","cnm_147"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"D: b=+4sqrt(2) or -4sqrt(2), both irrational","reason":"Completing the square gives y=-(x-b/2)^2+b^2/4-8. Zero vertex height requires b^2=32, so b=+/-4sqrt(2).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1957_AMC_12_Q40","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["math:completing-square-expression","cnm_231","cnm_075","cnm_169"],"id":"solution:zero-vertex-height:7a67b01b644b","label":"Find the vertex by completing the square","methodDirectNodeIds":{"zero-vertex-height":["cnm_232","cnm_220","cnm_077"]},"nodeIds":["cnm_232","cnm_220","cnm_077","math:completing-square-expression","cnm_231","cnm_075","cnm_169"]}]}],"layer":"ailleo","meaning":"Review