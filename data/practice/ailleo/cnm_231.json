d","routes":[{"contextNodeIds":[],"id":"read-vertex-form","label":"Read the parabola's vertex","methodDirectNodeIds":{"read-vertex-form":["cnm_231"]},"nodeIds":["cnm_231"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C, tangent to the x-axis","reason":"The discriminant is b^2-4ac=0. Equivalently, f(x)=a(x+b/(2a))^2, whose vertex lies on the x-axis.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1951_AMC_12_Q16","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"vertex-on-axis","label":"Complete the square","methodDirectNodeIds":{"vertex-on-axis":["math:completing-square-expression","cnm_231"]},"nodeIds":["math:completing-square-expression","cnm_231"]},{"contextNodeIds":["cnm_148","cnm_230"],"id":"perfect-square-form","label":"Recognize a multiple of a square","methodDirectNodeIds":{"perfect-square-form":["cnm_153","cnm_231","cnm_234"]},"nodeIds":["cnm_153","cnm_231","cnm_234","cnm_148","cnm_230"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"E: x=-p/2","reason":"x²+px+q=(x+p/2)²+q-p²/4. The square is minimized at zero, so the minimum occurs at x=-p/2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1952_AMC_12_Q13","reviewStatus":"machine_adjudicated","routes":[{"id":"complete-square","label":"Complete the square","nodeIds":["math:completing-square-expression","cnm_231"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"E, minimum value -10","reason":"The function is 4(x-3/2)²-10. The squared term is nonnegative and vanishes at x=3/2, so the minimum is -10.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1955_AMC_12_Q24","reviewStatus":"machine_scope_audited","routes":[{"id":"complete-the-square","label":"Read the minimum from vertex form","nodeIds":["math:completing-square-expression","cnm_231"]}]},{"add