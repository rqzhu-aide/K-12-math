coverage":"canonical_concept_only","flags":[],"questionId":"2010_AMC_12B_Q06","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"transition-table","label":"Transition table","methodDirectNodeIds":{"transition-table":["cnm_h268","cnm_099"]},"nodeIds":["cnm_h268","cnm_099"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"A (7; N=16)","reason":"Bernardo's kth output is 2^k(N+50)-100. He wins exactly when this lies in [950,1000), so 1050 <= 2^k(N+50) < 1100. For N>=0, only k=1,2,3,4 can work; their smallest admissible integers are 475,213,82,16. At N=16, Bernardo produces 956 and Silvia next produces 1006. Thus the digit sum is 1+6=7.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2012_AMC_12B_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"shifted-geometric-recurrence","label":"Solve the forward recurrence","methodDirectNodeIds":{"shifted-geometric-recurrence":["cnm_h208","cnm_099"]},"nodeIds":["cnm_h208","cnm_099"]},{"contextNodeIds":[],"id":"backward-winning-intervals","label":"Take preimages of winning intervals","methodDirectNodeIds":{"backward-winning-intervals":["cnm_h200","cnm_099"]},"nodeIds":["cnm_h200","cnm_099"]},{"contextNodeIds":["cnm_097","cnm_h197"],"id":"backward-winning-ranges","label":"Method 1: Work backward from a winning turn","methodDirectNodeIds":{"backward-winning-ranges":["cnm_h200","cnm_h020","cnm_099"]},"nodeIds":["cnm_h200","cnm_h020","cnm_099","cnm_097","cnm_h197"]},{"contextNodeIds":["cnm_097","cnm_h197","cnm_h199","cnm_h207"],"id":"shift-to-doubling","label":"Method 2: Turn the output recurrence into repeated doubling","methodDirectNodeIds":{"shift-to-doubling":["cnm_h200","cnm_h208","cnm_h020","cnm_099"]},"nodeIds":["cnm_h200","cnm_h208","cnm_h020","cnm_099","cnm_097","cnm_h197","cnm_h199","cnm_h207"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C: $219.95","reason":"Coupon 1 beats coup