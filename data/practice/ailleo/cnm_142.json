eIds":{"pair-twos-and-fives":["math:prime-factorization","cnm_143","cnm_142"]},"nodeIds":["math:prime-factorization","cnm_143","cnm_142","cnm_074","cnm_p120"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, 2^4950","reason":"For k ≥ 1, a_(2^k) = 2^(k-1)a_(2^(k-1)). Starting with a_1 = 1 gives a_(2^100) = 2^(0+1+...+99) = 2^(100·99/2) = 2^4950.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2004_AMC_10A_Q24","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h197","cnm_019"],"id":"follow-power-of-two-indices","label":"Follow the powers-of-two indices","methodDirectNodeIds":{"follow-power-of-two-indices":["cnm_h200","cnm_142","cnm_h204"]},"nodeIds":["cnm_h200","cnm_142","cnm_h204","cnm_h197","cnm_019"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, 2^4950","reason":"Writing g_k = f(2^k) gives g_k = 2^(k−1)g_(k−1). Thus f(2^100) = 2^(0+1+...+99) = 2^4950.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2004_AMC_12A_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_019","cnm_h197"],"id":"unfold-recurrence","label":"Repeatedly halve the input","methodDirectNodeIds":{"unfold-recurrence":["cnm_h200","cnm_142","cnm_h204"]},"nodeIds":["cnm_h200","cnm_142","cnm_h204","cnm_019","cnm_h197"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C: 224","reason":"Choose exponents b and c independently from 0 through 14, giving 225 pairs. Each forces a = 28 - b - c. This lies between 0 and 27 except when b = c = 0, so the coefficient is 225 - 1 = 224.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2008_AMC_12A_Q19","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_146","cnm_142"],"id":"solution:count-exponent-pairs:81620d5bca88","label":"Choose exponents from the two shorter factors","methodDirectNodeIds":{"count-exponent-pairs":["math:generating-functions","cnm_h231","cnm_h010"]},"nodeIds":["math:generating-functions","cnm_h231","cnm_h010","cnm_146","cnm_142"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, 6","reason":"Modulo 1000, 2011^2011 ≡ (1+10)^2011 ≡ 1 + 10·2011 + 100·C(2011,2). Since C(2011,2) = 2021055, the residue is 611, whose hundreds digit is 6.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2011_AMC_10B_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["math:modular-congruence","cnm_142","cnm_143","cnm_p053"],"id":"solution:residue-power-cycle:c2b9e8adc736","label":"Find a repeating block of powers","methodDirectNodeIds":{"residue-power-cycle":["math:modular-powers"]},"nodeIds":["math:modular-powers","math:modular-congruence","cnm_142","cnm_143","cnm_p053"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C, 5/3","reason":"Since 2^2014 = 4 × 2^2012, the quotient becomes [2^2012(4 + 1)]/[2^2012(4 - 1)] = 5/3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2013_AMC_10A_Q08","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_142","cnm_p107"],"id":"common-power-factor","label":"Factor out the smaller power","methodDirectNodeIds":{"common-power-factor":["cnm_021","cnm_155","cnm_151"]},"nodeIds":["cnm_021","cnm_155","cnm_151","cnm_142","cnm_p107"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B: 279","reason":"The 867 gaps (5^n,5^(n+1)), for n=0 through 866, contain exactly the 2013 powers 2^1 through 2^2013. Each gap contains two or three such powers, and each three-power gap gives exactly one permitted pair. Thus the number is 2013-2·867=279; every resulting starting exponent lies within 1 through 2012.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2014_AMC_10A_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h042","cnm_142","cnm_164"],"id":"count-three-power-intervals","label":"Method 1: Count powers in each interval","methodDirectNodeIds":{"count-three-power-intervals":["math:lattice-counting","math:double-counting"]},"nodeIds":["math:lattice-counting","math:double-counting","cnm_h042","cnm_142","cnm_164"]},{"contextNodeIds":["cnm_h042","cnm_142","cnm_164"],"id":"solution:subtract-excluded-starts:ea6404c5e1b9","label":"Method 2: Count excluded starting exponents","methodDirectNodeIds":{"subtract-excluded-starts":["math:lattice-counting","cnm_h010"]},"nodeIds":["math:lattice-counting","cnm_h010","cnm_h042","cnm_142","cnm_164"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C, 2^16","reason":"Logarithm laws give e^p = ∏_{k=1}^6 k^k. Only 2^2, 4^4, and 6^6 contribute factors of 2, with exponents 2, 8, and 6 respectively. Their sum is 16.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2014_AMC_12B_Q15","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_142","cnm_143"],"id":"factor-exponential","label":"Convert logarithms into a product","methodDirectNodeIds":{"factor-exponential":["math:prime-factorization","cnm_h044","cnm_h048"]},"nodeIds":["math:prime-factorization","cnm_h044","cnm_h048","cnm_142","cnm_143"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"D, 587 × 10¹² miles","reason":"The annual distance is 5.87 × 10¹² miles. Multiplying by 10² gives 5.87 × 10¹⁴ = 587 × 10¹² miles.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1956_AMC_12_Q03","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_019","cnm_p120"],"id":"scale-with-powers-of-ten","label":"Multiply the yearly distance by 100","methodDirectNodeIds":{"scale-with-powers-of-ten":["cnm_p213","cnm_020","cnm_022","cnm_142"]},"nodeIds":["cnm_p213","cnm_020","cnm_022","cnm_142","cnm_019","cnm_p120"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"C, 6","reason":"The product simplifies to x⁶+2x⁵+x⁴+5x³+3x. Its leading coefficient is 1, so its degree is 6.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1983_AMC_12_Q06","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_031","cnm_142","cnm_163"],"id":"expand","label":"Clear the denominator powers and expand","methodDirectNodeIds":{"expand":["cnm_032","cnm_145","cnm_034"]},"nodeIds":["cnm_032","cnm_145","cnm_034","cnm_031","cnm_142","cnm_163"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"D, 2^1005","reason":"The expression is 2^1002(25^501-1)=2^1002·24·(1+25+...+25^500). The sum contains 501 odd terms and is odd, so exactly three additional factors of 2 occur. The greatest power is therefore 2^1005.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2014_AMC_10B_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_143","cnm_151","cnm_142","cnm_p156"],"id":"telescoping-and-parity","label":"Factor the remaining difference and check parity","methodDirectNodeIds":{"telescoping-and-parity":["math:prime-factorization","math:telescoping"]},"nodeIds":["math:prime-factorization","math:telescoping","cnm_143","cnm_151","cnm_142","cnm_p156"]},{"contextNodeIds":["cnm_143","cnm_151","cnm_142","cnm_p156","math:modular-congruence"],"id":"remainders-modulo-sixteen","label":"Find the remainder after division by 16","methodDirectNodeIds":{"remainders-modulo-sixteen":["math:prime-factorization","math:modular-powers"]},"nodeIds":["math:prime-factorization","math:modular-powers","cnm_143","cnm_151","cnm_142","cnm_p156","math:modular-congruence"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"C. ∛2","reason":"Let x=AC and let T be the perpendicular foot from D to BC. Since BD=DC=1, CT=BC/2. Similarity of CDT and CAF gives CT/CF=CD/CA=1/x, so BC=2/x. Hypotenuse-altitude similarity also gives AC²=CF·BC, hence BC=x². Therefore x³=2 and AC=∛2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1984_AMC_12_Q27","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_112","cnm_148","cnm_040","cnm_142"],"id":"solution:pythagorean-elimination:3533f4095ca5","label":"Eliminate shared side squares","methodDirectNodeIds":{"pythagorean-elimination":["cnm_174","cnm_055","cnm_076"]},"nodeIds":["cnm_174","cnm_055","cnm_076","cnm_112","cnm_148","cnm_040","cnm_142"]}]},{"additionalConceptCount":6,"answerCheck":{"derivedAnswer":"B, 16","reason":"The fraction is 2^20(2^10+1)/[2^12(1+2^10)]=2^8=256. Its principal square root is 16.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1993_AMC_12_Q06","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_142","cnm_074"],"id":"common_base_and_factors","label":"Rewrite in base 2 and factor","methodDirectNodeIds":{"common_base_and_factors":["cnm_143","cnm_151","cnm_163","cnm_075"]},"nodeIds":["cnm_143","cnm_151","cnm_163","cnm_075","cnm_142","cnm_074"]}]}],"layer":"ailleo","meaning":"Reviewed content-bound concept practice; no claim of complete source-standard coverage or learner mastery.","nextOffset":null,"nodeId":"cnm_142","status":"mapped","total":52}
