ng","cnm_h019","cnm_142","cnm_143"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"6a^3; 48 when a=2","reason":"2a*3a^2=6a^3. Substituting a=2 gives 6*2^3=48.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_144_q2","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_142","cnm_021"],"id":"multiply-and-evaluate","label":"Multiply, then substitute","methodDirectNodeIds":{"multiply-and-evaluate":["cnm_144","cnm_029"]},"nodeIds":["cnm_144","cnm_029","cnm_142","cnm_021"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D for x≠1: (x^10-x)/(x-1)+45a; for x=1: 9+45a","reason":"The nine terms sum to x+x²+···+x⁹+a(1+···+9). This gives choice D when x≠1, but at x=1 the original sum is 9+45a while D is undefined.","status":"ambiguous"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":["No restriction x≠1 is stated, although the keyed formula has denominator x-1. The key is correct with that restriction or with a removable-singularity extension."],"questionId":"1959_AMC_12_Q39","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_034","cnm_142","cnm_156"],"id":"separate-and-sum","label":"Separate the power terms and the multiples of a","methodDirectNodeIds":{"separate-and-sum":["cnm_h210","cnm_h204"]},"nodeIds":["cnm_h210","cnm_h204","cnm_034","cnm_142","cnm_156"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"E, 2k+1.","reason":"The terms sum to -na^(n-1)b+n(n-1)a^(n-2)b^2/2. Since ab!=0, cancellation gives a=(n-1)b/2. Substituting a=kb yields n=2k+1.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1969_AMC_12_Q16","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h240","cnm_040","cnm_142"],"id":"specified-binomial-terms","label":"Use the second and third binomial terms","methodDirectNodeIds":{"specified-binomial-terms":["c