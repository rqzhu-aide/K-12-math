ly","flags":[],"questionId":"1978_AMC_12_Q02","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_p188","cnm_016","cnm_040"],"id":"express-everything-using-radius","label":"Express the condition using the radius","methodDirectNodeIds":{"express-everything-using-radius":["cnm_p190","cnm_p192"]},"nodeIds":["cnm_p190","cnm_p192","cnm_p188","cnm_016","cnm_040"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"D, x²-y²","reason":"Since 1/x=y and 1/y=x, the expression becomes (x-y)(y+x)=x²-y².","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1978_AMC_12_Q03","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_016","cnm_156","cnm_040"],"id":"substitute-reciprocal-partners","label":"Replace the reciprocals","methodDirectNodeIds":{"substitute-reciprocal-partners":["cnm_162","cnm_147"]},"nodeIds":["cnm_162","cnm_147","cnm_016","cnm_156","cnm_040"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"A. x^((-2)^n)","reason":"Starting from exponent 1, one square-reciprocal pair sends x^e to x^(−2e). After n pairs the exponent is (−2)^n, valid for every nonzero x.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1984_AMC_12_Q11","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_016","cnm_019"],"id":"1984_AMC_12_Q11_m1","label":"Track the exponent","methodDirectNodeIds":{"1984_AMC_12_Q11_m1":["math:function-composition-iteration","cnm_143","cnm_164"]},"nodeIds":["math:function-composition-iteration","cnm_143","cnm_164","cnm_016","cnm_019"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"A: 15","reason":"For values above 1, invert by t → t - 1 and n → n/2. For values below 1, use t → 1/t - 1 and n → (n - 1)/2. Starting at 19/87 reaches 1 through 68/19, 49/19, 30/19, 11/19, 8/11, 3/8, 5/3, 2/3, and 1/2. Reconstructing indices gives n = 1905, whose digit sum is 15.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1987_AMC_12_Q29","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h197","cnm_016","cnm_p156","cnm_p173"],"id":"reverse-the-recurrence","label":"Recover the index by working backward","methodDirectNodeIds":{"reverse-the-recurrence":["cnm_h200"]},"nodeIds":["cnm_h200","cnm_h197","cnm_016","cnm_p156","cnm_p173"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"C, 51.005","reason":"Writing s=sqrt(x^2-1), (x+s)(x-s)=1 gives x+s=10 and x-s=1/10. Thus x=101/20. The requested expression equals 2x^2=10201/200=51.005.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1991_AMC_12_Q27","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"reciprocal-substitution","label":"Reciprocal substitution","methodDirectNodeIds":{"reciprocal-substitution":["cnm_147","cnm_016","cnm_040"]},"nodeIds":["cnm_147","cnm_016","cnm_040"]},{"contextNodeIds":["cnm_167","cnm_168","cnm_040"],"id":"use-reciprocal-pairs","label":"Use reciprocal pairs","methodDirectNodeIds":{"use-reciprocal-pairs":["math:radical-equations","cnm_173","cnm_147","cnm_016"]},"nodeIds":["math:radical-equations","cnm_173","cnm_147","cnm_016","cnm_167","cnm_168","cnm_040"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"E, 1/2","reason":"Since cos(x)!=0, (sec(x)-tan(x))*(sec(x)+tan(x))=(1-sin(x)^2)/cos(x)^2=1. Divide by the supplied difference 2. The attainable pair sec=5/4,tan=-3/4 confirms consistency.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1999_AMC_12_Q15","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_016","cnm_h060"],"id":"solution:conjugate-product:3e544e9120a8","label":"Multiply the sum and difference","methodDirectNodeIds":{"conjugate-product":["math:reciprocal-trig-identities","cnm_h062","c