se,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2024_AMC_12B_Q20","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"extended-median-area-bound","label":"Extend the median and maximize height","methodDirectNodeIds":{"extended-median-area-bound":["cnm_130","cnm_p148","cnm_174","cnm_187"]},"nodeIds":["cnm_130","cnm_p148","cnm_174","cnm_187"]},{"contextNodeIds":[],"id":"extend-the-median","label":"Double the median","methodDirectNodeIds":{"extend-the-median":["cnm_130","cnm_111","cnm_195","cnm_p148","cnm_174","cnm_187"]},"nodeIds":["cnm_130","cnm_111","cnm_195","cnm_p148","cnm_174","cnm_187"]}]},{"additionalConceptCount":7,"answerCheck":{"derivedAnswer":"A: AM=BM+CM","reason":"Write AB=BC=CA=s. Ptolemy's theorem for cyclic quadrilateral ABMC gives AM·BC=AB·MC+AC·BM, hence s·AM=s·CM+s·BM and AM=BM+CM.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1957_AMC_12_Q48","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_121","cnm_058","cnm_250"],"id":"auxiliary-equilateral-triangle","label":"Turn the sum into one straight segment","methodDirectNodeIds":{"auxiliary-equilateral-triangle":["cnm_130","cnm_123","cnm_255","cnm_139","cnm_055"]},"nodeIds":["cnm_130","cnm_123","cnm_255","cnm_139","cnm_055","cnm_121","cnm_058","cnm_250"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"D: 75°","reason":"Set B=(0,0), D=(1,0), and C=(3,0). Since ∠ABC=45°, write A=(t,t). The 60° direction of DA gives t=sqrt(3)(t-1), so t=(3+sqrt(3))/2. Therefore tan(∠ACB)=t/(3-t)=2+sqrt(3)=tan(75°). The angle is acute, hence it is 75°.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2001_AMC_12_Q24","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_055","cnm_058","cnm_062","cnm_121"],"id":"equilateral-and-isosceles-construction","label":"Create matching isosceles tria