","flags":[],"questionId":"1970_AMC_12_Q19","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_147","cnm_160","cnm_042"],"id":"geometric-sums","label":"Relate the two geometric sums","methodDirectNodeIds":{"geometric-sums":["math:infinite-geometric-series"]},"nodeIds":["math:infinite-geometric-series","cnm_147","cnm_160","cnm_042"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"D, (xy)^(-1)","reason":"Let u=2x and v=y/2. The expression is (1/u+1/v)/(u+v)=[(u+v)/(uv)]/(u+v)=1/(uv)=1/(xy).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1977_AMC_12_Q06","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_164","cnm_161","cnm_160"],"id":"combine_reciprocals","label":"Combine the reciprocals","methodDirectNodeIds":{"combine_reciprocals":["cnm_162"]},"nodeIds":["cnm_162","cnm_164","cnm_161","cnm_160"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"D (4/3)","reason":"The common differences are (y-x)/3 and (y-x)/4. Since x≠y, their quotient is 4/3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1978_AMC_12_Q08","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h201","cnm_156"],"id":"count-equal-gaps","label":"Count the equal gaps","methodDirectNodeIds":{"count-equal-gaps":["cnm_h202","cnm_160"]},"nodeIds":["cnm_h202","cnm_160","cnm_h201","cnm_156"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"E. ((ab)²+(ac)²+(bc)²)/(abc)","reason":"Since all products are nonzero, x²=ab/c, y²=ac/b, and z²=bc/a. Their sum over denominator abc has numerator (ab)²+(ac)²+(bc)².","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1983_AMC_12_Q13","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_143","cnm_160","cnm_161"],"id":"isolate-the-squares","label":"Isolate each square","methodDirec