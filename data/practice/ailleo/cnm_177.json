"]},"nodeIds":["cnm_177"]},{"contextNodeIds":["cnm_174","cnm_p148","cnm_075"],"id":"diagonal-two-right-triangles","label":"Split into two right triangles","methodDirectNodeIds":{"diagonal-two-right-triangles":["cnm_p150","cnm_177"]},"nodeIds":["cnm_p150","cnm_177","cnm_174","cnm_p148","cnm_075"]}]},{"additionalConceptCount":1,"answerCheck":{"derivedAnswer":"B, 24","reason":"Triangle BCD has BD=√(4²+3²)=5 and area 4×3/2=6. Since 5²+12²=13², triangle ABD has area 5×12/2=30. The quadrilateral's area is 30-6=24.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2017_AMC_8_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"recognize-outer-right-triangle","label":"Recognize the 5-12-13 triangle","methodDirectNodeIds":{"recognize-outer-right-triangle":["cnm_177"]},"nodeIds":["cnm_177"]},{"contextNodeIds":["cnm_075"],"id":"subtract-triangular-notch","label":"Subtract the triangular notch","methodDirectNodeIds":{"subtract-triangular-notch":["cnm_p150","cnm_174","cnm_177","cnm_p148"]},"nodeIds":["cnm_p150","cnm_174","cnm_177","cnm_p148","cnm_075"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"B. 12","reason":"Since 15^2+20^2=25^2, the area is 15*20/2=150. The shortest altitude is perpendicular to the side of length 25 and equals 2*150/25=12.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2002_AMC_10A_Q13","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"recognize-right-triangle","label":"Use the right-triangle area","methodDirectNodeIds":{"recognize-right-triangle":["cnm_177"]},"nodeIds":["cnm_177"]},{"contextNodeIds":["cnm_064"],"id":"right-triangle-area","label":"Use the fixed area","methodDirectNodeIds":{"right-triangle-area":["cnm_112","cnm_p148","cnm_177"]},"nodeIds":["cnm_112","cnm_p148","cnm_177","cnm_064"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"90°","reason":"The ships travel 32 and 24 nautical miles. Since 32²+24²=1024+576=1600=40², the angle at the departure port is 90°.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_178_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p111","cnm_177"],"id":"cnm_178_q3_m1","label":"Model the ships' positions as a triangle","methodDirectNodeIds":{"cnm_178_q3_m1":["cnm_178"]},"nodeIds":["cnm_178","cnm_p111","cnm_177"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B, 4 inches","reason":"10²+24²=26², so the area is 10·24/2=120 and the semiperimeter is 30. Hence r=120/30=4 inches.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1950_AMC_12_Q35","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"area-semiperimeter","label":"Use area and semiperimeter","methodDirectNodeIds":{"area-semiperimeter":["cnm_177","cnm_p148","math:triangle-area-radius-relations"]},"nodeIds":["cnm_177","cnm_p148","math:triangle-area-radius-relations"]},{"contextNodeIds":[],"id":"right-triangle-tangents","label":"Use equal tangent lengths","methodDirectNodeIds":{"right-triangle-tangents":["cnm_177","cnm_263","cnm_191"]},"nodeIds":["cnm_177","cnm_263","cnm_191"]},{"contextNodeIds":["cnm_262"],"id":"area-decomposition","label":"Method 1: Split the triangle into three areas","methodDirectNodeIds":{"area-decomposition":["cnm_264","cnm_177","cnm_p148","math:triangle-area-radius-relations"]},"nodeIds":["cnm_264","cnm_177","cnm_p148","math:triangle-area-radius-relations","cnm_262"]},{"contextNodeIds":["cnm_262"],"id":"tangent-segments","label":"Method 2: Use equal tangent lengths","methodDirectNodeIds":{"tangent-segments":["cnm_264","cnm_177","cnm_263","cnm_191"]},"nodeIds":["cnm_264","cnm_177","cnm_263","cnm_191","cnm_262"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"D, 3","reason":"Because