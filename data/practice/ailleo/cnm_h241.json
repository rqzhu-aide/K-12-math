ope_audited","routes":[{"contextNodeIds":["cnm_h240","cnm_h237"],"id":"binomial-terms","label":"Extract the last three terms","methodDirectNodeIds":{"binomial-terms":["cnm_h241"]},"nodeIds":["cnm_h241","cnm_h240","cnm_h237"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"C, 167 terms","reason":"The coefficient of x^k y^(1000-k) is C(1000,k)·2^(k/3)·3^((1000-k)/2). It is rational exactly when 3 divides k and 2 divides 1000-k, equivalently when 6 divides k. The indices 0,6,...,996 give 167 terms.","status":"matches"},"assessed":true,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2021_Fall_AMC_12A_Q12","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"binomial-prime-exponents","label":"Track the prime exponents","methodDirectNodeIds":{"binomial-prime-exponents":["cnm_h241","math:prime-factorization","cnm_h039"]},"nodeIds":["cnm_h241","math:prime-factorization","cnm_h039"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"3","reason":"The x^2 term is C(3,2)x^2 = 3x^2.","status":"matches"},"assessed":true,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h240_q1","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h240","cnm_h237"],"id":"identify-binomial-term","label":"Identify the binomial coefficient","methodDirectNodeIds":{"identify-binomial-term":["cnm_h241"]},"nodeIds":["cnm_h241","cnm_h240","cnm_h237"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"2","reason":"(a+b)^2 = a^2 + 2ab + b^2, so the coefficient of ab is 2.","status":"matches"},"assessed":true,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h240_q4","reviewStatus":"machine_scope_audited","routes":[]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"24","reason":"The x^2 term is C(4,2)(2x)^2 = 6 × 4x^2 = 24x^2.","status":"matches"},"assessed":true,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"