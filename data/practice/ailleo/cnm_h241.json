:"canonical_concept_only","flags":[],"questionId":"2021_AMC_10A_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"expand-forced-root-factors","label":"Expand the forced root factors","methodDirectNodeIds":{"expand-forced-root-factors":["cnm_h241","cnm_146"]},"nodeIds":["cnm_h241","cnm_146"]}]},{"additionalConceptCount":2,"answerCheck":{"derivedAnswer":"A, -29","reason":"After m transitions the row sum is 3·2^m. Since 12288=3·2^12, m=12. The second entry after j transitions is 3-j, so the third entry is 1+∑_{j=0}^{11}(3-j)=1+36-66=-29.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2025_AMC_10A_Q19","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"binomial-coefficients","label":"Expand the row polynomial","methodDirectNodeIds":{"binomial-coefficients":["cnm_h240","cnm_h241"]},"nodeIds":["cnm_h240","cnm_h241"]}]}],"layer":"ailleo","meaning":"Reviewed content-bound concept practice; no claim of complete source-standard coverage or learner mastery.","nextOffset":null,"nodeId":"cnm_h241","status":"mapped","total":15}
