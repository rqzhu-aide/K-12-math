"]},{"contextNodeIds":["cnm_148","cnm_168","cnm_169"],"id":"solution:recognize-radical-squares:a2791b98cfff","label":"Method 2: Recognize perfect squares","methodDirectNodeIds":{"recognize-radical-squares":["cnm_173","cnm_153","cnm_172"]},"nodeIds":["cnm_173","cnm_153","cnm_172","cnm_148","cnm_168","cnm_169"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B: 2","reason":"Rearranging and completing squares gives (x-5)²+(y+3)²=0. Both squares are nonnegative, so x=5 and y=-3, yielding x+y=2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2013_AMC_10B_Q11","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"discriminant-feasibility","label":"Require a real root in x","methodDirectNodeIds":{"discriminant-feasibility":["cnm_223","cnm_153","cnm_220"]},"nodeIds":["cnm_223","cnm_153","cnm_220"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"B (2)","reason":"Rearranging and completing squares gives (x-5)²+(y+3)²=0. Since both squares are nonnegative, x=5 and y=-3, so x+y=2. Alternatively, the discriminant when treating the equation as quadratic in x is -4(y+3)², which can be nonnegative only when y=-3.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2013_AMC_12B_Q06","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"discriminant-feasibility","label":"Require a real root in x","methodDirectNodeIds":{"discriminant-feasibility":["cnm_223","cnm_153","cnm_220"]},"nodeIds":["cnm_223","cnm_153","cnm_220"]}]},{"additionalConceptCount":3,"answerCheck":{"derivedAnswer":"C. 2","reason":"Substituting x=√π gives y²-2πy+π²=1, or (y-π)²=1. The distinct ordinates are π+1 and π-1, whose absolute difference is 2.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2015_AMC_10A_Q12","reviewStatus":"machine_scope_audited","routes":[