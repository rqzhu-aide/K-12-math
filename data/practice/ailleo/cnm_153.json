Ids":["cnm_173","cnm_153","cnm_148","cnm_168","cnm_172"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"B, 1 ordered pair: (1/2, 1)","reason":"Set x=2a and y=b. The equation becomes (1+x)(1+y)(x+y)=8xy. AM-GM bounds the factors below by 2√x, 2√y, and 2√(xy), respectively. Equality requires x=y=1, which works. Hence the unique pair is (a,b)=(1/2,1).","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2023_AMC_12A_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h018"],"id":"positive-squares","label":"Sum of nonnegative squares","methodDirectNodeIds":{"positive-squares":["cnm_162","cnm_153","math:nonnegative-sum-zero"]},"nodeIds":["cnm_162","cnm_153","cnm_h018","math:nonnegative-sum-zero"]}]},{"additionalConceptCount":4,"answerCheck":{"derivedAnswer":"4","reason":"x+4/x-4 = (x-2)^2/x ≥ 0 for x>0, with equality at x=2, so the minimum is 4.","status":"matches"},"assessed":false,"bank":"cn-math","coverage":"canonical_concept_only","flags":[],"questionId":"cnm_h022_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h018"],"id":"square-gap","label":"Express the gap as a square","methodDirectNodeIds":{"square-gap":["cnm_h019","cnm_161","cnm_153"]},"nodeIds":["cnm_h019","cnm_161","cnm_153","cnm_h018"]}]},{"additionalConceptCount":5,"answerCheck":{"derivedAnswer":"C, 45°","reason":"For legs a,b, a²+b²=2ab gives (a-b)²=0. Thus the acute angles are equal and sum to 90°, so each is 45°.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1959_AMC_12_Q15","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_110","cnm_148"],"id":"show-legs-equal","label":"Show that the legs are equal","methodDirectNodeIds":{"show-legs-equal":["cnm_174","cnm_153","cnm_137","cnm_116"]},"nodeIds":["cnm_174","cnm_153","cnm_137","cnm_116","cnm_110","cnm_148"]}]},{"additionalConceptCount":5,"answerChe