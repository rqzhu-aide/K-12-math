,"cnm_p210","cnm_075"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"C, 7/15","reason":"Set B=(0,0), A=(0,2), C=(2,0), D=(2,2). Then AF has equation y=2−2x, DE has equation y=1+x/2, and BD has equation y=x. Hence I=(2/5,6/5) and H=(2/3,2/3). The required area is [ABH]−[AEI]=2/3−1/5=7/15.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"1991_AMC_12_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p077","cnm_055","cnm_069","cnm_063","cnm_p210","cnm_p173"],"id":"similarity-and-area-ratios","label":"Use similarity to compare triangle areas","methodDirectNodeIds":{"similarity-and-area-ratios":["cnm_p150","cnm_271","cnm_272","cnm_p148"]},"nodeIds":["cnm_p150","cnm_271","cnm_272","cnm_p148","cnm_p077","cnm_055","cnm_069","cnm_063","cnm_p210","cnm_p173"]}]},{"additionalConceptCount":9,"answerCheck":{"derivedAnswer":"B: 4/5","reason":"Extend AB and CD to meet at X beyond A and D. In triangle BDX, the exterior angle BDC gives angle BXD = 46° - 23° = 23°, so XD = BD = 1. Since triangles XAD and XBC are similar, XD/XC = AD/BC = 5/9. Hence CD = XC - XD = 9/5 - 1 = 4/5.","status":"matches"},"assessed":false,"bank":"amc","coverage":"canonical_concept_only","flags":[],"questionId":"2009_AMC_12B_Q16","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_055","cnm_p210","cnm_066","cnm_067"],"id":"solution:extend-trapezoid-legs:a24dceab75cc","label":"Extend the legs to form similar triangles","methodDirectNodeIds":{"extend-trapezoid-legs":["cnm_069","cnm_117","cnm_138","cnm_268","cnm_271","cnm_272"]},"nodeIds":["cnm_069","cnm_117","cnm_138","cnm_268","cnm_271","cnm_272","cnm_055","cnm_p210","cnm_066","cnm_067"]},{"contextNodeIds":["cnm_055","cnm_p210","cnm_058","cnm_066","cnm_067"],"id":"construct-angle-bisector","label":"Create an angle bisector inside the trapezoid","methodDirectNodeIds":{"construct-angle-bisector":["cnm_184","cnm_183","cnm_069","cnm_268","