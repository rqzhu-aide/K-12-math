_079","cnm_040"],"id":"quadratic-formula-and-feasibility","label":"Find the possible positive heights","methodDirectNodeIds":{"quadratic-formula-and-feasibility":["math:quadratic-system-elimination","cnm_222","cnm_220"]},"nodeIds":["math:quadratic-system-elimination","cnm_222","cnm_220","cnm_219","cnm_074","cnm_079","cnm_040"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:c642af0b93792aea171aefe7"],"answerCheck":{"derivedAnswer":"C, 2 points","reason":"Four times the first equation minus the second gives 15y^2=0, so y=0. Then x^2=1, giving the two distinct common points (1,0) and (-1,0).","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["math:quadratic-system-elimination"],"coverage":"partial","flags":[],"questionId":"1966_AMC_12_Q17","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_040","cnm_074","cnm_082"],"id":"eliminate-the-squared-coordinate","label":"Eliminate the shared squared term","methodDirectNodeIds":{"eliminate-the-squared-coordinate":["math:quadratic-system-elimination","cnm_090","cnm_220"]},"nodeIds":["math:quadratic-system-elimination","cnm_090","cnm_220","cnm_040","cnm_074","cnm_082"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:c642af0b93792aea171aefe7"],"answerCheck":{"derivedAnswer":"B. a=3x or a=-2x","reason":"Since x=a-b≠0, cancellation gives a²+ab+b²=19x². Substituting b=a-x yields a²-ax-6x²=0, or (a-3x)(a+2x)=0.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["math:quadratic-system-elimination"],"coverage":"partial","flags":[],"questionId":"1975_AMC_12_Q12","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_040","cnm_148","cnm_145"],"id":"cube-factorization","label":"Factor the difference of cubes","methodDirectNodeIds":{"cube-factorization":["math:quadratic-system-elimination","math:sum-difference-cubes","cnm_224"]},"nodeIds":["math:quadratic-system-elimination","math:sum-difference-cubes","cnm_224","cnm_040","cnm_148","cnm_145"]},{"cont