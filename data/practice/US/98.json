195"],"id":"2011_AMC_8_Q13_m1","label":"Find the overlap width","methodDirectNodeIds":{"2011_AMC_8_Q13_m1":["cnm_p089","cnm_p197"]},"nodeIds":["cnm_p089","cnm_p197","cnm_p077","cnm_p088","cnm_p194","cnm_p195"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:b63eb07aae5525999a3eaa79"],"answerCheck":{"derivedAnswer":"D, 24 inches","reason":"Each fold halves the current footprint, so the original area is 4(9)=36 square inches. Its side is sqrt(36)=6 inches, and its perimeter is 4(6)=24 inches.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_p088"],"coverage":"partial","flags":[],"questionId":"1998_AMC_8_Q20","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p127","cnm_p077","cnm_p088"],"id":"unfold-area","label":"Recover the original area","methodDirectNodeIds":{"unfold-area":["cnm_132","cnm_p089","cnm_075","cnm_p078"]},"nodeIds":["cnm_132","cnm_p089","cnm_075","cnm_p078","cnm_p127","cnm_p077","cnm_p088"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:b63eb07aae5525999a3eaa79"],"answerCheck":{"derivedAnswer":"A: Art","reason":"The areas for Art, Roger, Paul, and Trisha are (3+5)·3/2=12, 4·2=8, 3·2=6, and 3·4/2=6 square inches. Art's cookies have the largest area, so his batch contains the fewest cookies.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_p088"],"coverage":"partial","flags":[],"questionId":"2003_AMC_8_Q08","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p088","cnm_p103"],"id":"m1","label":"Compare cookie areas","methodDirectNodeIds":{"m1":["cnm_p214","cnm_p149","cnm_p089","cnm_p147","cnm_p148"]},"nodeIds":["cnm_p214","cnm_p149","cnm_p089","cnm_p147","cnm_p148","cnm_p088","cnm_p103"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:b63eb07aae5525999a3eaa79"],"answerCheck":{"derivedAnswer":"E (10)","reason":"Take the square's side as 1. Its overlap area is 0.2, giving AD = 0.2. The rectangle's total area is 0.2/0.5 = 0.4, so A