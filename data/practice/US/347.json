:{"diagonals-and-irrationality":["cnm_191","cnm_262","cnm_174","cnm_173"]},"nodeIds":["cnm_191","cnm_262","cnm_174","cnm_173","cnm_077","cnm_260","cnm_075"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:1a48515e4f1f0510dde3014a"],"answerCheck":{"derivedAnswer":"E, 127; s = √(85 + 42√2)","reason":"Set C = (0,0), A = (s,0), B = (0,s), P = (x,y), and t = s². The distances give x² + y² = 36, 2sx = t - 85, and 2sy = t - 13, hence t² - 170t + 3697 = 0. Thus t = 85 ± 42√2; interiority gives x > 0 and t > 85, so a + b = 85 + 42 = 127.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_077"],"coverage":"partial","flags":[],"questionId":"2006_AMC_12B_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_082","cnm_148","cnm_171","cnm_077"],"id":"solution:coordinate-distances:9bdb663b9601","label":"Subtract coordinate distance equations","methodDirectNodeIds":{"coordinate-distances":["cnm_h173","cnm_174","cnm_221"]},"nodeIds":["cnm_h173","cnm_174","cnm_221","cnm_082","cnm_148","cnm_171","cnm_077"]},{"contextNodeIds":["cnm_245","cnm_115","cnm_148","cnm_171","cnm_077"],"id":"solution:quarter-turn-construction:9bdb663b9601","label":"Rotate to construct a right triangle","methodDirectNodeIds":{"quarter-turn-construction":["cnm_247","cnm_177","cnm_137","cnm_138","cnm_174"]},"nodeIds":["cnm_247","cnm_177","cnm_137","cnm_138","cnm_174","cnm_245","cnm_115","cnm_148","cnm_171","cnm_077"]}]},{"additionalConceptCount":8,"alignmentIds":["alignment:1a48515e4f1f0510dde3014a"],"answerCheck":{"derivedAnswer":"D: only the fourth number is rational","reason":"The first number is pi. Neither 4/5 is a rational cube nor 0.00016=1/6250 a rational fourth power, as their prime exponents show. The fourth number is -sqrt(100/9)=-10/3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_077"],"coverage":"partial","flags":[],"questionId":"1958_AMC_12_Q08","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":