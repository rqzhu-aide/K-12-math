ignmentIds":["alignment:99e0976bdb69967a73513953"],"answerCheck":{"derivedAnswer":"C. 20; a=sqrt(17)-3","reason":"The lower region has area 2(1+5/3)/2=8/3. Its portion left of x=a has area a(1+1+a/3)/2=a+a^2/6. Setting this to 4/3 gives (a+3)^2=17. The root in (0,2) is sqrt(17)-3, so s+t=20.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_p149"],"coverage":"aligned_concept_only","flags":[],"questionId":"2025_AMC_10B_Q06","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"trapezoid-area-equation","label":"Use trapezoid areas","methodDirectNodeIds":{"trapezoid-area-equation":["cnm_084","cnm_p149","cnm_228","cnm_221"]},"nodeIds":["cnm_084","cnm_p149","cnm_228","cnm_221"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:99e0976bdb69967a73513953"],"answerCheck":{"derivedAnswer":"B, -2/3","reason":"Convexity excludes a crossing of the x-axis inside the strip. Above the axis, area=3((m+4)+(4m+4))/2=12+15m/2, so m=-2/3. The entirely below-axis case requires m≤-4 and has area at least 18, not 7.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_p149"],"coverage":"aligned_concept_only","flags":[],"questionId":"1967_AMC_12_Q12","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_042","cnm_083"],"id":"convex-region-area","label":"Use convexity and parallel boundary lengths","methodDirectNodeIds":{"convex-region-area":["cnm_084","cnm_p149","cnm_097"]},"nodeIds":["cnm_084","cnm_p149","cnm_097","cnm_042","cnm_083"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:99e0976bdb69967a73513953"],"answerCheck":{"derivedAnswer":"C, 36.5.","reason":"From x=0 to 5 the triangle area is 5x5/2=12.5. From x=5 to 8 the heights are 5 and 11, giving trapezoid area 3(5+11)/2=24. Total area is 36.5.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_p149"],"coverage":"aligned_concept_only","flags":[],"questionId":"1969_AMC_12_Q22","reviewStatus":"machine_examined"