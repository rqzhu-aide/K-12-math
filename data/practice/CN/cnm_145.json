46","cnm_151","cnm_h012"]},"nodeIds":["cnm_146","cnm_151","cnm_h012","cnm_145","cnm_036","cnm_150"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:8c23434ff69ffbae14f2fd9c"],"answerCheck":{"derivedAnswer":"A: 140x-48x²+4x³ cubic inches","reason":"The height is x and the base dimensions are 10-2x and 14-2x. Thus V=x(10-2x)(14-2x)=140x-48x²+4x³, with 0<x<5 for a nondegenerate box.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_145"],"coverage":"aligned_concept_only","flags":[],"questionId":"1957_AMC_12_Q06","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_026","cnm_145","cnm_p162"],"id":"box-dimensions","label":"Find the folded dimensions","methodDirectNodeIds":{"box-dimensions":["cnm_027","cnm_p163","cnm_146"]},"nodeIds":["cnm_027","cnm_p163","cnm_146","cnm_026","cnm_145","cnm_p162"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:8c23434ff69ffbae14f2fd9c"],"answerCheck":{"derivedAnswer":"B, d and n","reason":"Using S_j=ja+j(j-1)d/2, S_(3n)-S_(2n)-S_n=2n²d. The first term a cancels, while d and n remain.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_145"],"coverage":"aligned_concept_only","flags":[],"questionId":"1960_AMC_12_Q36","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h201","cnm_034","cnm_035","cnm_145"],"id":"solution:arithmetic-sum-formula:b9798fa149ef","label":"Use the arithmetic sum formula","methodDirectNodeIds":{"arithmetic-sum-formula":["cnm_h204","cnm_036"]},"nodeIds":["cnm_h204","cnm_036","cnm_h201","cnm_034","cnm_035","cnm_145"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:8c23434ff69ffbae14f2fd9c"],"answerCheck":{"derivedAnswer":"A","reason":"Let k=(p-1)/2, a positive integer. Since p-1 is congruent to 1 modulo p-2, (p-1)^k-1 is divisible by p-2. Equivalently, it equals (p-2)(1+(p-1)+...+(p-1)^(k-1)).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_145"],"coverage":"aligned_concept_only","flags":[],"questionId":"1967_AMC_12_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p153","cnm_p156","cnm_019","cnm_145"],"id":"solution:finite-geometric-factorization:7f57eafed8b8","label":"Exhibit an integer factor","methodDirectNodeIds":{"finite-geometric-factorization":["cnm_155","cnm_h210"]},"nodeIds":["cnm_155","cnm_h210","cnm_p153","cnm_p156","cnm_019","cnm_145"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:8c23434ff69ffbae14f2fd9c"],"answerCheck":{"derivedAnswer":"B. a=3x or a=-2x","reason":"Since x=a-b≠0, cancellation gives a²+ab+b²=19x². Substituting b=a-x yields a²-ax-6x²=0, or (a-3x)(a+2x)=0.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_145"],"coverage":"aligned_concept_only","flags":[],"questionId":"1975_AMC_12_Q12","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_040","cnm_148","cnm_145"],"id":"cube-factorization","label":"Factor the difference of cubes","methodDirectNodeIds":{"cube-factorization":["math:quadratic-system-elimination","math:sum-difference-cubes","cnm_224"]},"nodeIds":["math:quadratic-system-elimination","math:sum-difference-cubes","cnm_224","cnm_040","cnm_148","cnm_145"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:8c23434ff69ffbae14f2fd9c"],"answerCheck":{"adjudication":"Root reviewed the displayed task, definedness and stated conventional interpretation.","derivedAnswer":"D; the first zero difference is order 4","reason":"Directly expand and subtract: Delta u=3n^2+3n+2; Delta^2 u=6n+6; Delta^3 u=6; Delta^4 u=0. The third is never zero. The operator is fully defined by the question, so this calculation does not need a general degree-drop theorem.","recordedAnswer":"D","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_145"],"coverage":"aligned_concept_only","flags":[],"questionId":"1976_AMC_12_Q25","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_h199","cnm_034","cnm_035","c