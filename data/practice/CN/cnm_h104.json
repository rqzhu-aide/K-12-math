4"],"coverage":"aligned_concept_only","flags":[],"questionId":"2023_AMC_12A_Q16","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"complex-modulus-bound","label":"Triangle inequality bound","methodDirectNodeIds":{"complex-modulus-bound":["cnm_h101","cnm_h104"]},"nodeIds":["cnm_h101","cnm_h104"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:6c65cfc74b93ea1ccbf3a1b3"],"answerCheck":{"derivedAnswer":"B, -2^49","reason":"The sum is Re((1+i)^99). Since (1+i)^4 = -4 and (1+i)^3 = -2+2i, its real part is Re((-4)^24(-2+2i)) = -2^49.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h104"],"coverage":"aligned_concept_only","flags":[],"questionId":"1989_AMC_12_Q29","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"complex-algebra","label":"Group complex powers algebraically","methodDirectNodeIds":{"complex-algebra":["cnm_h102","cnm_h104","cnm_143"]},"nodeIds":["cnm_h102","cnm_h104","cnm_143"]},{"contextNodeIds":["cnm_h237","cnm_h097","cnm_143"],"id":"real-part-binomial-expansion","label":"Read the sum from a complex binomial expansion","methodDirectNodeIds":{"real-part-binomial-expansion":["cnm_h240","cnm_h102","cnm_h104"]},"nodeIds":["cnm_h240","cnm_h102","cnm_h104","cnm_h237","cnm_h097","cnm_143"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:6c65cfc74b93ea1ccbf3a1b3"],"answerCheck":{"derivedAnswer":"E, 220/3^10","reason":"If k selections have modulus √2, then |P|=2^(3k/2-12), so |P|=1 requires k=8. This has probability C(12,8)(1/3)^8(2/3)^4. Conditional on this event, the four smaller factors make the product's argument uniform among the four multiples of π/2. Thus P(P=-1)=C(12,8)(1/3)^8(2/3)^4/4=220/3^10.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h104"],"coverage":"aligned_concept_only","flags":[],"questionId":"2017_AMC_12A_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"square-and-sign-symmetry","label":"