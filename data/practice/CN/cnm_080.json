cnm_174","cnm_115","cnm_055","cnm_112","cnm_080","cnm_040","cnm_146"]}]},{"additionalConceptCount":13,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"D, 1+√(3(r²−1))","reason":"For the labeled outer intersections, let h=√(r²−1), their distance from the respective midpoints of AC and AB. Those midpoints are 1 apart. Symmetry makes B'C' parallel to BC, and each outward offset contributes a projection (√3/2)h. Therefore B'C'=1+√3h=1+√(3(r²−1)).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":["For 1<r<2/√3, both intersections of a pair of circles lie outside the third circle, so the outside-circle wording alone is nonunique. The labeled outer intersections in the supplied figure are used.","labeled_outer_intersections_interpretation"],"questionId":"1979_AMC_12_Q28","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_139","cnm_055","cnm_250","cnm_080","cnm_096"],"id":"symmetric-coordinates-and-branch-check","label":"Compute the marked length and check the intersection choices","methodDirectNodeIds":{"symmetric-coordinates-and-branch-check":["cnm_176","cnm_133","cnm_174","cnm_259","cnm_082","cnm_084","cnm_132","cnm_140","cnm_h173"]},"nodeIds":["cnm_176","cnm_133","cnm_174","cnm_259","cnm_082","cnm_084","cnm_132","cnm_140","cnm_h173","cnm_139","cnm_055","cnm_250","cnm_080","cnm_096"]}]}],"canonicalNodeIds":["cnm_080"],"label":"实数的运算","layer":"CN","meaning":"Practice covers aligned canonical concepts, with no claim of complete standard coverage or mastery.","nextOffset":null,"sourceNode":{"criteria":["能进行含根号的混合运算","会按要求取近似值"],"description":"有理数的运算法则和运算律在实数范围内仍适用，会进行含根号的简单运算。","id":"cnm_080","label":"实数的运算","original":{"chapter":"七下 第八章 实数 8.3","description":"有理数的运算法则和运算律在实数范围内仍适用，会进行含根号的简单运算。","domain":"数与代数","external":false,"grade":7,"id":"cnm_080","mastery_criteria":["能进行含根号的混合运算","会按要求取近似值"],"name":"实数的运算","semester":"下","standards":[{"co