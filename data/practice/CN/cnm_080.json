ligned_concept_only","flags":[],"questionId":"1960_AMC_12_Q11","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_075","cnm_148","cnm_080"],"id":"product-and-completing-the-square","label":"Use the product, then complete the square","methodDirectNodeIds":{"product-and-completing-the-square":["cnm_226","cnm_221","cnm_220","cnm_077"]},"nodeIds":["cnm_226","cnm_221","cnm_220","cnm_077","cnm_075","cnm_148","cnm_080"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"D, 12√3","reason":"The overlap has base 12 and altitude 6 tan 30° = 2√3. Its area is (1/2)(12)(2√3) = 12√3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":["Partial overlap is interpreted as positive-area overlap, placing the triangles on the same side of their common hypotenuse with their acute-angle endpoints interchanged.","Interprets partial overlap as positive-area overlap that is not complete coincidence. Opposite-side placements would share only the hypotenuse and have zero common area.","No image is attached; the configuration is determined from the textual placement conditions."],"questionId":"1973_AMC_12_Q04","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_112","cnm_080"],"id":"1973_AMC_12_Q04_m1","label":"Find the triangular overlap","methodDirectNodeIds":{"1973_AMC_12_Q04_m1":["cnm_p148","cnm_138","cnm_137","cnm_140","cnm_174"]},"nodeIds":["cnm_p148","cnm_138","cnm_137","cnm_140","cnm_174","cnm_112","cnm_080"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"C, √2/2","reason":"Let M,N be the midpoints of AB,CD. The equilateral faces give CM=DM=√3/2 and AB perpendicular to plane CDM. Hence PQ≥MQ≥MN. Since MN is perpendicular to CD, MN²=CM²−CN²=3/4−1/4=1/2. Equality occurs at P=M and Q=N, so the minimum is √2/2.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1979_AMC_12_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_174","cnm_075","cnm_080"],"id":"spatial-coordinate-squares","label":"Make the fixed separation a coordinate","methodDirectNodeIds":{"spatial-coordinate-squares":["cnm_176","cnm_h151","cnm_h154","math:nonnegative-sum-zero"]},"nodeIds":["cnm_176","cnm_h151","cnm_h154","math:nonnegative-sum-zero","cnm_174","cnm_075","cnm_080"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"B, √3/3","reason":"In right triangle PQC, tan 60°=QC/PQ=√3. Since QC=AQ, PQ/AQ=1/√3=√3/3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1980_AMC_12_Q05","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p188","cnm_p103","cnm_116","cnm_080","cnm_171"],"id":"1980_AMC_12_Q05_m1","label":"Special right triangle","methodDirectNodeIds":{"1980_AMC_12_Q05_m1":["cnm_140","cnm_174"]},"nodeIds":["cnm_140","cnm_174","cnm_p188","cnm_p103","cnm_116","cnm_080","cnm_171"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"E. AD/AB = 1/√[4]{12}","reason":"Set AB = 1 and AD = r. The heights of C and E above AB are 1/(1 + √3) and √3r/(1 + √3). Hence [ADE]/[ABC] = √3r² = 1/2, so r = 1/√[4]{12}. Also √3r < 1, confirming that E lies on AC.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1987_AMC_12_Q30","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_276","cnm_112","cnm_080"],"id":"solution:right-triangle-heights:4c5bfaaa281a","label":"Compare bases and heights","methodDirectNodeIds":{"right-triangle-heights":["cnm_p148","cnm_278","cnm_277","cnm_220"]},"nodeIds":["cnm_p148","cnm_278","cnm_277","cnm_220","cnm_276","cnm_112","cnm_080"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"D (√6/4)","reason":"Scale HF to 1. The 60° face angle gives FB = √3, and the 45° face angle gives GH = GD = √3. Pythagoras then yields HB = 2, HD = √6, and BD = 2. Thus cos∠BHD = (HB² + HD² - BD²)/(2·HB·HD) = 6/(4√6) = √6/4.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1982_AMC_12_Q18","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_p160","cnm_277","cnm_080","cnm_055"],"id":"face-triangles-and-isosceles-altitude","label":"Face diagonals and an isosceles triangle","methodDirectNodeIds":{"face-triangles-and-isosceles-altitude":["cnm_278","cnm_174","cnm_137","cnm_276"]},"nodeIds":["cnm_278","cnm_174","cnm_137","cnm_276","cnm_p160","cnm_277","cnm_080","cnm_055"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"E: s√6/2","reason":"Let G be the intersection of the medians. Then BG=(2/3)BN. Right triangles BGC and BCN are similar, since they share the angle at B, so BC²=BG·BN=(2/3)BN². With BC=s, this gives BN=s√6/2.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1982_AMC_12_Q21","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_113","cnm_055","cnm_064","cnm_268","cnm_080"],"id":"centroid-and-right-triangle-similarity","label":"Centroid ratio and similar right triangles","methodDirectNodeIds":{"centroid-and-right-triangle-similarity":["math:centroid-ratios","cnm_271","cnm_272"]},"nodeIds":["math:centroid-ratios","cnm_271","cnm_272","cnm_113","cnm_055","cnm_064","cnm_268","cnm_080"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"E: h","reason":"The projections give w=a(cos75°+cos45°) and h=a sin75°. Expanding sin(75°-45°)=sin30° gives sin75°-cos75°=cos45°. Therefore w=a sin75°=h.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1982_AMC_12_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_277","cnm_080","cnm_055","cnm_064"],"id":"solution:horizontal-projections:d463481ae982","label":"Add the horizontal projections","methodDirectNodeIds":{"horizontal-projections":["cnm_278","cnm_276","cnm_h070"]},"nodeIds":["cnm_278","cnm_276","cnm_h070","cnm_277","cnm_080","cnm_055","cnm_064"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"D: √3","reason":"ABEF and BCDE are parallelograms because each has a pair of equal parallel opposite sides. Their adjacent sides all have length 1, and each has an included angle of 60°. Each area is 1·sin60°=√3/2, so the total area is √3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1983_AMC_12_Q04","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_139","cnm_137","cnm_183","cnm_080"],"id":"split-parallelograms","label":"Split the figure into two parallelograms","methodDirectNodeIds":{"split-parallelograms":["cnm_p150","cnm_184","cnm_p147","cnm_174"]},"nodeIds":["cnm_p150","cnm_184","cnm_p147","cnm_174","cnm_139","cnm_137","cnm_183","cnm_080"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"E, infinitely many such triangles","reason":"Normalize the angle vertex to O=(0,0) and P=(1,0). For every 0<t<1/2, take Q=(t,√3t) and R=(1/2−t,−√3(1/2−t)). These points lie on opposite rays, and PQ²=PR²=QR²=4t²−2t+1. Different t give distinct triangles.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"1993_AMC_12_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_058","cnm_082","cnm_140","cnm_174","cnm_080"],"id":"coordinate-family","label":"Construct a family with equal distances","methodDirectNodeIds":{"coordinate-family":["cnm_h173","cnm_139","math:infinitude-by-construction"]},"nodeIds":["cnm_h173","cnm_139","math:infinitude-by-construction","cnm_058","cnm_082","cnm_140","cnm_174","cnm_080"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"D, (50 - 25sqrt(3))/2","reason":"The equal legs have length 5, so the altitude from C to AB is h=5/sqrt(2). Symmetry places the two trisectors 15 degrees on either side of this altitude, giving DE=2h*tan(15 degrees). Hence the area is h^2*tan(15 degrees)=(25/2)(2-sqrt(3))=(50-25sqrt(3))/2.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"2015_AMC_10A_Q19","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_137","cnm_115","cnm_174","cnm_080"],"id":"special-triangles-and-subtraction","label":"Find and subtract the outer triangles","methodDirectNodeIds":{"special-triangles-and-subtraction":["cnm_p148","cnm_p150","cnm_140","cnm_132"]},"nodeIds":["cnm_p148","cnm_p150","cnm_140","cnm_132","cnm_137","cnm_115","cnm_174","cnm_080"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"C, 12","reason":"Each hexagon angle is 120°, so ∠KBC=360°-120°-90°-60°=90°. Also BK=BJ=√18 and BC=FE=√32. Thus the area is (√18)(√32)/2=12.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"2015_AMC_8_Q21","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p077","cnm_p089","cnm_074","cnm_080"],"id":"angle-chase-and-area","label":"Find a perpendicular base and height","methodDirectNodeIds":{"angle-chase-and-area":["cnm_058","cnm_181","cnm_139","cnm_p148"]},"nodeIds":["cnm_058","cnm_181","cnm_139","cnm_p148","cnm_p077","cnm_p089","cnm_074","cnm_080"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"C, 15 square inches","reason":"Quarter-turn symmetry permits centering a maximal fitting square. Let a,b be the horizontal and vertical projections of one side, with L=a+b. The corner exclusions give a²+b²≤3L, and the outer boundary gives L≤5. Equality is feasible with a+b=5 and ab=5, producing area a²+b²=25-10=15.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"2015_AMC_8_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p077","cnm_p089","cnm_p171","cnm_074","cnm_080"],"id":"nested-square-area-bound","label":"Bound the area using an inscribed square","methodDirectNodeIds":{"nested-square-area-bound":["cnm_267","cnm_p150","cnm_p148"]},"nodeIds":["cnm_267","cnm_p150","cnm_p148","cnm_p077","cnm_p089","cnm_p171","cnm_074","cnm_080"]}]},{"additionalConceptCount":8,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"A: x <= y","reason":"For positive speeds, y-x=(u-v)^2/[2(u+v)]>=0. Equality occurs when u=v, so strict inequality is not universal.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":["Travel speeds u and v are understood to be positive.","The travel speeds u and v are understood to be positive."],"questionId":"1973_AMC_12_Q27","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_p110","cnm_156","cnm_096","cnm_080"],"id":"derive-and-subtract-average-speeds","label":"Find each average speed and compare","methodDirectNodeIds":{"derive-and-subtract-average-sp