","cnm_075","cnm_080"],"id":"extend-sides-and-subtract","label":"Complete equilateral triangles and subtract","methodDirectNodeIds":{"extend-sides-and-subtract":["cnm_p150","cnm_115","cnm_139","cnm_137","cnm_174","cnm_p148"]},"nodeIds":["cnm_p150","cnm_115","cnm_139","cnm_137","cnm_174","cnm_p148","cnm_059","cnm_075","cnm_080"]}]},{"additionalConceptCount":8,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"A: π/3 + 1 − √3","reason":"With O=(0,0), A=(1,0) and C=(0,1), the circle intersections are D=(1,√3) and E=(√3,1). Their polar angles are 60° and 30°, so sector DOE has area π/3. Triangles OBD and OBE have combined area √3−1, leaving π/3+1−√3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"2006_AMC_10B_Q19","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_191","cnm_250","cnm_080"],"id":"sector-minus-triangles","label":"Subtract triangles from a sector","methodDirectNodeIds":{"sector-minus-triangles":["cnm_257","cnm_p150","cnm_174","cnm_p148","cnm_132","cnm_139"]},"nodeIds":["cnm_257","cnm_p150","cnm_174","cnm_p148","cnm_132","cnm_139","cnm_191","cnm_250","cnm_080"]}]},{"additionalConceptCount":8,"alignmentIds":["alignment:cb32cdd00faac16e9319b6cd"],"answerCheck":{"derivedAnswer":"A: 29√3","reason":"Set A=(0,0), B=(40,0), X=(p,q), Z=(-q,p), and f=AF. The side-line constraints give p-q/√3=40, q+p/√3=f, and p+q=√3(f+EF)/2. These imply f+40=(√3+1)EF=82, so f=42. Squaring the first two relations gives (4/3)(p²+q²)=40²+42². Thus the square's side squared is 2523, giving 29√3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_080"],"coverage":"aligned_concept_only","flags":[],"questionId":"2012_AMC_12B_Q21","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_181","cnm_140","cnm_174","cnm_082","cnm_080"],"id":"fixed-side-directions","label":"Use the fixed side directions","met