["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"C (8)","reason":"Write B = (-t,t^2) and C = (t,t^2), with t > 0. Then 64 = (1/2)(2t)(t^2) = t^3, so t = 4 and BC = 8.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"2016_AMC_12B_Q06","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_082","cnm_p148","cnm_076"],"id":"symmetric-coordinates","label":"Use symmetry and the triangle's area","methodDirectNodeIds":{"symmetric-coordinates":["cnm_084","cnm_230"]},"nodeIds":["cnm_084","cnm_230","cnm_082","cnm_p148","cnm_076"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"D (5)","reason":"For first terms x and y, the sixth term is x^3y^5 = 4000 = 2^5·5^3. Comparing prime exponents forces x = 5 and y = 2, so the first term is 5.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"2023_AMC_8_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"bounded-power-search","label":"Bound and test the second term","methodDirectNodeIds":{"bounded-power-search":["cnm_020","cnm_p153","cnm_076"]},"nodeIds":["cnm_020","cnm_p153","cnm_076"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"7","reason":"(-√3)²=3, |-2|=2, and ∛(-8)=-2, so 3+2-(-2)=7.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_080_q3","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_012"],"id":"cnm_080_q3_m1","label":"Evaluate each term and track the signs","methodDirectNodeIds":{"cnm_080_q3_m1":["cnm_080","cnm_020","cnm_008","cnm_076"]},"nodeIds":["cnm_080","cnm_020","cnm_008","cnm_076","cnm_012"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"E: 1","reason":"Let the two cube roots be u and v. Then uv=-3 and u³+v³=10. For t=u+v, t³+9t-10=0, or (t-1)(t²+t+10)=0. The quadratic has negative discriminant, so t=1, which is not listed.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"1980_AMC_12_Q27","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_076","cnm_147"],"id":"equation-for-sum","label":"Find an equation for the sum","methodDirectNodeIds":{"equation-for-sum":["cnm_080","math:sum-difference-cubes","cnm_146","math:completing-square-expression"]},"nodeIds":["cnm_080","math:sum-difference-cubes","cnm_146","math:completing-square-expression","cnm_076","cnm_147"]},{"contextNodeIds":["cnm_076","cnm_148","cnm_168"],"id":"recognize-real-cubes","label":"Recognize cubes of square-root expressions","methodDirectNodeIds":{"recognize-real-cubes":["cnm_080","cnm_173","cnm_146"]},"nodeIds":["cnm_080","cnm_173","cnm_146","cnm_076","cnm_148","cnm_168"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"C, n = 4","reason":"With c = ³√3, iteration gives xₙ = 3^(c^(n-4)), so x₄ = 3. Since 1 < c < 3/2, x₁ and x₂ lie between 1 and 2, with x₂ < (3/2)^(3/2) < 2. Also 2 < 3^(2/3) < x₃ = 3^(1/c) < 3. Thus no earlier term is an integer.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"1985_AMC_12_Q27","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h197","cnm_h039","cnm_076"],"id":"iterate-and-bound-earlier-terms","label":"Combine powers and bound the earlier terms","methodDirectNodeIds":{"iterate-and-bound-earlier-terms":["cnm_h200","math:real-exponent-laws","cnm_h042"]},"nodeIds":["cnm_h200","math:real-exponent-laws","cnm_h042","cnm_h197","cnm_h039","cnm_076"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"D, 4","reason":"The roots have modulus 2 and arguments 30,90,150,210,270,330 degrees. Only square root of 3 plus i and square root of 3 minus i have positive real part; their product is 3 + 1 = 4.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"1990_AMC_12_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h097","cnm_146","cnm_076"],"id":"real-part-of-cube","label":"Use the real part of the cube","methodDirectNodeIds":{"real-part-of-cube":["math:roots-of-unity","cnm_h099","cnm_h102"]},"nodeIds":["math:roots-of-unity","cnm_h099","cnm_h102","cnm_h097","cnm_146","cnm_076"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"D. 2-√2","reason":"√9=3, ∛(-8)=-2, and |1-√2|=√2-1, so the result is 3-2-(√2-1)=2-√2.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_080_q1","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_035"],"id":"cnm_080_q1_m1","label":"Evaluate the roots and absolute value","methodDirectNodeIds":{"cnm_080_q1_m1":["cnm_080","cnm_075","cnm_076","cnm_079","cnm_008"]},"nodeIds":["cnm_080","cnm_075","cnm_076","cnm_079","cnm_008","cnm_035"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:10a03d3015c4f96d19d5655e"],"answerCheck":{"derivedAnswer":"A, 10^4 dollars","reason":"Setting 800=8·10^8·x^(-3/2) gives x^(3/2)=10^6, hence x=(10^6)^(2/3)=10^4. The model places 800 incomes above this threshold.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_076"],"coverage":"aligned_concept_only","flags":[],"questionId":"1960_AMC_12_Q17","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_029","cnm_07