76"],"answerCheck":{"derivedAnswer":"8/27","reason":"P(X=0)=C(3,0)(1/3)^0(2/3)^3=8/27.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_h255_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h139","cnm_h254"],"id":"cnm_h255_q2_m1","label":"All trials fail","methodDirectNodeIds":{"cnm_h255_q2_m1":["cnm_h255","cnm_h141"]},"nodeIds":["cnm_h255","cnm_h141","cnm_h139","cnm_h254"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:3ff2233aa42f004da39aa176"],"answerCheck":{"derivedAnswer":"A: 13/729","reason":"The probability is C(6,5)(1/3)^5(2/3)+(1/3)^6=12/729+1/729=13/729.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":[],"questionId":"1974_AMC_12_Q24","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h254","cnm_h141","cnm_285"],"id":"split-five-and-six-successes","label":"Separate exactly five and exactly six","methodDirectNodeIds":{"split-five-and-six-successes":["cnm_h255","cnm_h138"]},"nodeIds":["cnm_h255","cnm_h138","cnm_h254","cnm_h141","cnm_285"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:3ff2233aa42f004da39aa176"],"answerCheck":{"derivedAnswer":"D: 56","reason":"A coin remains tails with probability (1/2)^3 = 1/8, so it finishes heads with probability 7/8. The expected head count is 64*(7/8) = 56.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":[],"questionId":"2015_AMC_10B_Q18","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h140","cnm_212"],"id":"single-coin-average","label":"Track one coin and add its average contribution","methodDirectNodeIds":{"single-coin-average":["cnm_h252","cnm_h141","cnm_h251"]},"nodeIds":["cnm_h252","cnm_h141","cnm_h251","cnm_h140","cnm_212"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:3ff2233aa42f004da39aa176"],"answerCheck":{"derivedAnswer":"D: 4","reason":"Both players get tails in a round with probability (2/3)(3/5)=2/5. Amelia's winning probability is (1/3)Σₖ₌₀∞(2/5)ᵏ = (1/3)/(1-2/5)=5/9. The series converges since 2/5<1, and q-p=9-5=4.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":[],"questionId":"2017_AMC_10A_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"sum-winning-rounds","label":"Sum a geometric series","methodDirectNodeIds":{"sum-winning-rounds":["cnm_h141","cnm_h138","math:infinite-geometric-series"]},"nodeIds":["cnm_h141","cnm_h138","math:infinite-geometric-series"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:3ff2233aa42f004da39aa176"],"answerCheck":{"derivedAnswer":"C, 59/64","reason":"The failure probability is (1/2)^6 + 6(1/3)(1/2)^5 = 5/64. Thus the required probability is 1 - 5/64 = 59/64.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":[],"questionId":"2021_Fall_AMC_10B_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"count-missing-factors-of-two","label":"Count the failures","methodDirectNodeIds":{"count-missing-factors-of-two":["math:prime-factorization","cnm_h139","cnm_h137","cnm_h141","cnm_h138"]},"nodeIds":["math:prime-factorization","cnm_h139","cnm_h137","cnm_h141","cnm_h138"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:3ff2233aa42f004da39aa176"],"answerCheck":{"derivedAnswer":"E, 14; p = (4 - √10)/2","reason":"The winning paths WW, WLW and LWW have total probability (2/3)p + (2/3)(1-p)p + (1/3)p² = (4p-p²)/3. Setting this equal to 1/2 gives 2p²-8p+3=0. Only p=(4-√10)/2 lies in [0,1], so m+n=4+10=14.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":[],"questionId":"2024_AMC_10A_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"first-game-conditioning","label":"Condition first, then complete square","methodDirectNodeIds":{"first-game-conditioning":["cnm_h246","cnm_h141","cnm_221"]},"nodeIds":["cnm_h246","cnm_h141","cnm_221"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:3ff2233aa42f004da39aa176"],"answerCheck":{"derivedAnswer":"A: 11 to 5","reason":"Extend play to four independent fair games. A wins the series exactly when it wins at least two of them, giving probability (6+4+1)/16 = 11/16. The odds are therefore 11:5.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":["Uses the conventional interpretation that successive games are independent and each team has win probability 1/2.","Uses the conventional interpretation that successive games are independent, with each team having win probability 1/2."],"questionId":"1971_AMC_12_Q23","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_h140","cnm_p185"],"id":"count-stopping-sequences","label":"Count the possible stopping sequences","methodDirectNodeIds":{"count-stopping-sequences":["cnm_289","cnm_h141","cnm_h138","cnm_h139"]},"nodeIds":["cnm_289","cnm_h141","cnm_h138","cnm_h139","cnm_h140","cnm_p185"]}]},{"additionalConceptCount":8,"alignmentIds":["alignment:3ff2233aa42f004da39aa176"],"answerCheck":{"derivedAnswer":"D, (3-sqrt(3))/6","reason":"Writing p for the head probability gives 6p^2(1-p)^2=1/6. Since 0<p<1/2, this implies p(1-p)=1/6. The quadratic roots are (3+sqrt(3))/6 and (3-sqrt(3))/6; only the latter is below 1/2.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h141"],"coverage":"aligned_concept_only","flags":[],"questionId":"2010_AMC_12A_Q15","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h254","cnm_h237","cnm_h141","cnm_h138","cnm_148","cnm_220","cnm_171"],"id":"solution:complete-the-square:e79543203415","label":"Count