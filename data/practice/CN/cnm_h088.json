88","cnm_h090","cnm_188"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C, 51","reason":"The acute conditions are 4<x+y<14 and (x-4.5)^2+(y-4.5)^2>12.5. The first-quadrant band has area (14²-4²)/2=90. The diameter-AB disk lies entirely in that band and the first quadrant, so the area is 90-12.5π≈50.73, whose closest integer is 51.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2005_AMC_12B_Q18","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"positive-dot-products","label":"Express acuteness with dot products","methodDirectNodeIds":{"positive-dot-products":["cnm_h086","cnm_h088","cnm_h176"]},"nodeIds":["cnm_h086","cnm_h088","cnm_h176"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"B, 1/3","reason":"The squared sums give 5/3+1=2+2(sin a sin b+cos a cos b)=2+2cos(a-b). Therefore cos(a-b)=1/3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2007_AMC_12A_Q17","reviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"unit-vector-dot-product","label":"Use unit-vector dot products","methodDirectNodeIds":{"unit-vector-dot-product":["cnm_h060","cnm_h088","cnm_h089"]},"nodeIds":["cnm_h060","cnm_h088","cnm_h089"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"D: sqrt(3)/(4sqrt(2)-3)","reason":"For t=CA>0, cosine-law and area relationships give tan(BAD)=sqrt(3)/(t+8/t-3). Since t+8/t>=4sqrt(2), with equality at t=2sqrt(2), the largest value is sqrt(3)/(4sqrt(2)-3).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2008_AMC_12A_Q24","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"special-cosine-dot-product-amgm","label":"Special 60-degree side calculation, dot product, and AM-GM","methodDirectNodeIds":{"special-cosine-dot-product-amgm":["cnm_h091","cnm_h088","cnm_p148","cnm_h022"]},"nodeIds":["cnm_h091","cnm_h088","cnm_p148","cnm_h022"]},{"contextNodeIds":[],"id":"coordinate-dot-product-square-bound","label":"Coordinates, dot product, and a nonnegative square","methodDirectNodeIds":{"coordinate-dot-product-square-bound":["cnm_h173","cnm_h088","cnm_p148","math:completing-square-expression","cnm_096"]},"nodeIds":["cnm_h173","cnm_h088","cnm_p148","math:completing-square-expression","cnm_096"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C: 18","reason":"Write A=(-t,t^2), B=(t,t^2), and C=(u,u^2), with t>0. The right angle must be at C, since a vertical side at A or B would repeat that point on the graph. The two secant slopes are u-t and u+t, so u^2-t^2=-1. The altitude is therefore 1, and the area is t=2008. Thus y_C=2008^2-1=4032063, whose digits sum to 18.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2008_AMC_12B_Q17","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"perpendicular-coordinate-vectors","label":"Use a zero dot product","methodDirectNodeIds":{"perpendicular-coordinate-vectors":["cnm_h086","cnm_h088","cnm_h090"]},"nodeIds":["cnm_h086","cnm_h088","cnm_h090"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C (3/2)","reason":"Write the slopes as m and 6m, and put u=|m|>0. The angle condition gives 5u/(1+6u²)=1, so (3u−1)(2u−1)=0. The attainable products 6u² are 2/3 and 3/2; the greater is 3/2.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2020_AMC_12B_Q07","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"direction-vector-angle","label":"Angle between direction vectors","methodDirectNodeIds":{"direction-vector-angle":["cnm_h088","cnm_h090","cnm_277","cnm_224"]},"nodeIds":["cnm_h088","cnm_h090","cnm_277","cnm_224"]},{"contextNodeIds":[],"id":"direction-vector-dot-product","label":"Use direction vectors","methodDirectNodeIds":{"direction-vector-dot-product":["cnm_h167","cnm_h088","cnm_h090","cnm_277","cnm_224"]},"nodeIds":["cnm_h167","cnm_h088","cnm_h090","cnm_277","cnm_224"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"D, 117","reason":"Triangles ABP and BCQ are congruent, so CQ=BP=13. In right triangle BCQ, altitude BR=6 gives CR·RQ=36 and CR+RQ=13. Since BC>BQ, CR=9 and RQ=4. Thus BC²=CQ·CR=13·9=117.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2021_Fall_AMC_10B_Q15","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"coordinate-orthogonality","label":"Coordinates and perpendicular vectors","methodDirectNodeIds":{"coordinate-orthogonality":["cnm_084","cnm_h088","cnm_174","cnm_224"]},"nodeIds":["cnm_084","cnm_h088","cnm_174","cnm_224"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"E, 67; possible areas are 9/5 and 5/3","reason":"The outer side is √10. After multiplying coordinates by √10 and placing the origin at the upper-left corner, the shared vertex of R is (4,3), and the long rectangle edge is 3y=x+11. Writing R's top vertex as (h,0), the rectangle conditions give (h-7)(h-8)=0. These yield actual areas 9/5 and 5/3, whose sum is 52/15. Thus m+n=67.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2021_Fall_AMC_10B_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-orthogonality","label":"Coordinate rectangle equations","methodDirectNodeIds":{"coordinate-orthogonality":["cnm_084","cnm_h088","cnm_224"]},"nodeIds":["cnm_084","cnm_h088","cnm_224"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C: the triangle is acute","reason":"Scale the sides to 6, 8, and 9. The largest angle has cosine (6²+8²-9²)/(2·6·8)=19/96>0, so even the largest angle is acute.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"1952_AMC_12_Q15","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"coordinate-dot-product-classification","label":"Classify the angles by projections and dot products","methodDirectNodeIds":{"coordinate-dot-product-classification":["cnm_h173","cnm_h088","cnm_h061","cnm_036","cnm_042"]},"nodeIds":["cnm_h173","cnm_h088","cnm_h061","cnm_036","cnm_042"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"A, 4 integers","reason":"All angles are acute exactly when 24² < 10²+x² and x² < 10²+24²; the remaining side-square inequality is automatic. Thus 476 < x² < 676, giving x = 22, 23, 24, 25. All four also satisfy the triangle inequalities.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"1988_AMC_12_Q22","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"acute-angle-dot-product-inequalities","label":"Derive acute-angle inequalities from squared distances","methodDirectNodeIds":{"acute-angle-dot-product-inequalities":["cnm_h173","cnm_h088","cnm_h061","cnm_036"]},"nodeIds":["cnm_h173","cnm_h088","cnm_h061","cnm_036"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"E, sqrt(30)","reason":"Write OX=OY=r. Equal chords give equal angles OZX and OZY. The cosine law therefore gives (290-r^2)/286=(170-r^2)/154. Simplifying yields 6r^2=180, so r=sqrt(30).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2012_AMC_12A_Q16","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"ptolemy-and-derived-dot-product-squares","label":"Combine Ptolemy with square identities derived from dot products","methodDirectNodeIds":{"ptolemy-and-derived-dot-product-squares":["math:ptolemy-theorem","cnm_255","cnm_h088","cnm_h089","cnm_h064"]},"nodeIds":["math:ptolemy-theorem","cnm_255","cnm_h088","cnm_h089","cnm_h064"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C. 0.29; the probability is π/4-1/2≈0.2854","reason":"Because 1 is the longest side, a nondegenerate triangle requires x+y>1, and it is obtuse exactly when x²+y²<1. In the unit square, this region is the quarter unit disk minus the triangle x+y≤1. Its area, and therefore its probability, is π/4-1/2≈0.2854, closest to 0.29.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_10B_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-obtuse-region","label":"Derive the obtuse-region inequality from squared distances","methodDirectNodeIds":{"coordinate-obtuse-region":["cnm_h173","cnm_h088","cnm_036","cnm_042"]},"nodeIds":["cnm_h173","cnm_h088","cnm_036","cnm_042"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"E, 4/7","reason":"Factoring gives x-intercepts (-5,0) and (3,0), while B=(0,-15). The two angles beside the upward vertical at B have tangents 5/15=1/3 and 3/15=1/5. Therefore tan(∠ABC)=(1/3+1/5)/(1-(1/3)(1/5))=4/7.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2022_AMC_12B_Q14","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"vector-dot-product","label":"Find cosine using a dot product","methodDirectNodeIds":{"vector-dot-product":["cnm_234","cnm_h088","cnm_h173","cnm_h063"]},"nodeIds":["cnm_h088","cnm_h063","cnm_234","cnm_h173"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"A (5; orthocenter (2,3))","reason":"BC is horizontal, so the altitude from A is x=2. Since AC has slope −1/4, the altitude from B is y−27=4(x−8). Substituting x=2 gives y=3, so the coordinate sum is 5.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2025_AMC_12A_Q11","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"altitude-dot-products","label":"Perpendicularity by dot products","methodDirectNodeIds":{"altitude-dot-products":["cnm_h086","cnm_h088","cnm_h090"]},"nodeIds":["cnm_h086","cnm_h088","cnm_h090"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"adjudication":"Root independently checked the actual task, derivation and explicit sampling conventions.","derivedAnswer":"C, 5/16","reason":"The actual SVG has the stated pentagon ordering A, B, C, D, E, with AB the lower-left cut of the rectangle. For P=(x, y), the dot product (A-P)dot(B-P)=x(x-4)+y(y-2) is negative exactly when(x-2)^2+(y-1)^2<5. Thus the obtuse locus is the interior of the circle with diameter AB, center(2, 1), radius sqrt(5). There is also a purely angle-based locus argument: the diameter theorem gives a right angle at each other circle point Q. If angle BAP>=90 degrees, angle APB cannot be obtuse. Otherwise ray AP meets the circle again at Q. If P lies before Q, angle APB is the exterior angle of PBQ and exceeds the right angle at Q;if P is beyond Q, triangle PQB has its right angle at Q and angle APB is acute. This proves the same inside-circle criterion without dot products. The pentagon is the rectangle 0<=x<=2 pi+1, 0<=y<=4 cut by x+2 y>=4. The diameter AB lies on the cut line, and the circle is centered on that line, so the favorable part is its upper/right semicircle. This semicircle really fits: if x<=0 and x+2 y>=4, then y>=2-x/2 and squared center distance is at least(x-2)^2+(1-x/2)^2=5-5 x+5 x^2/4>=5;similarly y<=0 would give x>=4-2 y and squared distance at least 5(1-y)^2>=5. Its remaining extents satisfy y<=1+sqrt(5)<4 and x<=2+sqrt(5)<5<2 pi+1. Hence no additional clipping occurs. Favorable area is 5 pi/2. The pentagon area is 4*(2 pi+1)-(1/2)*4*2=8 pi, so the ratio is 5/16. Boundaries have area zero.","recordedAnswer":"C","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":["Random point selection in the pentagon uses the ordinary uniform area model.","“Selected at random” is interpreted as uniform selection with respect to area. Boundary sets have area zero and do not affect the probability."],"questionId":"2001_AMC_12_Q17","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"negative-dot-product","label":"Use the negative-dot-product disk and the clipped rectangle area","methodDirectNodeIds":{"negative-dot-product":["cnm_h088","cnm_h061","cnm_h176","cnm_257","cnm_p089","cnm_p148","cnm_p150"]},"nodeIds":["cnm_h088","cnm_h061","cnm_h176","cnm_257","cnm_p089","cnm_p148","cnm_p150"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C, 568","reason":"Each side must be at most 15. The number of ordered positive tuples summing to 32 is C(31,3)-4C(16,3)=2255. Exactly 15 have the form (a,b,a,b), where a+b=16; one of these is (8,8,8,8). Thus the cyclic-shift orbits number (2255-15)/4+(15-1)/2+1=568. Reflections are not additionally identified.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2010_AMC_12A_Q25","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"shared-diagonal-dot-product-realization","label":"Derive a unique cyclic realization through a shared diagonal","methodDirectNodeIds":{"shared-diagonal-dot-product-realization":["cnm_111","cnm_h088","cnm_h089","cnm_h049","cnm_h064","cnm_255"]},"nodeIds":["cnm_111","cnm_h088","cnm_h089","cnm_h049","cnm_h064","cnm_255"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"D: 12, with CI = (3 - sqrt(7))/2","reason":"Take A=(0,0), B=(3,0), C=(0,3), so M=(3/2,3/2). Write AE=e and AI=i. Perpendicularity of MI and ME gives e+i=3. The area equation (3/4)(e+i) - ei/2 = 2 gives ei=1/2. Since i>e, i=(3+sqrt(7))/2. Thus CI=(3-sqrt(7))/2 and a+b+c=3+7+2=12.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_12A_Q20","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-perpendicularity-and-area","label":"Coordinate perpendicularity and area","methodDirectNodeIds":{"coordinate-perpendicularity-and-area":["cnm_084","cnm_h088","cnm_h090","cnm_p150","cnm_222"]},"nodeIds":["cnm_084","cnm_h088","cnm_h090","cnm_p150","cnm_222"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"B: 5√3/11","reason":"ABC has area 49√3, so each added triangle has area 14√3 and height 2√3. Put the center at the origin and A=(-7,-7√3/3). The common radius is 14/√3, giving D=(-3,-13√3/3), with the negative horizontal coordinate fixed by 0<θ<60°. Thus cos θ=(154/3)/(196/3)=11/14 and sin θ=5√3/14, so tan θ=5√3/11.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2024_AMC_12B_Q19","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"radius-vector-dot-product","label":"Dot product of radius vectors","methodDirectNodeIds":{"radius-vector-dot-product":["cnm_084","cnm_174","cnm_h086","cnm_h088","cnm_h063"]},"nodeIds":["cnm_084","cnm_174","cnm_h086","cnm_h088","cnm_h063"]}]},{"additionalConceptCount":8,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C, 0.16","reason":"Native mathematical derivation agrees with the recorded choice; no grading change proposed.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"2012_AMC_12A_Q23","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"lattice-pair-overlaps-and-unit-cells","label":"Restrict lattice pairs, compute rotated-square overlaps, and tile a unit cell","methodDirectNodeIds":{"lattice-pair-overlaps-and-unit-cells":["math:lattice-counting","cnm_h088","cnm_h173","cnm_174","cnm_p089","cnm_p150","cnm_072","cnm_136"]},"nodeIds":["math:lattice-counting","cnm_h088","cnm_h173","cnm_174","cnm_p089","cnm_p150","cnm_072","cnm_136"]}]},{"additionalConceptCount":9,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"C, 1/4","reason":"Native mathematical derivation agrees with the recorded choice; no grading change proposed.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":["The solution uses the conventional interpretation of uniformly random directions in the plane."],"questionId":"2010_AMC_12B_Q18","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"unit-vectors-and-semicircle-containment","label":"Unit-vector norm identity and angular semicircle containment","methodDirectNodeIds":{"unit-vectors-and-semicircle-containment":["cnm_h081","cnm_h088","cnm_h089","cnm_h060","cnm_h064","cnm_h070","cnm_h068","cnm_h141","cnm_h139"]},"nodeIds":["cnm_h081","cnm_h088","cnm_h089","cnm_h060","cnm_h064","cnm_h070","cnm_h068","cnm_h141","cnm_h139"]}]},{"additionalConceptCount":10,"alignmentIds":["alignment:fd577858b494257e5f0f5a60"],"answerCheck":{"derivedAnswer":"D, 5.0","reason":"The rotated-square lattice bound gives area at most 5 when there are only three interior lattice points. Equality is attained by the square 0≤2x+y≤5, 1≤-x+2y≤6, whose interior lattice points are (0,1), (0,2), and (1,2).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h088"],"coverage":"aligned_concept_only","flags":[],"questionId":"1998_AMC_12_Q29","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_082","cnm_174","cnm_191","math:unit-vectors"],"id":"universal-bound-and-construction","label":"Bound the side length and construct an example","methodDirectNodeIds":{"universal-bound-and-construction":["math:extremal-principle","math:lattice-counting","cnm_h086","cnm_h087","cnm_h088","cnm_h090","cnm_p089"]},"nodeIds":["math:extremal-principle","math:lattice-counting","cnm_h086","cnm_h087","cnm_h088","cnm_h090","cnm_p089","cnm_082","cnm_174","cnm_191","math:unit-vectors"]}]}],"canonicalNodeIds":["cnm_h088"],"label":"向量数量积","layer":"CN","meaning":"Practice covers aligned canonical concepts, with no claim of complete standard coverage or mastery.","nextOffset":null,"sourceNode":{"criteria":["能用坐标求数量积","知道数量积是一个数"],"description":"知道 a·b=|a||b|cosθ，也会用坐标计算 x1x2+y1y2。","id":"cnm_h088","label":"向量数量积","original":{"chapter":"高二 第六章 平面向量及其应用 6.4","description":"知道 a·b=|a||b|cosθ，也会用坐标计算 x1x2+y1y2。","domain":"图形与几何","external":false,"grade":11,"id":"cnm_h088","mastery_criteria":["能用坐标求数量积","知道数量积是一个数"],"name":"向量数量积","semester":"上","standards":[{"confidence":"exact","id":"cms-2017:H.GA.04"}],"type":"procedural"},"plac