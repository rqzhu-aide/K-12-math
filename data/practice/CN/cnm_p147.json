{"alignments":[{"id":"alignment:06d5a7e54bf0f6443238260a","layer":"CN","nodeId":"cnm_p147","reason":"Canonical description and mastery criteria are unchanged from this pinned native topic; placement remains a separate source annotation.","relation":"exact","reviewProvenance":{"comparedFields":["description","criteria"],"reviewMeaning":"Definition identity, not an official curriculum equivalence claim.","sourceRevision":"62b341d4b66b175413d6e3f697e37639fd96aa2d","type":"source_identity_comparison"},"reviewStatus":"machine_content_review","sourceNodeId":"cnm_p147","status":"accepted"}],"candidates":[{"additionalConceptCount":1,"alignmentIds":["alignment:06d5a7e54bf0f6443238260a"],"answerCheck":{"derivedAnswer":"28 cm²","reason":"The area is base × height = 7 × 4 = 28 cm².","status":"matches"},"assessed":true,"bank":"cn-math","canonicalNodeIds":["cnm_p147"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_p147_q1","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p042"],"id":"cnm_p147_q1_m1","label":"Parallelogram area formula","methodDirectNodeIds":{"cnm_p147_q1_m1":["cnm_p147"]},"nodeIds":["cnm_p147","cnm_p042"]}]},{"additionalConceptCount":1,"alignmentIds":["alignment:06d5a7e54bf0f6443238260a"],"answerCheck":{"derivedAnswer":"45 square centimeters","reason":"The parallelogram area is 9 × 5 = 45 square centimeters.","status":"matches"},"assessed":true,"bank":"cn-math","canonicalNodeIds":["cnm_p147"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_p147_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p042"],"id":"base-times-height","label":"Multiply base by height","methodDirectNodeIds":{"base-times-height":["cnm_p147"]},"nodeIds":["cnm_p147","cnm_p042"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:06d5a7e54bf0f6443238260a"],"answerCheck":{"derivedAnswer":"C: 240 square feet","reason":"On the unrolled surface, the stripe has horizontal base 3 feet and vertical altitude 80 feet