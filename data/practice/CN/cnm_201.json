":["cnm_201"],"coverage":"aligned_concept_only","flags":[],"questionId":"1982_AMC_12_Q09","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_p148","cnm_201","cnm_075"],"id":"solution:coordinate-triangle-area:6b180a1be298","label":"Find the area to the right of the cut","methodDirectNodeIds":{"coordinate-triangle-area":["cnm_084","cnm_205","cnm_220"]},"nodeIds":["cnm_084","cnm_205","cnm_220","cnm_p148","cnm_201","cnm_075"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:9a525b7205944d00efcaaa36"],"answerCheck":{"derivedAnswer":"C, 88/5 square units","reason":"Since AH is parallel to CG, triangles AHM and GCM are similar, giving AM:MG = 12:8 = 3:2. Thus area(ACM) = (3/5)area(ACG) = (3/5)·16. Adding area(ABC) = 8 gives area(ABCM) = 88/5.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_201"],"coverage":"aligned_concept_only","flags":[],"questionId":"2007_AMC_10A_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p148","cnm_201","cnm_089"],"id":"coordinates-intersection-areas","label":"Method 2: Coordinates and triangle areas","methodDirectNodeIds":{"coordinates-intersection-areas":["cnm_p150","cnm_084","cnm_205","cnm_208"]},"nodeIds":["cnm_p150","cnm_084","cnm_205","cnm_208","cnm_p148","cnm_201","cnm_089"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:9a525b7205944d00efcaaa36"],"answerCheck":{"derivedAnswer":"B (58), with intersection (27/8, 15/8)","reason":"Shoelace gives area(ABCD)=(18-3)/2=15/2. For E=(u,v), area(ADE)=2v=15/4, so v=15/8. On CD, v=12-3u, giving u=27/8. Therefore p+q+r+s=27+8+15+8=58.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_201"],"coverage":"aligned_concept_only","flags":[],"questionId":"2013_AMC_12A_Q13","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p148","cnm_082","cnm_201"],"id":"coordinate-area-bisection","label":"Split the quadrilateral into simple regions","methodDirectNodeIds":{"coordinate-a