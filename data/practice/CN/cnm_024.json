cnm_090","cnm_040","cnm_042"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"C, 13","reason":"Positional expansion gives 2B=A^2-3A-4. For B=A+1, this becomes (A-6)(A+1)=0, yielding A=6 and B=7. For B=A-1, the quadratic has nonsquare discriminant 33, so there is no integer solution. Thus A+B=13.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2012_AMC_12B_Q11","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_020","cnm_040","cnm_096"],"id":"place-value-and-integer-bounds","label":"Use place value and the small difference between the bases","methodDirectNodeIds":{"place-value-and-integer-bounds":["cnm_024","math:integer-diophantine-equations"]},"nodeIds":["cnm_024","math:integer-diophantine-equations","cnm_020","cnm_040","cnm_096"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"E, 21","reason":"The cutoff 1000 is hexadecimal 3E8. With three-position zero padding, the first digit can be 0, 1, 2, or 3, and each remaining digit can be 0 through 9. Even 399 in hexadecimal is only 921, so all these strings qualify except zero. Thus n=4*10*10-1=399, whose digit sum is 21.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2015_AMC_10A_Q18","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_020"],"id":"padded-hexadecimal-digits","label":"Count three-position hexadecimal strings","methodDirectNodeIds":{"padded-hexadecimal-digits":["cnm_024","cnm_h231"]},"nodeIds":["cnm_024","cnm_h231","cnm_020"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D (3281)","reason":"Set b_i=a_i+1, so b_i is 0, 1, or 2. The original value is T-(1+3+...+3^7)=T-3280, where T uniquely ranges over 0 through 6560. Nonnegative values correspond to T=3280 through 6560, giving 3281 integers.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_10A_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"ternary-shift-and-pairing","label":"Shift to base three and pair opposite values","methodDirectNodeIds":{"ternary-shift-and-pairing":["cnm_024","math:bijective-counting","cnm_h231"]},"nodeIds":["cnm_024","math:bijective-counting","cnm_h231"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D: 3281","reason":"Put b_i = a_i + 1. The b_i range independently over {0,1,2}, so their ternary values run exactly from 0 to 3^8 - 1 = 6560. Since sum(3^i, i=0,...,7) = 3280, the original values are exactly -3280 through 3280. There are 3281 nonnegative values.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_12A_Q13","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"shift-to-ternary","label":"Shift the digits to base 3","methodDirectNodeIds":{"shift-to-ternary":["cnm_024","math:bijective-counting","cnm_h231"]},"nodeIds":["cnm_024","math:bijective-counting","cnm_h231"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D, 16","reason":"The repeating value is (2k+3)/(k²−1), so 7(k²−1)=51(2k+3). This gives 7k²−102k−160=(k−16)(7k+10)=0. Only k=16 is an admissible base, and 35/255=7/51 verifies it.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2019_AMC_10A_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_040"],"id":"shift-and-factor","label":"Shift the expansion and factor","methodDirectNodeIds":{"shift-and-factor":["cnm_024","cnm_224"]},"nodeIds":["cnm_040","cnm_224","cnm_024"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D, remainder 3","reason":"N=2·9^10+7·9^9+6·9^6+5·9+2. Modulo 5 this is 2-7+6-5+2=-2≡3.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2021_Fall_AMC_12A_Q10","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"alternate-power-remainders","label":"Use alternating remainders of powers","methodDirectNodeIds":{"alternate-power-remainders":["cnm_024","math:modular-powers","math:modular-congruence"]},"nodeIds":["cnm_024","math:modular-powers","math:modular-congruence"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"A. 6","reason":"First x₀ = 1. Let qₙ = (7Sₙ - 1)/2^n. Then qₙ₊₁ = (qₙ + 7xₙ)/2, so xₙ must have the parity of qₙ. Starting at q₁ = 3 gives the repeating carry cycle 3, 5, 6 and digits x₁,x₂,x₃ = 1,1,0. Thus x₂₀₁₉,x₂₀₂₀,x₂₀₂₁,x₂₀₂₂ = 0,1,1,0, giving 0 + 2 + 4 + 0 = 6.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2022_AMC_12B_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"prefixes-modulo-seven","label":"Find the two partial sums","methodDirectNodeIds":{"prefixes-modulo-seven":["math:modular-congruence","math:modular-powers","cnm_024"]},"nodeIds":["math:modular-congruence","math:modular-powers","cnm_024"]},{"contextNodeIds":[],"id":"forced-digit-cycle","label":"Follow the repeating digits","methodDirectNodeIds":{"forced-digit-cycle":["math:modular-congruence","cnm_h200","cnm_024","cnm_p156"]},"nodeIds":["math:modular-congruence","cnm_h200","cnm_024","cnm_p156"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D, 20; K = 758","reason":"The numeral equals 2b³+2b+4, so divisibility by 16 is equivalent to b³+b+2 ≡ 0 (mod 8). Testing residues modulo 8 gives b ≡ 3,6,7. Each class occurs 253 times in 1 through 2024, but b=3 must be excluded. Thus K=3·253-1=758, and its digit sum is 20.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2024_AMC_10A_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"factor-and-check-residues","label":"Factor and check remainders","methodDirectNodeIds":{"factor-and-check-residues":["cnm_024","math:modular-congruence","cnm_155"]},"nodeIds":["cnm_024","math:modular-congruence","cnm_155"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D: 20","reason":"Divisibility is equivalent to b³+b+2 being 0 modulo 8. Testing the eight residues gives b congruent to 3, 6, or 7. Each occurs 253 times from 1 through 2024; excluding bases below 5 removes only b=3. Thus K=758 and its digit sum is 7+5+8=20.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2024_AMC_12A_Q11","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"factor-and-count-residues","label":"Factor and count remainder classes","methodDirectNodeIds":{"factor-and-count-residues":["cnm_024","math:modular-congruence","cnm_155"]},"nodeIds":["cnm_024","math:modular-congruence","cnm_155"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D, a4=3","reason":"Terms from 6! onward vanish because 6!>695. Lower terms below 5! total at most 119, so a5=5 and the remainder is 95. The terms below 4! total between 0 and 23, forcing 95=24·3+23 and a4=3.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"1961_AMC_12_Q35","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["math:factorial-notation","cnm_p112"],"id":"bound-the-lower-digits","label":"Bound what the smaller places can hold","methodDirectNodeIds":{"bound-the-lower-digits":["cnm_024","math:integer-diophantine-equations"]},"nodeIds":["cnm_024","math:integer-diophantine-equations","math:factorial-notation","cnm_p112"]},{"contextNodeIds":["math:factorial-notation","cnm_p112","cnm_p116"],"id":"successive-remainders","label":"Extract the digits by successive division","methodDirectNodeIds":{"successive-remainders":["cnm_024","cnm_p050","cnm_p083"]},"nodeIds":["cnm_024","cnm_p050","cnm_p083","math:factorial-notation","cnm_p112","cnm_p116"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D: every integral base b>2","reason":"121_b=b^2+2b+1=(b+1)^2. The digit 2 is permitted exactly when the positive integral base exceeds 2.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"1962_AMC_12_Q22","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_019","cnm_148"],"id":"expand-place-values","label":"Expand the base-b numeral","methodDirectNodeIds":{"expand-place-values":["cnm_024","cnm_153"]},"nodeIds":["cnm_024","cnm_153","cnm_019","cnm_148"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"B, 44 in base 9","reason":"The product equation is (b+2)(b+5)(b+6)=3b³+b²+4b+6. It simplifies to (b-9)(b²+3b+3)=0, so b=9. The sum is 3b+13=40 in base ten, which is 44 in base 9.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"1967_AMC_12_Q16","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p153","cnm_096","cnm_029","cnm_020"],"id":"units-digit-and-size-bound","label":"Use the units digit and a size bound","methodDirectNodeIds":{"units-digit-and-size-bound":["cnm_024"]},"nodeIds":["cnm_024","cnm_p153","cnm_096","cnm_029","cnm_020"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"A, 0.","reason":"Writing the digits as a,b,c gives 49a+7b+c=81c+9b+a, so b=8(3a-5c). Since 0<=b<=6, b=0. The valid example 503 in base 7 equals 305 in base 9.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"1968_AMC_12_Q33","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p153","cnm_042"],"id":"base-expansion-and-multiples","label":"Expand the place values","methodDirectNodeIds":{"base-expansion-and-multiples":["cnm_024","math:integer-diophantine-equations"]},"nodeIds":["cnm_024","math:integer-diophantine-equations","cnm_p153","cnm_042"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"C ((80) in base n)","reason":"The numeral (18) in base n means a=n+8. Substituting x=n gives b=an-n²=8n, whose base-n representation is (80), valid because n>8.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"1978_AMC_12_Q14","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_039","cnm_029","cnm_040"],"id":"place-value-and-root-substitution","label":"Place value and the given root","methodDirectNodeIds":{"place-value-and-root-substitution":["cnm_024"]},"nodeIds":["cnm_024","cnm_039","cnm_029","cnm_040"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"E. 0.7","reason":"Three digits in base 9 require 81≤n≤728, and in base 11 require 121≤n≤1330. Among the 900 decimal three-digit integers, 608 lie from 121 through 728. The probability is 608/900≈0.676, closest to 0.7.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2003_AMC_10A_Q20","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_020","cnm_p165"],"id":"intersect-digit-length-ranges","label":"Find the ranges for three-digit numerals","methodDirectNodeIds":{"intersect-digit-length-ranges":["cnm_024","cnm_285"]},"nodeIds":["cnm_024","cnm_285","cnm_020","cnm_p165"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"A (100)","reason":"Lengths 1 through 6 contribute 2+2+6+6+18+18=52. Since 2007=2202100₃, allowable seven-digit prefixes run from 1000₃ through 2202₃. The last produces 2202022₃=2006, so all 48 such prefixes qualify. Total: 52+48=100.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2007_AMC_12B_Q21","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_020","cnm_h231"],"id":"count-by-length-and-leading-half","label":"Choose the first half of each palindrome","methodDirectNodeIds":{"count-by-length-and-leading-half":["cnm_024","cnm_h232"]},"nodeIds":["cnm_024","cnm_h232","cnm_020","cnm_h231"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"B, a=6","reason":"The sum of all available exponents is 2047. The omitted exponent contributions must sum to 2047-2012=35=2^5+2^1+2^0. Binary uniqueness therefore makes the coefficient exactly 2^5*2^1*2^0=2^6, so a=6.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2012_AMC_12A_Q20","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_142","cnm_019"],"id":"binary-omitted-exponents","label":"Track the omitted powers of two","methodDirectNodeIds":{"binary-omitted-exponents":["cnm_146","cnm_024"]},"nodeIds":["cnm_146","cnm_024","cnm_142","cnm_019"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"E, 25","reason":"Let the base-5 and base-6 units digits be r and s. The required equality modulo 5 gives s≡r, and modulo 2 excludes the exceptional pair r=0, s=5. Thus r=s≤4 and N=30k+r. The two tens digits are u=k mod 5 and v=(-k) mod 6. Matching modulo 100 gives u+v≡6k mod 10, leaving k≡0,1,12,13,24 mod 30. Three-digit solutions use k=12,13,24,30,31, each with five choices of r, for 25 choices.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2013_AMC_10B_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["math:modular-congruence","cnm_p159"],"id":"last-two-digits","label":"Track only the last two digits in each base","methodDirectNodeIds":{"last-two-digits":["cnm_024","math:simultaneous-congruences"]},"nodeIds":["cnm_024","math:simultaneous-congruences","math:modular-congruence","cnm_p159"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"C: 26","reason":"For binary lengths 3 through 6, choosing two change positions gives 1+3+6+10=20 numbers. Among seven-digit numbers at most 1100001₂, five qualifying strings start with 10, and 1100001₂ is the only additional one. Total: 26.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"1997_AMC_12_Q30","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h237","cnm_h230"],"id":"1997_AMC_12_Q30_m1","label":"Choose the two places where digits change","methodDirectNodeIds":{"1997_AMC_12_Q30_m1":["cnm_024","cnm_h239","math:bijective-counting"]},"nodeIds":["cnm_024","cnm_h239","math:bijective-counting","cnm_h237","cnm_h230"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"C: 13","reason":"The condition is b≥4 and b divides 2013-3=2010. Since 2010=2·3·5·67, it has 2^4=16 positive divisors. Excluding 1, 2, and 3 leaves 13 valid bases.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2013_AMC_10A_Q19","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p050","math:prime-factorization","cnm_h231"],"id":"place-value-and-divisors","label":"Translate the last digit into a divisor condition","methodDirectNodeIds":{"place-value-and-divisors":["cnm_024","math:divisor-count-and-sum"]},"nodeIds":["cnm_024","math:divisor-count-and-sum","cnm_p050","math:prime-factorization","cnm_h231"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"E, 962","reason":"Let F(k)=k²+k+1. Then a_k=F(k+1)/((k−1)F(k)), so the product is 2F(100)/(F(4)·98!)=962/98!. A denominator of 97! would require 962/98 to be integral, which it is not; smaller factorials are therefore impossible.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2004_AMC_12A_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["math:factorial-notation","cnm_p153","cnm_160"],"id":"base-expansion-telescoping","label":"Convert the repeating blocks and telescope","methodDirectNodeIds":{"base-expansion-telescoping":["cnm_024","math:infinite-geometric-series","math:sum-difference-cubes","math:telescoping"]},"nodeIds":["cnm_024","math:infinite-geometric-series","math:sum-difference-cubes","math:telescoping","math:factorial-notation","cnm_p153","cnm_160"]}]},{"additionalConceptCount":6,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"E, 25","reason":"Matching the units digits forces N=30k+j with 0≤j≤4 and 4≤k≤33. The tens-digit condition is (k mod 5)+((-k) mod 6)≡6k (mod 10), giving k≡0,1,12,13,24 (mod 30). In the allowed interval these are k=12,13,24,30,31. Each permits five values of j, so there are 25 choices.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2013_AMC_12B_Q23","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["math:modular-congruence","cnm_p159","cnm_p017","cnm_p050"],"id":"match-units-then-tens","label":"Match the units digits first, then the tens digits","methodDirectNodeIds":{"match-units-then-tens":["cnm_024","math:simultaneous-congruences","cnm_h232"]},"nodeIds":["cnm_024","math:simultaneous-congruences","cnm_h232","math:modular-congruence","cnm_p159","cnm_p017","cnm_p050"]}]},{"additionalConceptCount":1,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"B (9 keystrokes)","reason":"Working backward gives 200, 100, 50, 25, 24, 12, 6, 3, 2, 1, requiring nine moves. Halving at an even target is optimal: a doubling followed by two increments can be shortened to an increment followed by a doubling; an all-increment path is no better.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_024"],"coverage":"aligned_concept_only","flags":[],"questionId":"2005_AMC_8_Q24","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"binary-expansion","label":"Use binary digits","methodDirectNodeIds":{"binary-expansion":["cnm_024"]},"nodeIds":["cnm_024"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:a987b535779e9a21d69ef6f7"],"answerCheck":{"derivedAnswer":"D (31)","reason":"The recurrence gives x_5={32x_0}. Equality with x_0 holds exactly when 31x_0 is an integer. Since 0<=x_0<1, the solutions are k/31 for k=0,1,...,30, giving 31 values.","status":"matches"},"assessed":false,"ban