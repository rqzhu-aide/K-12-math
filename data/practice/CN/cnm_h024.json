ined","routes":[{"contextNodeIds":["cnm_150","cnm_096"],"id":"solution:positive-factor-bounds:474d3e65bc02","label":"Factor and bound positive factors","methodDirectNodeIds":{"positive-factor-bounds":["cnm_h024","cnm_h029","cnm_h018"]},"nodeIds":["cnm_h024","cnm_h029","cnm_h018","cnm_150","cnm_096"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:b9bd944febf30d8590fe47b8"],"answerCheck":{"derivedAnswer":"0","reason":"(x-2)(x-3)<0 holds exactly when 2<x<3, which contains no integers.","status":"matches"},"assessed":true,"bank":"cn-math","canonicalNodeIds":["cnm_h024"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_h024_q1","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_014"],"id":"factor-sign-interval","label":"Factor and find the negative interval","methodDirectNodeIds":{"factor-sign-interval":["cnm_h024","cnm_h020"]},"nodeIds":["cnm_h024","cnm_h020","cnm_014"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:b9bd944febf30d8590fe47b8"],"answerCheck":{"derivedAnswer":"5","reason":"(x-1)(x-4)<0 holds for 1<x<4. The integer solutions are 2 and 3, and their sum is 5.","status":"matches"},"assessed":true,"bank":"cn-math","canonicalNodeIds":["cnm_h024"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_h024_q4","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_014"],"id":"quadratic-inequality","label":"Solve the inequality and identify the integers","methodDirectNodeIds":{"quadratic-inequality":["cnm_h024","cnm_h020"]},"nodeIds":["cnm_h024","cnm_h020","cnm_014"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:b9bd944febf30d8590fe47b8"],"answerCheck":{"derivedAnswer":"5","reason":"(x-2)(x-3)≤0 gives 2≤x≤3. The integer solutions are 2 and 3, whose sum is 5.","status":"matches"},"assessed":true,"bank":"cn-math","canonicalNodeIds":["cnm_h024"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_h024_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNode