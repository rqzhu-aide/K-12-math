atches"},"assessed":true,"bank":"cn-math","canonicalNodeIds":["cnm_150"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_150_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_032"],"id":"classify-all-four-transformations","label":"Apply the definition to each transformation","methodDirectNodeIds":{"classify-all-four-transformations":["cnm_150"]},"nodeIds":["cnm_150","cnm_032"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:7767d43cedf134eacc7f780f"],"answerCheck":{"derivedAnswer":"D, p=6 and q=25","reason":"Modulo x²+2x+5, x²=-2x-5 and x⁴=12x+5. The remainder is (12-2p)x+(5-5p+q), so p=6 and q=25. Indeed, (x²+2x+5)(x²-2x+5)=x⁴+6x²+25.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_150"],"coverage":"aligned_concept_only","flags":[],"questionId":"1960_AMC_12_Q31","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_032","cnm_042"],"id":"match-factor-coefficients","label":"Match the coefficients of the product","methodDirectNodeIds":{"match-factor-coefficients":["cnm_150","math:factorization-coefficient-comparison","cnm_146","cnm_034"]},"nodeIds":["cnm_150","math:factorization-coefficient-comparison","cnm_146","cnm_034","cnm_032","cnm_042"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:7767d43cedf134eacc7f780f"],"answerCheck":{"derivedAnswer":"C, x^2-2x+2","reason":"x^4+4=(x^2+2)^2-(2x)^2=(x^2-2x+2)(x^2+2x+2).","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_150"],"coverage":"aligned_concept_only","flags":[],"questionId":"1953_AMC_12_Q18","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_147"],"id":"create-difference-of-squares","label":"Create a difference of squares","methodDirectNodeIds":{"create-difference-of-squares":["cnm_150","cnm_148","cnm_152"]},"nodeIds":["cnm_150","cnm_148","cnm_152","cnm_147"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:7767d43cedf134eacc7f780f"],"answerCheck":{"derivedAns