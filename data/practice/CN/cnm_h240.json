{"alignments":[{"id":"alignment:a5169760c44ddad1c2987dd0","layer":"CN","nodeId":"cnm_h240","reason":"Canonical description and mastery criteria are unchanged from this pinned native topic; placement remains a separate source annotation.","relation":"exact","reviewProvenance":{"comparedFields":["description","criteria"],"reviewMeaning":"Definition identity, not an official curriculum equivalence claim.","sourceRevision":"62b341d4b66b175413d6e3f697e37639fd96aa2d","type":"source_identity_comparison"},"reviewStatus":"machine_content_review","sourceNodeId":"cnm_h240","status":"accepted"}],"candidates":[{"additionalConceptCount":1,"alignmentIds":["alignment:a5169760c44ddad1c2987dd0"],"answerCheck":{"derivedAnswer":"B, -2^49","reason":"The sum is Re((1+i)^99). Since (1+i)^4 = -4 and (1+i)^3 = -2+2i, its real part is Re((-4)^24(-2+2i)) = -2^49.","status":"matches"},"assessed":true,"bank":"amc","canonicalNodeIds":["cnm_h240"],"coverage":"aligned_concept_only","flags":[],"questionId":"1989_AMC_12_Q29","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h237","cnm_h097","cnm_143"],"id":"real-part-binomial-expansion","label":"Read the sum from a complex binomial expansion","methodDirectNodeIds":{"real-part-binomial-expansion":["cnm_h240","cnm_h102","cnm_h104"]},"nodeIds":["cnm_h240","cnm_h102","cnm_h104","cnm_h237","cnm_h097","cnm_143"]}]},{"additionalConceptCount":1,"alignmentIds":["alignment:a5169760c44ddad1c2987dd0"],"answerCheck":{"derivedAnswer":"5","reason":"The terms are a^4, 4a^3b, 6a^2b^2, 4ab^3, and b^4, giving five terms.","status":"matches"},"assessed":true,"bank":"cn-math","canonicalNodeIds":["cnm_h240"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_h240_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_032"],"id":"m1","label":"Count the binomial terms","methodDirectNodeIds":{"m1":["cnm_h240"]},"nodeIds":["cnm_h240","cnm_032"]}]},{"additionalConceptCount":1,"alignmentIds":["alignment:a5169760c44ddad1c