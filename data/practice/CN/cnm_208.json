_208","cnm_174"]},"nodeIds":["cnm_268","cnm_084","cnm_205","cnm_208","cnm_174","cnm_082","cnm_089","cnm_055","cnm_p210"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:358db911e6c6c5c7f19da080"],"answerCheck":{"derivedAnswer":"C, 3 square units","reason":"Let X=EB∩CF. Triangles BCX and FEX are similar with base ratio 1:3, so their heights are 1 and 3 because the rectangle's height is 4. Each wing has area (1·4)/2−(1·1)/2=3/2, giving total area 3.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"2016_AMC_8_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-line-intersection","label":"Coordinate intersection","methodDirectNodeIds":{"coordinate-line-intersection":["cnm_084","cnm_205","cnm_208"]},"nodeIds":["cnm_084","cnm_205","cnm_208"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:358db911e6c6c5c7f19da080"],"answerCheck":{"derivedAnswer":"B: 108","reason":"Since AB is parallel to CE and AB=2CE, similarity gives AF=2CF. For square side s, F is therefore s/3 above CD. Thus area(FCE)=(1/2)(s/2)(s/3)=s²/12, and area(AFED)=s²/2−s²/12=5s²/12=45. Hence s²=108.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_8_Q22","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-intersection","label":"Coordinates and line intersection","methodDirectNodeIds":{"coordinate-intersection":["cnm_084","cnm_205","cnm_208"]},"nodeIds":["cnm_084","cnm_205","cnm_208"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:358db911e6c6c5c7f19da080"],"answerCheck":{"derivedAnswer":"4","reason":"At x=1, the first line gives y=3. Thus 3=-1+m, so m=4.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_208_q4","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_042"],"id":"intersection-parameter","label":"Find the common point and determine m","methodDirectNodeIds":{"intersection-parameter":["cnm_205","cnm_196","cnm_208"]},"nodeIds":["cnm_205","cnm_196","cnm_208","cnm_042"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:358db911e6c6c5c7f19da080"],"answerCheck":{"derivedAnswer":"C: √3/2","reason":"Set A = (0,0), B = (s,0), D = (0,s), where s² = 1 + √3. Then AE is y = √3x and BD is x + y = s. Thus y_F = √3s/(1 + √3), and [ABF] = √3s²/(2(1 + √3)) = √3/2.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"1978_AMC_12_Q23","reviewStatus":"machine_scope_audited","routes":[{"id":"coordinate-intersection","label":"Intersect AE and BD in coordinates","nodeIds":["cnm_174","cnm_205","cnm_208","cnm_084"]},{"contextNodeIds":["cnm_082","cnm_139","cnm_137","cnm_191","cnm_174"],"id":"solution:coordinate-intersection:9d8b1a4aa762","label":"Find the intersection using coordinates","methodDirectNodeIds":{"coordinate-intersection":["cnm_084","cnm_205","cnm_208","cnm_p148"]},"nodeIds":["cnm_084","cnm_205","cnm_208","cnm_p148","cnm_082","cnm_139","cnm_137","cnm_191","cnm_174"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:358db911e6c6c5c7f19da080"],"answerCheck":{"derivedAnswer":"C, 15√3/32","reason":"Use A=(1,0), B=(1/2,√3/2), and successive regular-hexagon vertices. Triangle XYZ has area 9√3/16. At X=(3/4,√3/4), AC intersects XY at (1/4,√3/4) and XZ at (5/8,√3/8). The removed cap therefore has base 1/2, height √3/8, and area √3/32. Three equal caps leave 9√3/16−3√3/32=15√3/32.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_10B_Q24","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-clipping","label":"Locate intersections and subtract triangular caps","methodDirectNodeIds":{"coordinate-clipping":["cnm_084","cnm_208","cnm_p148"]},"nodeIds":["cnm_084","cnm_208","cnm_p148"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:358db911e6c6c5c7f19da080"],"answerCheck":{"derivedAnswer":"C: 3 ordered pairs","reason":"Substitute x = 3 - 3y and split at y = 0 and y = 1. The valid values are y = 1/2, 1, 2, giving (3/2, 1/2), (0, 1), and (-3, 2). All three satisfy both original equations.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_12A_Q10","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"intersect-piecewise-linear-loci","label":"Intersect the linear branches","methodDirectNodeIds":{"intersect-piecewise-linear-loci":["cnm_197","cnm_202","cnm_208"]},"nodeIds":["cnm_197","cnm_202","cnm_208"]}]}],"canonicalNodeIds":["cnm_208"],"label":"一次函数与二元一次方程组","layer":"CN","meaning":"Practice covers aligned canonical concepts, with no claim of complete standard coverage or mastery.","nextOffset":null,"sourceNode":{"criteria":["能由交点求方程组的解","能用方程组求交点"],"description":"两个一次函数图象的交点坐标就是对应二元一次方程组的解。","id":"cnm_208","label":"一次函数与二元一次方程组","original":{"chapter":"八下 第二十三章 一次函数 23.3","description":"两个一次函数图象的交点坐标就是对应二元一次方程组的解。","domain":"数与代数","external":false,"grade":8,"id":"cnm_208","mastery_criteria":["能由交点求方程组的解","能用方程组求交点"],"name":"一次函数与二元一次方程组","semester":"下","standards":[{"confidence":"exact","id":"cms-2022:4.NA.41"}],"type":"conceptual"},"placement":{"chapter":"八下 第二十三章 一次函数 23.3","domain":"数与代数","grade":8,"semester":"下"},"reviewStatus":"source_only"},"sourceNodeId":"cnm_208","status":"mapped","total":31}
