80"],"answerCheck":{"derivedAnswer":"C, 88/5 square units","reason":"Since AH is parallel to CG, triangles AHM and GCM are similar, giving AM:MG = 12:8 = 3:2. Thus area(ACM) = (3/5)area(ACG) = (3/5)·16. Adding area(ABC) = 8 gives area(ABCM) = 88/5.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"2007_AMC_10A_Q18","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"coordinate-line-intersection","label":"Coordinates and intersecting lines","methodDirectNodeIds":{"coordinate-line-intersection":["cnm_084","cnm_205","cnm_208"]},"nodeIds":["cnm_084","cnm_205","cnm_208"]},{"contextNodeIds":["cnm_p148","cnm_201","cnm_089"],"id":"coordinates-intersection-areas","label":"Method 2: Coordinates and triangle areas","methodDirectNodeIds":{"coordinates-intersection-areas":["cnm_p150","cnm_084","cnm_205","cnm_208"]},"nodeIds":["cnm_p150","cnm_084","cnm_205","cnm_208","cnm_p148","cnm_201","cnm_089"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:358db911e6c6c5c7f19da080"],"answerCheck":{"derivedAnswer":"B. 1/5 square unit","reason":"Place the bottom-left vertex at (0,0), so A=(0,2) and B=(1,2). The two segments lie on y=2-x/2 and y=2x, giving C=(4/5,8/5). Its distance below AB is 2/5, so the area is (1/2)×1×(2/5) = 1/5.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_208"],"coverage":"aligned_concept_only","flags":[],"questionId":"2012_AMC_10A_Q15","reviewStatus":"machine_scope_audited","routes":[{"id":"coordinate-line-intersection","label":"Coordinate line intersection","nodeIds":["cnm_084","cnm_205","cnm_208"]},{"contextNodeIds":["cnm_p077","cnm_112","cnm_082","cnm_201","cnm_042"],"id":"solution:coordinate-line-intersection:cae561b8403b","label":"Find the intersection with coordinates","methodDirectNodeIds":{"coordinate-line-intersection":["cnm_084","cnm_205","cnm_208","cnm_p148"]},"nodeIds":["cnm_084","cnm_205","cnm_208","cnm_