nmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"C. 199","reason":"The equation implies x²=10000(x−⌊x⌋), hence −100<x<100. Let g(x)=x−x²/10000. It is strictly increasing on this interval and has image (−101,99). Each integer k from −100 through 98 gives exactly one x with g(x)=k; since 0≤x−k=x²/10000<1, its floor is indeed k. There are 199 such integers.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"2018_AMC_12B_Q24","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"count-monotone-quadratic-levels","label":"Count integer levels of a quadratic","methodDirectNodeIds":{"count-monotone-quadratic-levels":["cnm_232"]},"nodeIds":["cnm_232"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"-2, -4, 0","reason":"Write y=a(x+1)²+2. Substituting (1,-6) gives a=-2, so y=-2x²-4x.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_233_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"general-coefficients","label":"Use general-form constraints","methodDirectNodeIds":{"general-coefficients":["cnm_232","cnm_093"]},"nodeIds":["cnm_232","cnm_093"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"1200 yuan","reason":"P=(x-30)(160-2x)=-2(x-55)²+1250. On 30≤x≤50 it is largest at x=50, giving P=20·60=1200.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_236_q4","reviewStatus":"machine_scope_audited","routes":[{"id":"vertex-and-domain","label":"Compare the vertex with the allowed interval","nodeIds":["cnm_232","cnm_196"]},{"contextNodeIds":["cnm_148","cnm_196"],"id":"solution:vertex-and-domain:0c4d33443d53","label":"Use the vertex and allowed price interval","methodDirectNodeIds":{"vertex-and-domain":["cnm_236","cnm_232","cnm_235"]},"nodeIds":["cnm_236","cnm_232","cnm_235","cnm_148","cnm_196"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"B: It is less than 0","reason":"For a>0, the minimum is -Δ/(4a). It is strictly positive exactly when Δ<0; Δ=0 would make the graph touch the axis.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_h025_q4","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_232"],"id":"axis-intersections","label":"Relate axis intersections to the discriminant","methodDirectNodeIds":{"axis-intersections":["cnm_223","cnm_234"]},"nodeIds":["cnm_223","cnm_234","cnm_232"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"D: b=+4sqrt(2) or -4sqrt(2), both irrational","reason":"Completing the square gives y=-(x-b/2)^2+b^2/4-8. Zero vertex height requires b^2=32, so b=+/-4sqrt(2).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"1957_AMC_12_Q40","reviewStatus":"machine_examined","routes":[{"id":"zero-vertex-height","label":"Set the vertex height to zero","nodeIds":["cnm_232","cnm_220"]},{"contextNodeIds":["math:completing-square-expression","cnm_231","cnm_075","cnm_169"],"id":"solution:zero-vertex-height:7a67b01b644b","label":"Find the vertex by completing the square","methodDirectNodeIds":{"zero-vertex-height":["cnm_232","cnm_220","cnm_077"]},"nodeIds":["cnm_232","cnm_220","cnm_077","math:completing-square-expression","cnm_231","cnm_075","cnm_169"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"A, -100","reason":"The quartic root sums give linear coefficients 38 for Q and 108 for P. Write Q=(x+19)^2+k. Its values at the first four roots are k+4 and k+16, whose sum must be -108, so k=-64. These are P's roots -60 and -48, giving P=(x+54)^2-36. The minima sum to -64-36=-100; these forms also produce the stated roots of Q(P(x)).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"2010_AMC_12B_Q23","reviewStatus":"machine_scope_audited","routes":[{"id":"composition-coefficients","label":"Compare quartic root sums","nodeIds":["math:polynomial-roots-coefficients","cnm_226","cnm_232"]},{"id":"symmetric-preimages","label":"Use paired roots and vertex forms","nodeIds":["cnm_231","cnm_232"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"B: 6","reason":"The conditions are b²≤4c and c²≤4b. Combining them gives b³≤64 and c³≤64, so b,c≤4. The eligible pairs are (1,1), (1,2), (2,1), (2,2), (3,3), and (4,4), totaling 6.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"2021_Fall_AMC_10A_Q20","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"vertex-minimum-constraints","label":"Nonnegative parabola minima","methodDirectNodeIds":{"vertex-minimum-constraints":["cnm_232","cnm_235","cnm_234"]},"nodeIds":["cnm_232","cnm_235","cnm_234"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"-4","reason":"With a=1, b=-2 and c=2, the discriminant is b^2-4ac=4-8=-4.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_h025_q2","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_219","cnm_232"],"id":"discriminant-calculation","label":"Calculate the discriminant","methodDirectNodeIds":{"discriminant-calculation":["cnm_223","cnm_234"]},"nodeIds":["cnm_223","cnm_234","cnm_219","cnm_232"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"C, n=32","reason":"Because 0<=f<=1, every solution lies in [0,n]. On each unit interval [j,j+1], alternating outer-function values 1 and 0, together with the quadratic pieces, give exactly 4j+2 roots, counting x=n in the last interval. The small initial bump on [0,1/2] adds no roots. Thus the total is sum from j=0 to n-1 of (4j+2)=2n^2. Since 2*31^2=1922<2012 and 2*32^2=2048>=2012, the smallest n is 32.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":["The triangular wave is continuous after the absolute value, despite the fractional-part jump; shared branch endpoints must be counted once."],"questionId":"2012_AMC_12A_Q25","reviewStatus":"machine_adjudicated","routes":[{"id":"triangular-wave-crossing-count","label":"Count crossings of the triangular wave","nodeIds":["cnm_197","cnm_h031","cnm_232"]},{"contextNodeIds":[],"id":"absolute-value-quadratic-levels","label":"Absolute-value branches and quadratic levels","methodDirectNodeIds":{"absolute-value-quadratic-levels":["cnm_008","cnm_h031","cnm_232","cnm_223"]},"nodeIds":["cnm_008","cnm_h031","cnm_232","cnm_223"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:be04d5a0c782ab93f88ec03f"],"answerCheck":{"derivedAnswer":"D, 5 ordered pairs","reason":"The second equation gives |x| + |y| = 3 or 5. With u = |x|, y = 3 - u^2/3. The level 3 gives u = 0 and 3; the level 5 gives only u = (sqrt(105) - 3)/2 > 3. These produce 1 + 2 + 2 = 5 ordered pairs.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_232"],"coverage":"aligned_concept_only","flags":[],"questionId":"2021_Fall_AMC_10A_Q14","reviewStatus":"machine_examined","routes":[{"contextNodeIds":[],"id":"quadratic-bound-and-monotonic-branches","label":"Bound one branch and count the increasing branch","methodDirectNodeIds":{"quadratic-bound-and-monotonic-branches":["cnm_220","math:completing-square-expression","cnm_232","cnm_235"]},"nodeIds":["cnm_220","math:completing-square-expression","cnm_232","cnm_235"]}]}],"canonicalNodeIds":["cnm_232"],"label":"y=ax²+bx+c 的图象与性质","layer":"CN","meaning":"Practice covers aligned canonical concepts, with no claim of complete standard coverage or mastery.","nextOffset":null,"sourceNode":{"criteria":["会配方化为顶点式","能说出顶点、对称轴和增减性"],"description":"通过配方化为顶点式，得出顶点坐标 (-b/2a, (4ac-b²)/4a)，并研究增减性。","id":"cnm_232","label":"y=ax²+bx+c 的图象与性质","original":{"chapter":"九上 第二十六章 二次函数 26.2","description":"通过配方化为顶点式，得出顶点坐标 (-b/2a, (4ac-b²)/4a)，并研究增减性。","domain":"数与代数","external":false,"grade":9,"id":"cnm_232","mastery_criteria":["会配方化为顶点式","能说出顶点、对称轴和增减性"],"name":"y=ax²+bx+c 的图象与性质","semester":"上","standards":[{"confidence":"exact","id":"cms-2022:4.NA.44"}],"type":"procedural"},"placement":{"chapter":"九上 第二十六章 二次函数 26.2","domain":"数与代数","grade":9,"semester":"上"},"reviewStatus":"source_only"},"sourceNodeId":"cnm_232","status":"mapped","total":30}
