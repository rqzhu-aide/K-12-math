_h200","cnm_h214"]},"nodeIds":["cnm_h044","cnm_h045","cnm_h200","cnm_h214"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:06c6f14574d9ae49d87a5778"],"answerCheck":{"derivedAnswer":"B (59)","reason":"Put t = log_2 x, so the sides are t, t/2, and 3. The strict triangle inequalities reduce to 2 < t < 6, hence 4 < x < 64. The integers 5 through 63 number 59.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h045"],"coverage":"aligned_concept_only","flags":[],"questionId":"2019_AMC_12B_Q09","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"logarithmic-side-substitution","label":"Use one logarithmic variable","methodDirectNodeIds":{"logarithmic-side-substitution":["cnm_111","cnm_h045","cnm_h047","cnm_h020"]},"nodeIds":["cnm_111","cnm_h045","cnm_h047","cnm_h020"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:06c6f14574d9ae49d87a5778"],"answerCheck":{"derivedAnswer":"C: 25sqrt(5)","reason":"Factoring gives 3*4^(x-1)=24, hence 2^(2x-2)=8 and x=5/2. Therefore (2x)^x=5^(5/2)=25sqrt(5).","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_h045"],"coverage":"aligned_concept_only","flags":[],"questionId":"1958_AMC_12_Q20","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"solve-exponent-with-logs","label":"Find the exponent using logs and evaluate the final fractional power","methodDirectNodeIds":{"solve-exponent-with-logs":["cnm_h043","cnm_h044","cnm_h045","cnm_h039"]},"nodeIds":["cnm_h043","cnm_h044","cnm_h045","cnm_h039"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:06c6f14574d9ae49d87a5778"],"answerCheck":{"derivedAnswer":"D, 5 points","reason":"Let t=log₃x. For x≠1, the four values are t, 1/t, -t, and -1/t. Intersections occur when t²=1, yielding (3,1), (3,-1), (1/3,1), and (1/3,-1); equations requiring t²=-1 give none. At x=1, the two constant-base logarithms also meet at (1,0), while the variable-base logarithms are undefined. There are 5 d