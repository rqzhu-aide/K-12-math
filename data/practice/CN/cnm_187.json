hodDirectNodeIds":{"parallel-isosceles-special-triangle":["cnm_058","cnm_069","cnm_138","cnm_187","cnm_139","cnm_115"]},"nodeIds":["cnm_058","cnm_069","cnm_138","cnm_187","cnm_139","cnm_115","cnm_186"]}]},{"additionalConceptCount":7,"alignmentIds":["alignment:00d1ea5d4d8f041eb72691f0"],"answerCheck":{"derivedAnswer":"C: 18","reason":"Write A=(-t,t^2), B=(t,t^2), and C=(u,u^2), with t>0. The right angle must be at C, since a vertical side at A or B would repeat that point on the graph. The two secant slopes are u-t and u+t, so u^2-t^2=-1. The altitude is therefore 1, and the area is t=2008. Thus y_C=2008^2-1=4032063, whose digits sum to 18.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_187"],"coverage":"aligned_concept_only","flags":[],"questionId":"2008_AMC_12B_Q17","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_p148","cnm_151","cnm_254"],"id":"hypotenuse-midpoint","label":"Use the midpoint of the hypotenuse","methodDirectNodeIds":{"hypotenuse-midpoint":["cnm_084","cnm_230","cnm_187","cnm_174","cnm_224"]},"nodeIds":["cnm_084","cnm_230","cnm_187","cnm_174","cnm_224","cnm_p148","cnm_151","cnm_254"]}]}],"canonicalNodeIds":["cnm_187"],"label":"直角三角形斜边上的中线","layer":"CN","meaning":"Practice covers aligned canonical concepts, with no claim of complete standard coverage or mastery.","nextOffset":null,"sourceNode":{"criteria":["能叙述并用矩形证明","能用于求线段长"],"description":"直角三角形斜边上的中线等于斜边的一半。","id":"cnm_187","label":"直角三角形斜边上的中线","original":{"chapter":"八下 第二十一章 四边形 21.3","description":"直角三角形斜边上的中线等于斜边的一半。","domain":"图形与几何","external":false,"grade":8,"id":"cnm_187","mastery_criteria":["能叙述并用矩形证明","能用于求线段长"],"name":"直角三角形斜边上的中线","semester":"下","standards":[{"confidence":"exact","id":"cms-2022:4.GG.34"}],"type":"reasoning"},"placement":{"chapter":"八下 第二十一章 四边形 21.3","domain":"图形与几何","grade":8,"semester":"下"},"reviewStatus":"source_only"},"sourceNodeId":"cnm_187","status":"mapped","total":26}
