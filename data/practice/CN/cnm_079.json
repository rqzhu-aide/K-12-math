nm_079"]},"nodeIds":["cnm_222","cnm_079"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"A, 8","reason":"Since 44² < 2023 < 45², eligible square roots are integers from 1 through 44. Divisibility of the square by 5 requires a root divisible by 5, giving 5, 10, ..., 40: eight squares.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"2023_AMC_12A_Q03","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"count-square-roots","label":"Count the square roots","methodDirectNodeIds":{"count-square-roots":["math:prime-factorization","cnm_p153","cnm_079"]},"nodeIds":["math:prime-factorization","cnm_p153","cnm_079"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"17","reason":"If k is the hypotenuse, k²=8²+15²=289, giving k=17. If 15 is the hypotenuse, k²=161, which lies strictly between 12² and 13² and gives no integer k.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_177_q3","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_075","cnm_079"],"id":"cnm_177_q3_m1","label":"Consider the possible hypotenuses","methodDirectNodeIds":{"cnm_177_q3_m1":["cnm_174"]},"nodeIds":["cnm_174","cnm_075","cnm_079"]}]},{"additionalConceptCount":2,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"B, yes; hypotenuse √5","reason":"(√2)²+(√3)²=2+3=5=(√5)², so the triangle is right with hypotenuse √5.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"cnm_178_q1","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_168","cnm_079"],"id":"cnm_178_q1_m1","label":"Square the radical side lengths","methodDirectNodeIds":{"cnm_178_q1_m1":["cnm_177"]},"nodeIds":["cnm_177","cnm_168","cnm_079"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"E, one real root, x=3","reason":"The original equation requires 2≤x≤4. Squaring √(x−2)=4−x gives (x−3)(x−6)=0; only x=3 satisfies the original equation.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1950_AMC_12_Q24","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":[],"id":"monotonicity-and-test","label":"Use monotonicity and test a root","methodDirectNodeIds":{"monotonicity-and-test":["cnm_h033","cnm_079","cnm_039"]},"nodeIds":["cnm_h033","cnm_079","cnm_039"]},{"contextNodeIds":["cnm_167","cnm_074","cnm_039"],"id":"compare-with-three","label":"Compare possible roots with 3","methodDirectNodeIds":{"compare-with-three":["math:radical-equations","cnm_079"]},"nodeIds":["math:radical-equations","cnm_079","cnm_167","cnm_074","cnm_039"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"C (2sqrt(3))","reason":"The common domain is [6,8]. There, 8x-x^2=16-(x-4)^2 is at most 12, and the second radical is nonnegative. Thus f(x) is at most sqrt(12), with equality at x=6.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1993_AMC_12_Q26","reviewStatus":"machine_scope_audited","routes":[{"id":"quadratic-upper-bound","label":"Bound the first radical","nodeIds":["math:completing-square-expression","cnm_235","cnm_079"]},{"contextNodeIds":["cnm_167","cnm_148","cnm_169"],"id":"solution:quadratic-upper-bound:f51e51d0c7ab","label":"Find the domain and an attained upper bound","methodDirectNodeIds":{"quadratic-upper-bound":["cnm_195","math:completing-square-expression","cnm_235","cnm_079"]},"nodeIds":["cnm_195","math:completing-square-expression","cnm_235","cnm_079","cnm_167","cnm_148","cnm_169"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"A, 13 miles","reason":"The angle at the airport is 90 degrees, so the downtown distance is sqrt(8^2 + 10^2) = sqrt(164), approximately 12.81 miles. The closest choice is 13.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"2004_AMC_10B_Q08","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p082","cnm_174","cnm_079"],"id":"airport-right-triangle","label":"Use the right angle at the airport","methodDirectNodeIds":{"airport-right-triangle":["cnm_176"]},"nodeIds":["cnm_176","cnm_p082","cnm_174","cnm_079"]}]},{"additionalConceptCount":3,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"B: x = log(7/3) / log(1 + r/10)","reason":"For a base b > 1, the solution is log(7/3)/log(b), which decreases as b increases. Here r/10 is smaller than r, 2r, sqrt(r), and 1/r: the last two comparisons follow from r < 100 and r^2 < 9 < 10. Therefore B has the smallest base and largest solution.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"2009_AMC_12B_Q15","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_h041","cnm_096","cnm_079"],"id":"solution:compare-exponential-bases:0e0dd810eed3","label":"Compare the bases","methodDirectNodeIds":{"compare-exponential-bases":["cnm_h042"]},"nodeIds":["cnm_h042","cnm_h041","cnm_096","cnm_079"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"D, 5 under the inferred-precision interpretation; the original measurement's significant figures are not uniquely recoverable","reason":"An area rounded to 1.1025 lies approximately in [1.10245,1.10255), giving side lengths in [1.049976,1.050024). These consistently round to 1.0500 inches, which has five significant digits.","status":"ambiguous"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":["Five significant digits is justified for a side value reported from the stated area precision. The wording does not uniquely specify how many significant digits were present in the original side measurement."],"questionId":"1953_AMC_12_Q29","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_074","cnm_p089","cnm_p133"],"id":"rounding-bounds","label":"Distinguish original precision from inferred precision","methodDirectNodeIds":{"rounding-bounds":["cnm_023","cnm_079"]},"nodeIds":["cnm_023","cnm_079","cnm_074","cnm_p089","cnm_p133"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"C: 6","reason":"The lower bound gives (k-20)(k-50)≤0, hence 20≤k≤50. The strict upper bound gives (k-34)^2>155, so integer k must satisfy k≤21 or k≥47. Thus k is 20, 21, 47, 48, 49, or 50, yielding six distinct positive n.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"2020_AMC_10B_Q24","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_079"],"id":"integer-square-bounds","label":"Completed-square integer bounds","methodDirectNodeIds":{"integer-square-bounds":["math:floor-ceiling","math:integer-diophantine-equations","math:completing-square-expression","cnm_h020"]},"nodeIds":["math:completing-square-expression","cnm_079","math:floor-ceiling","math:integer-diophantine-equations","cnm_h020"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"B, 337","reason":"Write r+1=3k and s+1=2k. Let T span x=-u to x=v, with t=u+v. The overlap fractions give u+1=12(v+1), so t+1≡-1 modulo 13. Union counting gives 4(t+1)²=13k²-2k. Consequently k is even and k≡11 modulo 13. The only positive candidate below 50 is 24, but it gives (t+1)²=1860, not a square. Since the total increases with k, the first possible minimum is attained at k=50: take (r,s,t)=(149,99,89) and (u,v)=(83,6). These satisfy all conditions and give 149+99+89=337.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"2022_AMC_10A_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"bounded-square-test","label":"Complete the square and test smaller candidates","methodDirectNodeIds":{"bounded-square-test":["cnm_221","cnm_079"]},"nodeIds":["cnm_221","cnm_079"]}]},{"additionalConceptCount":4,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"A, 84","reason":"Put p=BP and q=DQ. The equations AP²-p²=900 and AQ²-q²=784, with 0<p<28 and 0<q<30, give (p,AP)=(16,34) and (q,AQ)=(21,35) by factor pairs. Thus PC=12, CQ=9, and PQ=15. The perimeter is 34+35+15=84.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"2023_AMC_10A_Q17","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":[],"id":"bounded-square-search","label":"Check squares within the side bounds","methodDirectNodeIds":{"bounded-square-search":["cnm_174","math:integer-diophantine-equations","cnm_075","cnm_079","cnm_055"]},"nodeIds":["cnm_075","cnm_079","cnm_174","math:integer-diophantine-equations","cnm_055"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"E","reason":"For a fixed positive product, AM-GM makes the sum smallest, not greatest, when the quantities are equal. For example, products 1·1 and 2·(1/2) are equal, but their sums are 2 and 2.5. In D, the difference between the two sides is (a-b)²/4>0.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1951_AMC_12_Q43","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_148","cnm_079"],"id":"verify-claims-with-squares","label":"Check the inequality directions and equality cases","methodDirectNodeIds":{"verify-claims-with-squares":["cnm_h018","cnm_h021","cnm_h022","cnm_h019"]},"nodeIds":["cnm_h018","cnm_h021","cnm_h022","cnm_h019","cnm_148","cnm_079"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"B, x=1/8","reason":"Set t=√(2x)≥0. Then 2t²+t-1=(2t-1)(t+1)=0, so t=1/2 and x=1/8. Indeed, 4(1/8)+√(1/4)=1.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1959_AMC_12_Q38","reviewStatus":"machine_adjudicated","routes":[{"contextNodeIds":["cnm_167","cnm_074","cnm_003"],"id":"compare-with-one-half","label":"Compare both terms with one half","methodDirectNodeIds":{"compare-with-one-half":["math:radical-equations","cnm_079","cnm_096"]},"nodeIds":["math:radical-equations","cnm_079","cnm_096","cnm_167","cnm_074","cnm_003"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"D, 1","reason":"Put A=x^2+3x+1, so P=A^2+30-3x. Consecutive-square bounds exclude x≤-7, 3≤x≤9, and x≥11. For -6≤x≤2, P is 409,166,67,40,37,34,31,52,145, none square. At x=10, P=131^2. Thus exactly one integer x works.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1965_AMC_12_Q40","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_029","cnm_096"],"id":"nearby-integer-squares","label":"Compare with nearby squares","methodDirectNodeIds":{"nearby-integer-squares":["math:integer-diophantine-equations","cnm_148","cnm_h019","cnm_079"]},"nodeIds":["math:integer-diophantine-equations","cnm_148","cnm_h019","cnm_079","cnm_029","cnm_096"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"B, 9","reason":"The product is 2^((n+1)²/7). At n=7 its exponent is 64/7<19/2, so the product is less than 512sqrt(2)<1000. At n=9 its exponent is 100/7>10, so it exceeds 1024. Monotonicity makes 9 the smallest eligible odd integer.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1976_AMC_12_Q21","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_h039","cnm_079","cnm_p156"],"id":"sum-exponents-and-bound","label":"Combine the powers and compare neighboring odd values","methodDirectNodeIds":{"sum-exponents-and-bound":["cnm_h204","math:real-exponent-laws","cnm_h042"]},"nodeIds":["cnm_h204","math:real-exponent-laws","cnm_h042","cnm_h039","cnm_079","cnm_p156"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"B: 2","reason":"Each block must be in {16,25,36,49,64,81}. The first block restricts the square root to 400–412, 500–509, 600–608, 700–707, 800–806, or 900–905. Checking these 53 integers leaves only 408²=166464 and 804²=646416.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1980_AMC_12_Q30","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_020","cnm_p096","cnm_p153"],"id":"square-root-and-blocks","label":"Use the first block to constrain the square root","methodDirectNodeIds":{"square-root-and-blocks":["math:integer-diophantine-equations","cnm_079","cnm_148"]},"nodeIds":["math:integer-diophantine-equations","cnm_079","cnm_148","cnm_020","cnm_p096","cnm_p153"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"D, 9","reason":"Let α=15+√220, β=15-√220, and S_n=α^n+β^n. Then S_n=30S_(n-1)-5S_(n-2), with S_1=30 and S_2=890, so every S_n for n≥1 is an integer divisible by 10. Since 0<β^19+β^82<1, the requested number has integer part S_19+S_82-1, ending in 9.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1982_AMC_12_Q30","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_079","cnm_p153","cnm_143"],"id":"binomial-conjugate-cancellation","label":"Cancel the radicals by binomial expansion","methodDirectNodeIds":{"binomial-conjugate-cancellation":["cnm_h240","math:modular-congruence","math:floor-ceiling"]},"nodeIds":["cnm_h240","math:modular-congruence","math:floor-ceiling","cnm_079","cnm_p153","cnm_143"]},{"contextNodeIds":["cnm_147","cnm_032","cnm_079","cnm_p153"],"id":"solution:conjugate-power-recurrence:c6edb0b208bf","label":"Build a recurrence for the conjugate power sums","methodDirectNodeIds":{"conjugate-power-recurrence":["math:polynomial-roots-coefficients","cnm_h200","cnm_h214","math:modular-congruence","math:floor-ceiling"]},"nodeIds":["math:polynomial-roots-coefficients","cnm_h200","cnm_h214","math:modular-congruence","math:floor-ceiling","cnm_147","cnm_032","cnm_079","cnm_p153"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"D. 11","reason":"The inequality is (n²)^100<125^100, equivalent to n²<125. Since 11²=121<125<144=12², the largest integer n is 11.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1984_AMC_12_Q05","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_019","cnm_074","cnm_009"],"id":"1984_AMC_12_Q05_m1","label":"Reduce the large powers","methodDirectNodeIds":{"1984_AMC_12_Q05_m1":["cnm_h020","cnm_143","cnm_079"]},"nodeIds":["cnm_h020","cnm_143","cnm_079","cnm_019","cnm_074","cnm_009"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"E (12 or more)","reason":"Rotate the card 45 degrees and center it at a grid vertex. Its half-diagonal is 3sqrt(2)/4>1, so it overlaps four central cells and two additional cells at each of its four tips. These 12 positive-area overlaps force choice E.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"1993_AMC_8_Q25","reviewStatus":"machine_scope_audited","routes":[{"contextNodeIds":["cnm_p077","cnm_p088","cnm_079"],"id":"rotated_card_and_reach_bound","label":"Rotate the card and bound its reach","methodDirectNodeIds":{"rotated_card_and_reach_bound":["math:extremal-principle","cnm_174","cnm_p171"]},"nodeIds":["math:extremal-principle","cnm_174","cnm_p171","cnm_p077","cnm_p088","cnm_079"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"A, approximately 13 miles","reason":"The two airport-to-downtown segments meet at 90°. The downtown distance is √(8²+10²)=√164≈12.81 miles, closest to 13.","status":"matches"},"assessed":false,"bank":"amc","canonicalNodeIds":["cnm_079"],"coverage":"aligned_concept_only","flags":[],"questionId":"2004_AMC_12B_Q06","reviewStatus":"machine_examined","routes":[{"contextNodeIds":["cnm_174","cnm_p049","cnm_075"],"id":"right-triangle","label":"Use the right triangle","methodDirectNodeIds":{"right-triangle":["cnm_176","cnm_p082","cnm_079"]},"nodeIds":["cnm_176","cnm_p082","cnm_079","cnm_174","cnm_p049","cnm_075"]}]},{"additionalConceptCount":5,"alignmentIds":["alignment:bd3b1fbea133df8281af6ce4"],"answerCheck":{"derivedAnswer":"D. 2-√2","reason":"√9=3, ∛(-8)=-2, and |1-√2|=√2-1, so the result is 3-2-(√2-1)=2-√2.","status":"matches"},"assessed":false,"bank":"cn-math","canonicalNodeIds":["cnm_079"],"coverage":"alig