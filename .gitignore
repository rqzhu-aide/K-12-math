# Publish only the database, practice application, template, and release notices.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Start Math Practice.cmd
!/database/
!/math-practice/
!/question-bank-template/

