# Only the harness, runtime, template, and published question banks belong here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/VERSION
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Start Math Practice.cmd
!/math-practice/
!/scripts/
!/cn-math-bank/
!/amc-bank/
!/docs/
!/question-bank-template/
!/knowledge-graph/
/knowledge-graph/*
!/knowledge-graph/README.md
!/knowledge-graph/curriculum-manifest.json
!/knowledge-graph/evidence-index.json
!/knowledge-graph/evidence/

/question-bank-template/*
!/question-bank-template/README.md
!/question-bank-template/EXPLANATION_STYLE.md
!/question-bank-template/*.schema.json
!/question-bank-template/example/
/question-bank-template/example/*
!/question-bank-template/example/bank.json
!/question-bank-template/example/questions/
!/question-bank-template/example/figures/

# Banks installed by users are local content, never included automatically.
/custom-banks/

/docs/*
!/docs/images/
/docs/images/*
!/docs/images/interactive-practice.png

/math-practice/*
!/math-practice/*.html
!/math-practice/*.css
!/math-practice/*.js
!/math-practice/config.example.json
!/math-practice/Start Math Practice.cmd
!/math-practice/vendor/
!/math-practice/test/

/scripts/*
!/scripts/serve_math_practice.py
!/scripts/launch_math_practice.py
!/scripts/connection_settings.py
!/scripts/student_assessment.py
!/scripts/model_connections.py
!/scripts/openai_connection.py
!/scripts/chatgpt_plan.py
!/scripts/practice_tutor.py
!/scripts/tutor_context.py
!/scripts/knowledge_graph.py
!/scripts/curriculum_graph.py
!/scripts/build_curriculum_sources.py
!/scripts/knowledge_graph_questions.py
!/scripts/graph_evidence.py
!/scripts/question_answers.py
!/scripts/question_banks.py
!/scripts/import_question_bank.py
!/scripts/export_amc_bank.py
!/scripts/test_*.py

/cn-math-bank/*
!/cn-math-bank/bank.js
!/cn-math-bank/questions/
!/cn-math-bank/figures/
!/cn-math-bank/schema/
!/cn-math-bank/taxonomy/
!/cn-math-bank/LICENSE
!/cn-math-bank/NOTICE.md
!/cn-math-bank/README.md

/amc-bank/*
!/amc-bank/README.md
!/amc-bank/ADAPTATIONS.md
!/amc-bank/EXPLANATION_REVIEW.md
!/amc-bank/NOTICE.md
!/amc-bank/LICENSE
!/amc-bank/bank.js
!/amc-bank/sources.json
!/amc-bank/schema.json
!/amc-bank/taxonomy/
!/amc-bank/questions/
!/amc-bank/figures/
!/amc-bank/official-solutions/

# Never commit machine settings, credentials, sessions, or generated evidence.
local-service/
setting.yaml
setting.yml
settings.yaml
settings.yml
config.json
config.tmp
config.local.*
settings.json
.env
.env.*
*.key
*.pem
*api_key*
auth.json
secrets.*
.local/
local/
__pycache__/
*.py[cod]
*.log
*.tmp
*.bak
*.backup
.DS_Store
Thumbs.db
.idea/
.vscode/
.codex/
.agents/
.impeccable/
.taste-skill/
node_modules/
.venv/
venv/
reports/
screenshots/

# Raw source collections and private processing work remain outside this release.
amc-bank.js
AMC original questions/
question bank/
source/
staging/
translations/
architecture/
archived/

# Reviewed graph records are release inputs, unlike raw source collections.
!/knowledge-graph/source/
/knowledge-graph/source/*
!/knowledge-graph/source/alignments.json
!/knowledge-graph/source/curricula.json
!/knowledge-graph/source/mappings.jsonl
!/knowledge-graph/source/metadata.json
!/knowledge-graph/source/nodes.json
!/knowledge-graph/source/relationships.json
