  "Question": "\\(A\\) has 3 elements, \\(B\\) has 3 elements, and their intersection has 2 elements. How many elements are in their union?",
  "Choices": {},
  "Correct Answer": "4",
  "Accepted Answers": [],
  "Unordered Answers": false,
