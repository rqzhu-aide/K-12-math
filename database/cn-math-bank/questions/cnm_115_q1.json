  "Question": "Two angles of a triangle are \\(50^\\circ\\) and \\(60^\\circ\\). What is the third angle (unit: degrees)?",
  "Choices": {},
  "Correct Answer": "70",
  "Accepted Answers": [],
  "Unordered Answers": false,
