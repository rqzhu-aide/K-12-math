  "language": "en",
  "question": {
    "prompt": "The graph of the linear function \\(y=kx+b\\) passes through \\((1,2)\\) and \\((3,-2)\\). The solution set of the inequality \\(kx+b>0\\) is \\(x<a\\). Find the value of \\(a\\)."
  },
  "schemaVersion": "3.0",
