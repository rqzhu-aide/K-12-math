  "Question": "Which of the following pairs of angles are complementary?",
  "Choices": {
    "A": "\\(45^\\circ\\) and \\(135^\\circ\\)",
    "B": "\\(30^\\circ\\) and \\(60^\\circ\\)",
    "C": "\\(100^\\circ\\) and \\(80^\\circ\\)",
    "D": "\\(20^\\circ\\) and \\(80^\\circ\\)"
