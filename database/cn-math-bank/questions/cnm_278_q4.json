  "question": {
    "prompt": "In right triangle \\(ABC\\), \\(\\angle C=90^\\circ\\), \\(AC=3\\), and \\(AB=6\\). Find the measure of \\(\\angle A\\) in degrees."
  },
  "schemaVersion": "3.0",
