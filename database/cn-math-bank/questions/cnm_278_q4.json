        "cnm_277"
      ],
      "explanation": "\\(\\cos A=AC/AB=3/6=1/2\\), so \\(\\angle A=60^\\circ\\).",
      "id": "cosine-ratio",
      "sourceRef": "cn-math/cnm_278_q4#cosine-ratio",
      "title": "Cosine ratio"
    },
    {
      "directNodeIds": [
