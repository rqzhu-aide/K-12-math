  "question": {
    "prompt": "Find the inradius of a right triangle with legs 5 and 12."
  },
  "schemaVersion": "3.0",
  "solutions": [
    {
      "directNodeIds": [
        "cnm_264"
      ],
      "explanation": "The hypotenuse is 13, and \\(r=(5+12-13)/2=2\\).",
      "id": "right-triangle-inradius-formula",
      "sourceRef": "cn-math/cnm_264_q3#right-triangle-inradius-formula",
      "title": "Right-triangle inradius formula"
    },
    {
      "directNodeIds": [
        "cnm_264",
        "math:triangle-area-radius-relations",
        "cnm_p150"
      ],
      "explanation": "Joining the incenter to the three vertices divides the triangle into three smaller triangles, each with height equal to the inradius \\(r\\) when its original side is used as the base. The hypotenuse is \\(\\sqrt{5^2+12^2}=13\\). Equating the whole area to the sum of the smaller areas gives\n\\[\n\\frac{5\\times12}{2}=\\frac{5r}{2}+\\frac{12r}{2}+\\frac{13r}{2}=15r.\n\\]\nThus \\(30=15r\\), and the inradius is \\(r=2\\).",
      "id": "common-height-area-decomposition",
      "sourceRef": "cn-math/cnm_264_q3#common-height-area-decomposition",
      "title": "Use the inradius as a common height"
    },
    {
