  "question": {
    "prompt": "In the dissection proof of the Pythagorean theorem using \\((a+b)^2\\), if \\(a+b=7\\) and \\(ab=12\\), what is the value of \\(c^2=a^2+b^2\\)?"
  },
  "schemaVersion": "3.0",
  "solutions": [
    {
      "directNodeIds": [
        "cnm_148"
      ],
      "explanation": "\\(a^2+b^2=(a+b)^2-2ab=49-24=25\\), so \\(c^2=25\\).",
