  "question": {
    "prompt": "$X$ follows $B(2,1/2)$. What is $P(X=1)$?"
  },
  "schemaVersion": "3.0",
  "solutions": [
    {
      "directNodeIds": [
        "cnm_h255"
      ],
      "explanation": "$C(2,1)\\times1/4=1/2$.",
      "id": "cnm_h255_q3_m1",
      "sourceRef": "cn-math/cnm_h255_q3#cnm_h255_q3_m1",
      "title": "Binomial probability formula"
    },
    {
      "directNodeIds": [
        "cnm_h255",
        "cnm_286"
      ],
      "explanation": "Let \\(S\\) mean success and \\(F\\) mean failure. Each has probability \\(1/2\\). The two independent trials give exactly four sequences, \\(SS,SF,FS,FF\\), each with probability \\((1/2)^2=1/4\\). The list covers both possibilities for each trial once. Exactly one success occurs in \\(SF\\) or \\(FS\\), so\n\\[\nP(X=1)=\\frac{2}{4}=\\frac12.\n\\]",
      "id": "cnm_h255_q3_m2",
      "sourceRef": "cn-math/cnm_h255_q3#cnm_h255_q3_m2",
      "title": "Enumerate the outcomes"
    }
