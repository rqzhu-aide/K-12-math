  "question": {
    "prompt": "Simplify \\(x(2x-3)-2x(x-1)\\), and find its value when \\(x=5\\)."
  },
  "schemaVersion": "3.0",
  "solutions": [
    {
      "directNodeIds": [
        "cnm_145",
        "cnm_036"
      ],
      "explanation": "\\(x(2x-3)-2x(x-1)=2x^2-3x-2x^2+2x=-x\\). When \\(x=5\\), the value is \\(-5\\).",
      "id": "expand-and-combine",
      "sourceRef": "cn-math/cnm_145_q3#expand-and-combine",
      "title": "Expand and combine"
    },
    {
      "directNodeIds": [
        "cnm_151",
        "cnm_035",
        "cnm_034"
      ],
      "explanation": "Both terms have a factor \\(x\\), so factor it out to simplify one bracket:\n\\[\nx(2x-3)-2x(x-1)=x\\bigl[(2x-3)-2(x-1)\\bigr].\n\\]\nThe bracket equals \\(2x-3-2x+2=-1\\). Thus the expression is \\(-x\\), and when \\(x=5\\), its value is \\(-5\\).",
      "id": "factor-common-x",
      "sourceRef": "cn-math/cnm_145_q3#factor-common-x",
      "title": "Factor out x"
