  "question": {
    "prompt": "In a recruitment process, the written test, interview, and practical assessment are weighted in the ratio $2:3:5$. A person's scores on these three components are 85, 90, and 80 points, respectively. What is the overall score in points?"
  },
  "schemaVersion": "3.0",
  "solutions": [
    {
      "directNodeIds": [
        "cnm_212"
      ],
      "explanation": "The overall score is $(85\\times2+90\\times3+80\\times5)\\div(2+3+5)=840\\div10=84$.",
      "id": "ratio-weights",
      "sourceRef": "cn-math/cnm_212_q3#ratio-weights",
      "title": "Use the ratio as weights"
    }
