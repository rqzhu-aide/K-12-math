  "Question": "Which quantifier is used in “Some right triangles are isosceles triangles”?",
  "Choices": {
    "A": "Universal quantifier",
    "B": "Negation quantifier",
    "C": "Existential quantifier",
    "D": "No quantifier"
  },
  "Correct Answer": "C",
  "Accepted Answers": [],
  "Unordered Answers": false,
  "Solution": "“Some” indicates that at least one exists, so it is an existential quantifier. Isosceles right triangles do exist.",
