  "Question": "If a rational number \\(a\\) satisfies \\(|a|=-a\\), which type of number must \\(a\\) be?",
  "Choices": {
    "A": "A positive number",
    "B": "A negative number",
    "C": "A nonpositive number (a negative number or \\(0\\))",
    "D": "A nonnegative number"
