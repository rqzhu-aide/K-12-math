  "Question": "What is the ones digit of \\[\\begin{align*} & 222,222 - 22,222 - 2,222 \\\\ &- 222 - 22 - 2? \\end{align*}\\]",
  "Question Type": "text",
  "Choices": {
    "A": "\\(0\\)",
