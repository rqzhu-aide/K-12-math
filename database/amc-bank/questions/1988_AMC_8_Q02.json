  "Question": "What is the product \\(8 \\times 0.25 \\times 2 \\times 0.125?\\)",
  "Question Type": "text",
  "Choices": {
    "A": "\\(\\dfrac{1}{8}\\)",
    "B": "\\(\\dfrac{1}{4}\\)",
    "C": "\\(\\dfrac{1}{2}\\)",
