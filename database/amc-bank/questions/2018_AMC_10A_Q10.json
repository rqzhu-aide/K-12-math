  "question": {
    "prompt": "Suppose that real number \\(x\\) satisfies \\[\\sqrt{49-x^2}-\\sqrt{25-x^2}=3.\\] What is the value of \\[\\sqrt{49-x^2}+\\sqrt{25-x^2}?\\]",
    "choices": [
      {
