  "Question": "What is the smallest prime number dividing the sum \\(3^{11}+5^{13}?\\)",
  "Question Type": "text",
  "Choices": {
    "A": "\\(2\\)",
    "B": "\\(3\\)",
    "C": "\\(5\\)",
    "D": "\\(3^{11}+5^{13}\\)",
