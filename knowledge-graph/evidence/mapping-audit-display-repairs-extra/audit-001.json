  "raw": "{\n  \"audits\": [\n    {\n      \"questionId\": \"q001\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\n        \"cnm_p149\",\n        \"cnm_p089\",\n        \"cnm_p215\"\n      ],\n      \"supportIds\": [\n        \"cnm_p111\"\n      ],\n      \"routes\": [],\n      \"derivedAnswer\": \"C: 40¢ per cookie.\",\n      \"mathematicalReason\": \"Art's trapezoid has area (3 + 5) × 3 ÷ 2 = 12 square inches. Roger's rectangle has area 4 × 2 = 8 square inches. Equal dough amounts and equal thickness give equal total cookie area per batch, so Roger makes 12 × 12 ÷ 8 = 18 cookies. Art earns 12 × 60 = 720 cents; Roger therefore needs to charge 720 ÷ 18 = 40 cents each. The two area procedures and practical proportional reasoning are defensible assessed scopes, with total price = unit price × quantity as support. Images 3 and 4 are not needed.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 1,\n          \"fact\": \"Art's trapezoid has parallel bases labeled 3 inches and 5 inches. The right side is labeled 3 inches and has a right-angle marker at the lower base, identifying the perpendicular height.\"\n        },\n        {\n          \"imageSlot\": 2,\n          \"fact\": \"Roger's rectangle has side lengths labeled 4 inches and 2 inches.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q002\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\n        \"cnm_055\",\n        \"cnm_p073\"\n      ],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"E: 39 inches.\",\n      \"mathematicalReason\": \"The small kite's opposite-corner segments measure 7 inches vertically and 6 inches horizontally, counting grid intervals rather than dots. Tripling both grid dimensions triples these lengths, giving 21 inches and 18 inches. The total bracing length is 21 + 18 = 39 inches. Segment-length measurement and