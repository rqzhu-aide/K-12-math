  "raw": "{\n  \"audits\": [\n    {\n      \"questionId\": \"q001\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p150\", \"cnm_p148\"],\n      \"supportIds\": [\"cnm_p089\", \"cnm_p073\"],\n      \"routes\": [],\n      \"derivedAnswer\": \"D: 189 square inches.\",\n      \"mathematicalReason\": \"The small grid measures 6 inches by 7 inches, so the enlarged rectangle measures 18 inches by 21 inches and has area 378 square inches. Splitting the enlarged kite along its horizontal diagonal gives two triangles with common base 18 inches and heights 6 and 15 inches. Their combined area is (18×6)/2 + (18×15)/2 = 189 square inches. Thus the waste area is 378−189 = 189 square inches. This validates the candidate's composite-area and triangle-area scopes, with rectangle area and multiplication by three as supporting skills. No separate similarity theorem is needed for this method.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 1,\n          \"fact\": \"The grid has seven dot columns and eight dot rows, giving six horizontal and seven vertical one-inch intervals.\"\n        },\n        {\n          \"imageSlot\": 1,\n          \"fact\": \"The left and right kite vertices span the grid's full width on the row two intervals below the top vertex and five intervals above the bottom vertex. These give the common triangle base and the two perpendicular heights.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q002\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p149\", \"cnm_p148\", \"cnm_p214\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"E: 24 cookies.\",\n      \"mathematicalReason\": \"Art's trapezoidal cookie has area ((3+5)×3)/2 = 12 square inches. His 12 cookies therefore have total area 144 square inches. Equal dough amounts and equal thickness imply equal total cookie areas. 