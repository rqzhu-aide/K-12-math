  "raw": "{\n  \"audits\": [\n    {\n      \"questionId\": \"q001\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p112\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"12\",\n      \"mathematicalReason\": \"The parentheses give 2+3=5. Multiplication and division have equal precedence, so 30÷5×2=6×2=12. This directly matches three-step mixed integer arithmetic with parentheses.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": []\n    },\n    {\n      \"questionId\": \"q002\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_h067\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — Increasing\",\n      \"mathematicalReason\": \"Sine is strictly increasing on the entire standard interval [-π/2, π/2], from -1 to 1. Recognizing this interval of monotonicity directly matches cnm_h067.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": []\n    },\n    {\n      \"questionId\": \"q003\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p133\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"3.84\",\n      \"mathematicalReason\": \"Since 16×24=384 and the two factors have two decimal places in total, 1.6×2.4=384/100=3.84. Decimal-by-decimal multiplication and decimal-point placement are precisely within cnm_p133.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": []\n    },\n    {\n      \"questionId\": \"q004\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p039\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"D — 12\",\n      \"mathematicalReason\": \"4×3=12. This is a multiplication-table fact with factors within 2 through 6, matching cnm_p039.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": []\n    },\n    {\n      \"questionId\": \"q005\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_h250\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"1/6\",\n      \"mathematicalReason\": \"The three listed values exhaust the possible values of X, so their probabilities sum to 1. Thus P(X=3)=1-1/2-1/3=1/6, which is nonnegative. Completing a missing probability using normalization directly matches cnm_h250.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": []\n    },\n    {\n      \"questionId\": \"q006\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p106\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"6\",\n      \"mathematicalReason\": \"25×6=150, so 150÷25=6 with no remainder. The calculation is a three-digit dividend divided by a two-digit divisor, as covered by cnm_p106; no particular quotient-finding method is mandated.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": []\n    },\n    {\n      \"questionId\": \"q007\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p031\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — Carry 1 to the tens place\",\n      \"mathematicalReason\": \"7+5=12 ones, equivalent to 1 ten and 2 ones. Therefore 1 is carried to the tens place. This directly matches the carrying criterion within cnm_p031, without requiring calculation of the full sum.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [\n        \"The carrying rule is supplied in the stem, so the item provides evidence of prompted recognition rather than independent mastery of mental addition.\"\n      ],\n      \"figureEvidence\": []\n    },\n    {\n      \"questionId\": \"q008\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p006\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"5 centimeters\",\n      \"mathematicalReason\": \"2+3=5, so the combined length is 5 centimeters. Both lengths already use the requested unit; neither conversion nor geometric reasoning is needed. The assessed calculation is addition with a result no greater than 5, matching cnm_p006.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": []\n    }\n  ]\n}",
