  "raw": "{\n  \"audits\": [\n    {\n      \"questionId\": \"q001\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p007\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"2\",\n      \"mathematicalReason\": \"The difference is 5 − 3 = 2 blocks. Both counts and the subtraction expression are supplied, so subtraction within 5 is directly assessed; reconstructing a solid from views is not needed.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 1,\n          \"fact\": \"The row labeled Front contains five squares, and the row labeled Side contains three squares, confirming the supplied counts.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q002\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_h122\"],\n      \"supportIds\": [\"cnm_p160\"],\n      \"routes\": [],\n      \"derivedAnswer\": \"4\",\n      \"mathematicalReason\": \"For any chosen base of a cube, the opposite face is parallel to it. Each of the other four faces contains an edge perpendicular to the base, so the perpendicular-plane criterion establishes that these four faces are perpendicular to the base. This validates the candidate's selected criterion-based method, with cube structure supporting the count; direct recognition of cube properties is also valid.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 2,\n          \"fact\": \"The cube wireframe has matching edge-length tick marks and shows the incidence of adjacent and opposite faces. No particular base is marked; taking the lower face as base illustrates the count. Perpendicularity follows from the stated cube geometry, not from projected angles.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q003\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_h105\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"2\",\n      \"mathematicalReason\": \"One lateral face has two lateral boundary edges joining corresponding vertices of the two bases. In a rectangular prism, both are perpendicular to the base. The other two boundary edges run along the bases. Thus the requested count is 2, and the prism-structure scope fits without requiring a perpendicular-plane proof.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 3,\n          \"fact\": \"The front lateral face labeled This face has two upright lateral boundary edges, one at each end. Rear edges visible through its projection are not additional edges of that face.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q004\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p105\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — Opposite sides are parallel and equal in length.\",\n      \"mathematicalReason\": \"A parallelogram has two pairs of opposite parallel sides, and each pair of opposite sides is equal in length. This is precisely the elementary property covered by cnm_p105.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 4,\n          \"fact\": \"Matching single arrows mark the upper and lower sides as parallel; matching double arrows mark the slanted sides as parallel. Matching length ticks also mark the upper and lower sides as equal.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q005\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p101\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — An obtuse angle is larger than a right angle.\",\n      \"mathematicalReason\": \"A right angle measures 90°, whereas an obtuse angle measures more than 90° and less than 180°. Therefore an obtuse angle is larger. The defining angle classifications directly match cnm_p101.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 5,\n          \"fact\": \"The left angle is labeled Obtuse and has its interior opening marked by an arc. The angle labeled Right has a square right-angle marker.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q006\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_h114\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — May be skew; in fact, the stated conditions force them to be skew.\",\n      \"mathematicalReason\": \"The supporting lines lie in the distinct parallel planes of the top and bottom bases, so they cannot intersect. The stem also excludes parallel lines. Consequently they are skew, directly matching the relative-positions scope. For example, DC and AE satisfy the stated conditions in the diagram. Choice A is weaker than the conclusion but is the only correct option.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 6,\n          \"fact\": \"The diagram labels the top base DCGH and the bottom base ABFE. DC is a top-base edge and AE is a bottom-base edge in a different edge direction; they do not belong to the same lateral face.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q007\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p132\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"31.4\",\n      \"mathematicalReason\": \"The supplied product is 6.28 × 5 = 31.40 = 31.4, so the lateral surface area is 31.4 cm². Because the rectangle and multiplication expression are already supplied, decimal-by-integer multiplication is the direct assessment. No circumference calculation or cylinder-surface formula is needed.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 7,\n          \"fact\": \"The figure labeled Unrolled side is a rectangle with one side labeled 6.28 cm and an adjacent side labeled 5 cm.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q008\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p077\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — Opposite sides are equal in length.\",\n      \"mathematicalReason\": \"A rectangle has equal opposite sides and four right angles. The requested opposite-side equality directly matches cnm_p077; no more advanced rectangle properties are needed.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 8,\n          \"fact\": \"Matching single ticks mark the top and bottom sides as equal, while matching double ticks mark the left and right sides as equal. A square marker indicates a right angle at the upper-left corner.\"\n        }\n      ]\n    }\n  ]\n}",
