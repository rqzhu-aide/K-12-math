  "raw": "{\n  \"audits\": [\n    {\n      \"questionId\": \"q001\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p042\", \"cnm_p074\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"80 cm³\",\n      \"mathematicalReason\": \"A valid computation is 8 × 5 = 40, followed by 40 × 2 = 80. These steps fit the multiplication-fact and multidigit-by-one-digit scopes, respectively. Because the expression is supplied, independently selecting a capacity formula is not elicited. This computation is a valid method, not the only possible method.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 1,\n          \"fact\": \"The rectangular-prism diagram labels its three dimensions as 8 cm, 5 cm, and 2 cm, matching the supplied multiplication.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q002\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p039\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"4 cm²\",\n      \"mathematicalReason\": \"The supplied calculation gives 2 × 2 = 4, a fact within the 2–6 multiplication tables. Although the context is the area of a square face, the student need not independently select an area formula.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 2,\n          \"fact\": \"The cube has an edge labeled 2 cm and matching tick marks indicating equal edge lengths, consistent with a face having side lengths 2 cm and 2 cm.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q003\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p074\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"48 cm³\",\n      \"mathematicalReason\": \"The supplied calculation is 12 × 4 = 48, which fits multiplying a two-digit number by a one-digit number. The base area is already given, so neither finding a circular area nor independently selecting the cylinder-volume formula is required.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 3,\n          \"fact\": \"The cylinder is labeled with base area 12 cm² and height h = 4 cm, matching the factors in the supplied calculation.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q004\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p077\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — All four sides are equal in length.\",\n      \"mathematicalReason\": \"A square has four equal-length sides. This directly matches the stated criterion for cnm_p077. Choice B is false because its word 'only' excludes equality between adjacent sides.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 4,\n          \"fact\": \"All four sides carry the same single tick mark, explicitly indicating that their lengths are equal.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q005\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p147\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"28 cm²\",\n      \"mathematicalReason\": \"The parallelogram's area is base × corresponding perpendicular height = 7 × 4 = 28 cm². Identifying the corresponding height and applying this formula directly match cnm_p147; the slanted side is not used as the height.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 5,\n          \"fact\": \"The bottom base is labeled 7 cm. The interior segment labeled 4 cm meets that base at a marked right angle, establishing the corresponding perpendicular height.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q006\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p023\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"B — 4 sides.\",\n      \"mathematicalReason\": \"A rectangle has four sides, as can also be established by counting the four straight segments of its boundary. This is an elementary feature of recognizing the familiar plane shape covered by cnm_p023; equal-side or angle properties are not being tested.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 6,\n          \"fact\": \"The rectangle's closed boundary consists of four straight segments: top, bottom, left, and right.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q007\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p163\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"27 cm³\",\n      \"mathematicalReason\": \"For a cube, volume equals edge length × edge length × edge length. Thus V = 3 × 3 × 3 = 27 cm³. Unlike the explicitly scaffolded arithmetic tasks, this question elicits applying the cube-volume formula, directly matching cnm_p163.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 7,\n          \"fact\": \"An edge is labeled 3 cm, and matching tick marks on edges in the three spatial directions support the cube's equal edge lengths.\"\n        }\n      ]\n    },\n    {\n      \"questionId\": \"q008\",\n      \"decision\": \"accept\",\n      \"assessedIds\": [\"cnm_p113\"],\n      \"supportIds\": [],\n      \"routes\": [],\n      \"derivedAnswer\": \"A — The shapes you see may be different.\",\n      \"mathematicalReason\": \"Different viewing directions can produce different observed shapes, although some views may coincide. The illustrated front and side views are triangular, while the top view is circular. This directly matches cnm_p113's criterion about views possibly differing and does not require identifying the solid from its views.\",\n      \"candidateFindings\": [],\n      \"needsNewNodes\": [],\n      \"limitations\": [],\n      \"figureEvidence\": [\n        {\n          \"imageSlot\": 8,\n          \"fact\": \"The views labeled 'Front' and 'Side' are triangles, whereas the view labeled 'Top' is a circle.\"\n        }\n      ]\n    }\n  ]\n}",
